[
  {"name": "PNG specification (W3C PNG 2nd ed. sec. 11.2.2) IHDR layout: hand-built 3x2 RGBA 8-bit file, pHYs 2835 px/m = 72 dpi, CRCs valid", "input": {"hex": "89504e470d0a1a0a0000000d49484452000000030000000208060000009d74661a000000097048597300000b1300000b1301009a9c18000000114944415478da63f8cfc0f01f86199039009b7e0bf50f5f26220000000049454e44ae426082"}, "expect": {"stdout_json": {"format": "PNG", "width": 3, "height": 2, "bit_depth": 8, "colour_type": 6, "channels": 4, "bits_per_pixel": 32, "has_alpha": true, "ihdr_crc_ok": true, "dpi": {"x": 72.01, "y": 72.01}, "chunks": ["IHDR", "pHYs", "IDAT", "IEND"]}}},
  {"name": "PNG indexed 4-bit, Adam7, PLTE of 2 entries and tRNS transparency", "input": {"hex": "89504e470d0a1a0a0000000d49484452000000010000000104030000019a3ce92c00000006504c5445000000ffffffa5d99fdd0000000174524e530040e6d8660000000a49444154789c6310000000120011a556c74e0000000049454e44ae426082"}, "expect": {"stdout_json": {"colour_type": 3, "colour_type_name": "indexed-colour (palette)", "bit_depth": 4, "interlace": "Adam7", "palette_entries": 2, "has_alpha": true, "transparency": "tRNS chunk"}}},
  {"name": "PNG signature and IHDR only (640x480 RGB 16-bit, zero CRC): read, with warnings", "input": {"hex": "89504e470d0a1a0a0000000d4948445200000280000001e0100200000000000000"}, "expect": {"stdout_json": {"width": 640, "height": 480, "bits_per_pixel": 48, "ihdr_crc_ok": false, "warnings": ["no IEND chunk (truncated or only a header given)"]}}},
  {"name": "JPEG (ITU-T T.81 B.2.2 frame header): progressive SOF2 3x2, YCbCr 2x2/1x1/1x1 = 4:2:0, JFIF 1.01 72 dpi, Exif APP1 present", "input": {"hex": "ffd8ffe000104a46494600010101004800480000ffe100104578696600004d4d002a00000008ffc20011080002000303012200021101031101ffda000c03010002110311003f000000ffd9"}, "expect": {"stdout_json": {"format": "JPEG", "width": 3, "height": 2, "bit_depth": 8, "channels": 3, "colour_type_name": "YCbCr", "sof": "SOF2", "progressive": true, "chroma_subsampling": "4:2:0", "exif": true, "jfif": {"version": "1.01", "density_units": "dots per inch", "x_density": 72, "y_density": 72}, "markers": ["APP0", "APP1", "SOF2", "SOS"]}}},
  {"name": "JPEG greyscale baseline 16x32 after a comment and an 0xFF fill byte", "input": {"hex": "ffd8fffe0005686900ffffffc0000b080020001001011100ffda0008010100003f00ffd9"}, "expect": {"stdout_json": {"width": 16, "height": 32, "channels": 1, "colour_type_name": "greyscale", "sof": "SOF0", "process": "baseline DCT", "exif": false, "markers": ["COM", "SOF0", "SOS"]}}},
  {"name": "GIF89a specification layout: the widely published 43-byte 1x1 transparent GIF", "input": {"hex": "47494638396101000100800000ffffff00000021f90401000000002c00000000010001000002024401003b"}, "expect": {"stdout_json": {"format": "GIF", "version": "89a", "width": 1, "height": 1, "global_colour_table_size": 2, "frames": 1, "animated": false, "has_alpha": true, "bytes": 43}}},
  {"name": "animated GIF: two frames, NETSCAPE2.0 loop forever (0), 4-colour table", "input": {"hex": "47494638396102000200f10000000000ff000000ff000000ff21ff0b4e45545343415045322e30030100000021f90404003200002c000000000200020000020244010021f90404003200002c00000000020002000002024401003b"}, "expect": {"stdout_json": {"width": 2, "height": 2, "frames": 2, "animated": true, "loop_count": 0, "global_colour_table_size": 4, "bit_depth": 2}}},
