[
  {"name": "hand-checked rendering of HI: H (5 wide) + 1 space + I (3 wide) = 9 columns, 5 rows", "input": {"text": "HI"}, "expect": {"stdout_json": {"width": 9, "height": 5, "lines": ["#   # ###", "#   #  # ", "#####  # ", "#   #  # ", "#   # ###"]}}},
  {"name": "lower case is drawn in capitals, with another fill character and no spacing", "input": {"text": "hi", "fill": "*", "spacing": 0}, "expect": {"stdout_json": {"width": 8, "lines": ["*   ****", "*   * * ", "***** * ", "*   * * ", "*   ****"]}}},
  {"name": "banner in an ASCII border with padding 1 (hand-checked)", "input": {"text": "Hi!", "border": "ascii"}, "expect": {"stdout_json": {"width": 15, "height": 7, "lines": ["+-------------+", "| #   # ### # |", "| #   #  #  # |", "| #####  #  # |", "| #   #  #    |", "| #   # ### # |", "+-------------+"]}}},
  {"name": "box mode: two lines centred in a double border", "input": {"text": "Hello\nWorld!", "mode": "box", "border": "double", "align": "center"}, "expect": {"stdout_json": {"lines": ["╔════════╗", "║ Hello  ║", "║ World! ║", "╚════════╝"]}}},
  {"name": "box mode, right-aligned, rounded corners, no padding", "input": {"text": "a\nbcd", "mode": "box", "border": "rounded", "padding": 0, "align": "right"}, "expect": {"stdout_json": {"lines": ["╭───╮", "│  a│", "│bcd│", "╰───╯"]}}},
  {"name": "words wrap onto further banner lines past max_width", "input": {"text": "AB CD", "max_width": 12}, "expect": {"stdout_json": {"height": 11, "width": 11}}},
  {"name": "digits and punctuation: 1+1=2 is 3+1+3+1+3+1+3+1+5 = 21 columns (hand-checked)", "input": {"text": "1+1=2", "spacing": 1}, "expect": {"stdout_json": {"width": 21, "lines": [" #       #       ### ", "##   #  ##  ### #   #", " #  ###  #        ## ", " #   #   #  ###  #   ", "###     ###     #####"]}}},
  {"name": "a character the font lacks becomes ? with a warning", "input": {"text": "ok é"}, "expect": {"stdout_json": {"warnings": ["replaced with ?: É"], "width": 21}}},
  {"name": "unknown: error", "input": {"text": "@", "unknown": "error"}, "expect": {"exit": 2, "stdout_contains": "no glyph for: @"}},
  {"name": "empty text", "input": {"text": "  "}, "expect": {"exit": 2, "stdout_contains": "text must be a non-empty string"}},
  {"name": "bad border", "input": {"text": "x", "border": "stars"}, "expect": {"exit": 2, "stdout_contains": "border must be"}}
]
