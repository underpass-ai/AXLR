[
  {"name": "WCAG 2.x contrast: #777777 on white is 4.48:1 and fails AA for normal text (needs 4.5:1, unrounded 4.478)", "input": {"operation": "contrast", "foreground": "#777777", "background": "white"}, "expect": {"stdout_json": {"ratio": "4.48:1", "ratio_value": 4.4781, "wcag": {"AA_normal_text": false, "AA_large_text": true, "AAA_normal_text": false, "AAA_large_text": false, "non_text_UI": true}}}},
  {"name": "WCAG 2.x contrast: black on white is the maximum 21:1", "input": {"operation": "contrast", "foreground": "black", "background": "#fff"}, "expect": {"stdout_json": {"ratio": "21.00:1", "ratio_value": 21.0, "foreground_luminance": 0.0, "background_luminance": 1.0, "wcag": {"AAA_normal_text": true}}}},
  {"name": "WCAG relative luminance of pure red is 0.2126 (the R coefficient)", "input": {"color": "cmyk(0%, 100%, 100%, 0%)"}, "expect": {"stdout_json": {"hex": "#ff0000", "relative_luminance": 0.2126, "css_names": ["red"], "hsl": {"h": 0.0, "s": 100.0, "l": 50.0}}}},
  {"name": "CSS Color 4 named colour table: rebeccapurple is #663399 = hsl(270 50% 40%)", "input": {"color": "#663399"}, "expect": {"stdout_json": {"rgb": {"r": 102, "g": 51, "b": 153}, "css_hsl": "hsl(270 50% 40%)", "css_names": ["rebeccapurple"], "hsv": {"h": 270.0, "s": 66.7, "v": 60.0}, "cmyk": {"c": 33.3, "m": 66.7, "y": 0.0, "k": 40.0}}}},
  {"name": "CSS Color 4: hsl(120 100% 25%) is green #008000 (127.5 rounded up)", "input": {"color": "hsl(120, 100%, 25%)"}, "expect": {"stdout_json": {"hex": "#008000", "css_names": ["green"], "nearest_named": {"name": "green", "delta_e76": 0.0}}}},
  {"name": "an alpha channel in the rgb() slash syntax", "input": {"color": "rgb(255 0 0 / 50%)"}, "expect": {"stdout_json": {"hex": "#ff000080", "alpha": 0.5, "css_rgb": "rgb(255 0 0 / 0.5)"}}},
  {"name": "hsv(240 100% 100%) is blue, hsl(240 100% 50%)", "input": {"color": "hsv(240, 100%, 100%)"}, "expect": {"stdout_json": {"hex": "#0000ff", "css_hsl": "hsl(240 100% 50%)", "relative_luminance": 0.0722}}},
  {"name": "a translucent foreground is composited over the background before the ratio", "input": {"operation": "contrast", "foreground": "rgba(0,0,0,0.5)", "background": "#ffffff"}, "expect": {"stdout_json": {"composited_foreground": "#808080", "ratio": "3.95:1", "wcag": {"AA_normal_text": false, "AA_large_text": true}}}},
  {"name": "nearest CSS names to #777778: gray/grey then dimgray", "input": {"operation": "nearest_named", "color": "#777778"}, "expect": {"stdout_json": {"nearest": [{"name": "gray", "hex": "#808080"}, {"name": "grey"}, {"name": "dimgray", "hex": "#696969"}]}}},
  {"name": "palette of red: complementary cyan, triadic green and blue, tints and shades in quarter steps", "input": {"operation": "palette", "color": "#ff0000", "steps": 3}, "expect": {"stdout_json": {"palette": {"complementary": ["#ff0000", "#00ffff"], "triadic": ["#ff0000", "#00ff00", "#0000ff"], "analogous": ["#ff0080", "#ff0000", "#ff8000"], "split_complementary": ["#ff0000", "#00ff80", "#0080ff"], "tetradic": ["#ff0000", "#80ff00", "#00ffff", "#8000ff"], "tints": ["#ff4040", "#ff8080", "#ffbfbf"], "shades": ["#bf0000", "#800000", "#400000"]}}}},
  {"name": "bad hex", "input": {"color": "#12345"}, "expect": {"exit": 2, "stdout_contains": "is not a colour this tool reads"}},
  {"name": "translucent background refused", "input": {"operation": "contrast", "foreground": "#000", "background": "#ffffff80"}, "expect": {"exit": 2, "stdout_contains": "background must be opaque"}},
  {"name": "contrast without a background", "input": {"operation": "contrast", "foreground": "#000"}, "expect": {"exit": 2, "stdout_contains": "contrast needs foreground and background"}}
]
