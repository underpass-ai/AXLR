[
{"name": "Thonky QR tutorial (Error Correction Coding): HELLO WORLD 1-M data codewords 32 91 11 120 209 114 220 77 67 64 236 17 236 17 236 17 and EC codewords 196 35 39 119 235 215 231 226 93 23", "input": {"data": "HELLO WORLD", "error": "M", "outputs": ["matrix"], "details": true}, "expect": {"exit": 0, "stdout_json": {"version": 1, "mode": "alphanumeric", "details": {"data_codewords": [32, 91, 11, 120, 209, 114, 220, 77, 67, 64, 236, 17, 236, 17, 236, 17], "ec_codewords": [196, 35, 39, 119, 235, 215, 231, 226, 93, 23]}}}},
{"name": "ISO/IEC 18004 Annex A generator polynomial for 10 EC codewords, as Thonky lists it: alpha exponents 0 251 67 46 61 118 70 64 94 32 45", "input": {"data": "HELLO WORLD", "error": "M", "outputs": ["matrix"], "details": true}, "expect": {"exit": 0, "stdout_json": {"details": {"generator_exponents": [0, 251, 67, 46, 61, 118, 70, 64, 94, 32, 45]}}}},
{"name": "Thonky QR tutorial (Data Encoding): HELLO WORLD 1-Q data codewords 32 91 11 120 209 114 220 77 67 64 236 17 236", "input": {"data": "HELLO WORLD", "error": "Q", "outputs": ["matrix"], "details": true}, "expect": {"exit": 0, "stdout_json": {"version": 1, "error": "Q", "details": {"data_codewords": [32, 91, 11, 120, 209, 114, 220, 77, 67, 64, 236, 17, 236]}}}},
{"name": "ISO/IEC 18004 Annex I encoding example: 01234567 at 1-M gives data 16 32 12 86 97 128 236 17 ... and EC 165 36 212 193 237 54 199 135 44 85", "input": {"data": "01234567", "error": "M", "outputs": ["matrix"], "details": true}, "expect": {"exit": 0, "stdout_json": {"mode": "numeric", "details": {"data_codewords": [16, 32, 12, 86, 97, 128, 236, 17, 236, 17, 236, 17, 236, 17, 236, 17], "ec_codewords": [165, 36, 212, 193, 237, 54, 199, 135, 44, 85]}}}},
{"name": "Thonky format string example: level L, mask 4 is 110011000101111", "input": {"data": "HELLO WORLD", "error": "L", "mask": 4, "outputs": ["matrix"], "details": true}, "expect": {"exit": 0, "stdout_json": {"mask": 4, "details": {"format_bits": "110011000101111"}}}},
{"name": "Thonky format table: level H, mask 6 is 000110100001100", "input": {"data": "HELLO WORLD", "error": "H", "mask": 6, "outputs": ["matrix"], "details": true}, "expect": {"exit": 0, "stdout_json": {"details": {"format_bits": "000110100001100"}}}},
{"name": "Thonky version information: version 7 is 000111110010010100, alignment centres 6 22 38 (ISO Annex E)", "input": {"data": "HELLO WORLD", "version": 7, "outputs": ["matrix"], "details": true}, "expect": {"exit": 0, "stdout_json": {"version": 7, "size": 45, "details": {"version_bits": "000111110010010100", "alignment_positions": [6, 22, 38]}}}},
{"name": "Thonky version table: version 40 is 101000110001101001, ISO Annex E alignment centres 6 30 58 86 114 142 170", "input": {"data": "1", "version": 40, "outputs": ["matrix"], "details": true}, "expect": {"exit": 0, "stdout_json": {"size": 177, "details": {"version_bits": "101000110001101001", "alignment_positions": [6, 30, 58, 86, 114, 142, 170]}}}},
{"name": "segno 1.6.6 make('HELLO WORLD', error='m', boost_error=False): version 1, mask 0 and this exact 21x21 matrix", "input": {"data": "HELLO WORLD", "error": "M", "outputs": ["matrix"]}, "expect": {"exit": 0, "stdout_json": {"version": 1, "mask": 0, "matrix": ["111111100010101111111", "100000101110001000001", "101110100010101011101", "101110100010101011101", "101110101011101011101", "100000100111001000001", "111111101010101111111", "000000000000000000000", "101010100100100010010", "011110001001000010001", "000111111101001011000", "111101011001110101110", "010011110101001110101", "000000001010001000101", "111111100000100101100", "100000100110001101000", "101110101100101111111", "101110100011010100010", "101110101111011101001", "100000100001110001011", "111111101101011100001"]}}},
{"name": "segno 1.6.6: HTTPS://AXLR.UNDERPASSAI.COM at Q is version 2 with mask 1", "input": {"data": "HTTPS://AXLR.UNDERPASSAI.COM", "error": "Q", "outputs": ["matrix"]}, "expect": {"exit": 0, "stdout_json": {"version": 2, "mask": 1, "mode": "alphanumeric"}}},
{"name": "segno 1.6.6 default boost_error: HELLO WORLD asked at M becomes 1-Q", "input": {"data": "HELLO WORLD", "error": "M", "boost_error": true, "outputs": ["matrix"]}, "expect": {"exit": 0, "stdout_json": {"version": 1, "error": "Q", "mask": 1}}},
{"name": "ISO/IEC 18004 Table 7: 40-L holds 7089 digits", "input": {"data": "", "error": "L", "outputs": ["matrix"]}, "expect": {"exit": 0, "stdout_json": {"version": 40, "mode": "numeric", "data_bits": 23648, "capacity_bits": 23648}}},
{"name": "ISO/IEC 18004 Table 7: 7090 digits do not fit", "input": {"data": "", "error": "L", "outputs": ["matrix"]}, "expect": {"exit": 2, "stdout_contains": "does not fit"}},
{"name": "UTF-8 with ECI 000026: 0111 00011010 then byte mode 0100 gives first codewords 113 164 (worked by hand)", "input": {"data": "é", "eci": true, "outputs": ["matrix"], "details": true}, "expect": {"exit": 0, "stdout_json": {"mode": "byte", "encoding": "UTF-8 with ECI 000026"}, "stdout_contains": "\"data_codewords\": [113, 164, "}},
{"name": "text rendering and SVG", "input": {"data": "HELLO WORLD", "outputs": ["svg", "text"], "scale": 2, "border": 1}, "expect": {"exit": 0, "stdout_contains": "width=\\\"46\\\" height=\\\"46\\\" viewBox=\\\"0 0 23 23\\\""}},
{"name": "text rendering: two block characters per dark module", "input": {"data": "HELLO WORLD", "outputs": ["text"], "border": 0}, "expect": {"exit": 0, "stdout_contains": "\"text\": \"██████████████"}},
{"name": "lower case in alphanumeric mode", "input": {"data": "hello", "mode": "alphanumeric"}, "expect": {"exit": 2, "stdout_contains": "alphanumeric mode takes only"}},
{"name": "forced version too small", "input": {"data": "HELLO WORLD HELLO WORLD", "version": 1, "error": "H"}, "expect": {"exit": 2, "stdout_contains": "does not fit in a QR code (version 1"}},
{"name": "bad error level", "input": {"data": "x", "error": "X"}, "expect": {"exit": 2, "stdout_contains": "error must be L, M, Q or H"}},
{"name": "bad colour", "input": {"data": "x", "dark": "black"}, "expect": {"exit": 2, "stdout_contains": "dark must be a colour"}}
]
