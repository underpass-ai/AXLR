  {"name": "canonical 44-byte PCM header (Microsoft RIFF WAVE layout) + 4 samples, worked by hand: mono 8000 Hz 16-bit, 8 data bytes = 4 frames = 1/2000 s, peak 16384 = -6.02 dBFS", "input": {"hex": "524946462c00000057415645666d74201000000001000100401f0000803e00000200100064617461080000000000002000c00010"}, "expect": {"stdout_json": {"format_tag": 1, "format_name": "PCM", "channels": 1, "sample_rate": 8000, "byte_rate": 16000, "block_align": 2, "bits_per_sample": 16, "data_bytes": 8, "frames": 4, "duration_exact": "1/2000", "duration_seconds": 0.0005, "peak_sample": 16384, "peak_dbfs": -6.02, "riff_size": 44, "file_bytes": 52, "wave_module_check": {"agrees": true, "frames": 4}, "warnings": []}}},
