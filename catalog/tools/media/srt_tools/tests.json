[
  {"name": "parse SRT (hand-checked): three cues, durations, one overlap of cue 1 and 2", "input": {"text": "1\n00:00:01,000 --> 00:00:04,000\nHello <i>world</i> & co\n\n2\n00:00:03,500 --> 00:00:06,250\nSecond line\ncontinues\n\n3\n00:01:00,000 --> 00:01:02,000\nThird\n"}, "expect": {"stdout_json": {"input_format": "srt", "count": 3, "overlap_count": 1, "cues": [{"index": 1, "start": "00:00:01,000", "end": "00:00:04,000", "duration_ms": 3000, "text": "Hello <i>world</i> & co"}, {"index": 2, "start_ms": 3500, "end_ms": 6250, "text": "Second line\ncontinues"}, {"index": 3, "start_ms": 60000, "end_ms": 62000}]}}},
  {"name": "shift by -1500 ms: cue 1 clamped at 0 with a warning, the rest moved (hand-checked)", "input": {"text": "1\n00:00:01,000 --> 00:00:04,000\nHello <i>world</i> & co\n\n2\n00:00:03,500 --> 00:00:06,250\nSecond line\ncontinues\n\n3\n00:01:00,000 --> 00:01:02,000\nThird\n", "operation": "shift", "offset_ms": -1500}, "expect": {"stdout_json": {"subtitles": "1\n00:00:00,000 --> 00:00:02,500\nHello <i>world</i> & co\n\n2\n00:00:02,000 --> 00:00:04,750\nSecond line\ncontinues\n\n3\n00:00:58,500 --> 00:01:00,500\nThird\n", "warnings": ["cue 1 would start before 0:00 and was clamped to 0"]}}},
  {"name": "a shift that ends a cue before 0 drops it", "input": {"text": "1\n00:00:01,000 --> 00:00:04,000\nHello <i>world</i> & co\n\n2\n00:00:03,500 --> 00:00:06,250\nSecond line\ncontinues\n\n3\n00:01:00,000 --> 00:01:02,000\nThird\n", "operation": "shift", "offset_ms": -5000}, "expect": {"stdout_json": {"count": 2, "warnings": ["cue 1 would end before 0:00 and was dropped", "cue 2 would start before 0:00 and was clamped to 0"]}}},
  {"name": "scale 25 -> 23.976 fps: factor 3125/2997, 1000 ms -> 1042.71 -> 1043, 60000 -> 62562.56 -> 62563 (by hand)", "input": {"text": "1\n00:00:01,000 --> 00:00:04,000\nHello <i>world</i> & co\n\n2\n00:00:03,500 --> 00:00:06,250\nSecond line\ncontinues\n\n3\n00:01:00,000 --> 00:01:02,000\nThird\n", "operation": "scale", "from_fps": 25, "to_fps": "23.976"}, "expect": {"stdout_json": {"factor": "3125/2997", "cues": [{"start_ms": 1043, "end_ms": 4171}, {"start_ms": 3649, "end_ms": 6517}, {"start_ms": 62563, "end_ms": 64648}]}}},
  {"name": "SRT to WebVTT (W3C WebVTT: WEBVTT header, '.' before milliseconds, & escaped as &amp;)", "input": {"text": "1\n00:00:01,000 --> 00:00:04,000\nHello <i>world</i> & co\n\n2\n00:00:03,500 --> 00:00:06,250\nSecond line\ncontinues\n\n3\n00:01:00,000 --> 00:01:02,000\nThird\n", "operation": "convert"}, "expect": {"stdout_json": {"output_format": "vtt", "subtitles": "WEBVTT\n\n00:00:01.000 --> 00:00:04.000\nHello <i>world</i> &amp; co\n\n00:00:03.500 --> 00:00:06.250\nSecond line\ncontinues\n\n00:01:00.000 --> 00:01:02.000\nThird\n"}}},
  {"name": "WebVTT to SRT: NOTE and STYLE blocks skipped, MM:SS.mmm times, cue settings dropped, voice and class spans removed, entities decoded", "input": {"text": "WEBVTT - demo\n\nNOTE a comment\nspanning lines\n\nSTYLE\n::cue { color: yellow }\n\nintro\n00:01.000 --> 00:04.000 align:start line:0\n<v Roger>Hi &amp; <c.loud>welcome</c>\n\n00:00:05.500 --> 00:00:07.000\n<i>Bye</i>\n", "operation": "convert"}, "expect": {"stdout_json": {"input_format": "vtt", "count": 2, "subtitles": "1\n00:00:01,000 --> 00:00:04,000\nHi & welcome\n\n2\n00:00:05,500 --> 00:00:07,000\n<i>Bye</i>\n"}}},
  {"name": "parse WebVTT keeps the cue identifier and settings", "input": {"text": "WEBVTT - demo\n\nNOTE a comment\nspanning lines\n\nSTYLE\n::cue { color: yellow }\n\nintro\n00:01.000 --> 00:04.000 align:start line:0\n<v Roger>Hi &amp; <c.loud>welcome</c>\n\n00:00:05.500 --> 00:00:07.000\n<i>Bye</i>\n"}, "expect": {"stdout_json": {"cues": [{"id": "intro", "settings": "align:start line:0", "start_ms": 1000}, {"id": null, "start_ms": 5500}]}}},
  {"name": "merge a second file shifted by +100 ms: sorted by start and renumbered, two overlaps", "input": {"text": "1\n00:00:01,000 --> 00:00:04,000\nHello <i>world</i> & co\n\n2\n00:00:03,500 --> 00:00:06,250\nSecond line\ncontinues\n\n3\n00:01:00,000 --> 00:01:02,000\nThird\n", "operation": "merge", "text2": "1\n00:00:02,000 --> 00:00:03,000\nInserted\n", "offset_ms": 100}, "expect": {"stdout_json": {"count": 4, "sources": [1, 2, 1, 1], "overlap_count": 2, "cues": [{"index": 1, "start_ms": 1000}, {"index": 2, "start_ms": 2100, "end_ms": 3100, "text": "Inserted"}, {"index": 3, "start_ms": 3500}, {"index": 4, "start_ms": 60000}]}}},
  {"name": "overlaps report", "input": {"text": "1\n00:00:01,000 --> 00:00:04,000\nHello <i>world</i> & co\n\n2\n00:00:03,500 --> 00:00:06,250\nSecond line\ncontinues\n\n3\n00:01:00,000 --> 00:01:02,000\nThird\n", "operation": "overlaps"}, "expect": {"stdout_json": {"overlaps": [{"first": 1, "second": 2, "overlap_ms": 500, "first_end": "00:00:04,000", "second_start": "00:00:03,500"}]}}},
  {"name": "a block with a broken timing is skipped with a warning", "input": {"text": "1\n00:00:01,000 -> 00:00:02,000\nbad\n\n2\n00:00:03,000 --> 00:00:04,000\ngood\n"}, "expect": {"stdout_json": {"count": 1, "warnings": ["line 1: block without a timing line skipped"]}}},
  {"name": "no cues", "input": {"text": "just words"}, "expect": {"exit": 2, "stdout_contains": "no cues found"}},
  {"name": "scale without a factor", "input": {"text": "1\n00:00:01,000 --> 00:00:04,000\nHello <i>world</i> & co\n\n2\n00:00:03,500 --> 00:00:06,250\nSecond line\ncontinues\n\n3\n00:01:00,000 --> 00:01:02,000\nThird\n", "operation": "scale"}, "expect": {"exit": 2, "stdout_contains": "scale needs factor"}},
  {"name": "shift needs an integer", "input": {"text": "1\n00:00:01,000 --> 00:00:04,000\nHello <i>world</i> & co\n\n2\n00:00:03,500 --> 00:00:06,250\nSecond line\ncontinues\n\n3\n00:01:00,000 --> 00:01:02,000\nThird\n", "operation": "shift", "offset_ms": 1.5}, "expect": {"exit": 2, "stdout_contains": "offset_ms must be an integer"}}
]
