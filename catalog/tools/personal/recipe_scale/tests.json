[
  {"name": "hand-checked: 4 to 6 servings (x 3/2): 1 1/2 cups -> 2 1/4 cups, 2/3 cup -> 1 cup, ½ tsp -> 3/4 tsp, 2-3 tbsp -> 3 - 4 1/2 tbsp, 200 g -> 300 g", "input": {"ingredients": ["1 1/2 cups flour", "2/3 cup sugar", "½ tsp salt", "2-3 tbsp butter", "200 g chocolate"], "servings": {"from": 4, "to": 6}}, "expect": {"exit": 0, "stdout_json": {"factor": "1 1/2", "ingredients": [{"scaled": "2 1/4 cups flour"}, {"scaled": "1 cup sugar"}, {"scaled": "3/4 tsp salt"}, {"exact": "3 - 4 1/2 tbsp", "scaled": "3 - 4 1/2 tbsp butter"}, {"scaled": "300 g chocolate"}]}}},
  {"name": "3 eggs x 3/2 = 4 1/2: rounded to a whole egg and flagged", "input": {"ingredients": ["3 large eggs"], "factor": "3/2"}, "expect": {"exit": 0, "stdout_json": {"ingredients": [{"exact": "4 1/2", "quantity": "5", "flag": "eggs"}]}}},
  {"name": "NIST Handbook 44 (cup = 16 tbsp = 48 tsp): 1/4 cup x 3/2 = 3/8 cup = 6 tbsp; 2 tsp x 3/2 = 3 tsp = 1 tbsp", "input": {"ingredients": ["1/4 cup milk", "2 tsp vanilla"], "factor": 1.5}, "expect": {"exit": 0, "stdout_json": {"ingredients": [{"exact": "3/8 cup", "scaled": "6 tbsp milk"}, {"exact": "3 tsp", "scaled": "1 tbsp vanilla"}]}}},
  {"name": "hand-checked: 1/3 cup x 5/4 = 5/12 cup lies 1/12 from both the 1/3 and the 1/2 marks; the simpler 1/2 is shown and the rounding noted", "input": {"ingredients": ["1/3 cup oil"], "factor": "5/4"}, "expect": {"exit": 0, "stdout_json": {"ingredients": [{"exact": "5/12 cup", "quantity": "1/2", "note": "rounded for measuring"}]}}},
  {"name": "target amount: 1 1/2 cups of flour to 3 cups doubles everything", "input": {"ingredients": ["1 1/2 cups flour", "2 eggs", "200 g butter"], "target": {"ingredient": "flour", "quantity": "3"}}, "expect": {"exit": 0, "stdout_json": {"factor": "2", "ingredients": [{"scaled": "3 cups flour"}, {"scaled": "4 eggs"}, {"scaled": "400 g butter"}]}}},
  {"name": "target in another unit: 200 g butter to 1/2 lb (226.796185 g, NIST) is a factor 1.13398", "input": {"ingredients": ["200 g butter"], "target": {"ingredient": "butter", "quantity": "1/2", "unit": "lb"}}, "expect": {"exit": 0, "stdout_json": {"factor_decimal": "1.13398", "ingredients": [{"scaled": "227 g butter"}]}}},
  {"name": "lines without a quantity stay as they are", "input": {"ingredients": ["salt to taste", "1 pinch nutmeg"], "factor": 2}, "expect": {"exit": 0, "stdout_json": {"ingredients": [{"scaled": "salt to taste", "note": "no quantity: adjust to taste"}, {"scaled": "2 pinches nutmeg"}]}}},
  {"name": "structured input and percent factor", "input": {"ingredients": [{"quantity": "1 1/2", "unit": "cups", "name": "rice"}], "factor": "50%"}, "expect": {"exit": 0, "stdout_json": {"ingredients": [{"scaled": "3/4 cup rice"}]}}},
  {"name": "only one way of scaling", "input": {"ingredients": ["1 cup x"], "factor": 2, "servings": {"from": 1, "to": 2}}, "expect": {"exit": 2, "stdout_contains": "exactly one of"}}
