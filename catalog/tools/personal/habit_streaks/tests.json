[
  {"name": "hand-checked October 2026 calendar, daily: done 1-5, 7-10, 12-17; as_of Sunday 18 not yet done (pending); missed 6 and 11; current 6, longest 6, 15 of 17 = 88.2 %", "input": {"as_of": "2026-10-18", "habits": [{"name": "read", "dates": ["2026-10-01", "2026-10-02", "2026-10-03", "2026-10-04", "2026-10-05", "2026-10-07", "2026-10-08", "2026-10-09", "2026-10-10", "2026-10-12", "2026-10-13", "2026-10-14", "2026-10-15", "2026-10-16", "2026-10-17"]}]}, "expect": {"exit": 0, "stdout_json": {"habits": [{"current_streak": 6, "longest_streak": 6, "longest_streak_ended": "2026-10-17", "today_pending": true, "completion": {"done": 15, "due": 17, "rate_pct": "88.2"}, "windows": {"7": {"done": 6, "due": 6, "rate_pct": "100.0"}}, "missed_recent": ["2026-10-06", "2026-10-11"]}]}}},
  {"name": "hand-checked weekdays: Thu 1 to Tue 13 done (9 in a row), Wed 14 missed, Thu 15 and Fri 16 done, Sat 17 is extra", "input": {"as_of": "2026-10-18", "habits": [{"name": "gym", "schedule": "weekdays", "dates": ["2026-10-01", "2026-10-02", "2026-10-05", "2026-10-06", "2026-10-07", "2026-10-08", "2026-10-09", "2026-10-12", "2026-10-13", "2026-10-15", "2026-10-16", "2026-10-17"]}]}, "expect": {"exit": 0, "stdout_json": {"habits": [{"current_streak": 2, "longest_streak": 9, "longest_streak_ended": "2026-10-13", "completion": {"done": 11, "due": 12, "rate_pct": "91.7"}, "missed_recent": ["2026-10-14"], "logged_on_unscheduled_days": ["2026-10-17"]}]}}},
  {"name": "hand-checked 3 per ISO week: weeks of Sep 28 (3), Oct 5 (2), Oct 12 (4): current 1, longest 1, 2 of 3 weeks", "input": {"as_of": "2026-10-18", "habits": [{"name": "run", "schedule": {"per_week": 3}, "start": "2026-09-28", "dates": ["2026-09-29", "2026-10-01", "2026-10-03", "2026-10-05", "2026-10-07", "2026-10-13", "2026-10-15", "2026-10-16", "2026-10-18"]}]}, "expect": {"exit": 0, "stdout_json": {"habits": [{"unit": "week", "current_streak": 1, "longest_streak": 1, "completion": {"weeks_met": 2, "weeks": 3, "rate_pct": "66.7"}, "missed_weeks_recent": [{"monday": "2026-10-05", "count": 2}], "this_week": {"count": 4, "met": true}}]}}},
  {"name": "current week not met yet is pending, not a break", "input": {"as_of": "2026-10-14", "habits": [{"name": "swim", "schedule": {"per_week": 2}, "start": "2026-10-05", "dates": ["2026-10-06", "2026-10-08", "2026-10-13"]}]}, "expect": {"exit": 0, "stdout_json": {"habits": [{"current_streak": 1, "today_pending": true, "this_week": {"count": 1, "remaining": 1, "days_left": 4}}]}}},
  {"name": "without today_pending a missing as_of day breaks the streak", "input": {"as_of": "2026-10-18", "today_pending": false, "habits": [{"name": "read", "dates": ["2026-10-16", "2026-10-17"]}]}, "expect": {"exit": 0, "stdout_json": {"habits": [{"current_streak": 0, "longest_streak": 2, "missed_recent": ["2026-10-18"]}]}}},
  {"name": "specific weekdays (Mon, Wed, Fri) and logs after as_of ignored", "input": {"as_of": "2026-10-16", "habits": [{"name": "piano", "schedule": {"days": [1, 3, 5]}, "start": "2026-10-05", "dates": ["2026-10-05", "2026-10-07", "2026-10-09", "2026-10-12", "2026-10-16", "2026-10-20"]}]}, "expect": {"exit": 0, "stdout_json": {"habits": [{"current_streak": 1, "longest_streak": 4, "missed_recent": ["2026-10-14"], "ignored_after_as_of": 1}]}}},
  {"name": "as_of is required", "input": {"habits": [{"name": "x", "dates": ["2026-10-01"]}]}, "expect": {"exit": 2, "stdout_contains": "as_of is required"}},
  {"name": "bad schedule", "input": {"as_of": "2026-10-18", "habits": [{"name": "x", "dates": ["2026-10-01"], "schedule": "hourly"}]}, "expect": {"exit": 2, "stdout_contains": "schedule must be"}}
