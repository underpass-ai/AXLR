[
  {"name": "AISC Manual Table 3-23 case 1 (simple beam, uniform load): w = 10 kN/m, L = 6 m: R = wL/2 = 30 kN, Mmax = wL²/8 = 45 kN·m, δmax = 5wL⁴/(384EI) = 10.546875 mm with E = 200 GPa, I = 8e-5 m⁴", "input": {"support": "simply_supported", "length": 6, "loads": [{"type": "udl", "magnitude": 10000}], "E": "200e9", "I": "8e-5", "points": [3]}, "expect": {"exit": 0, "stdout_json": {"reactions": [{"position": "0", "force": "30000"}, {"position": "6", "force": "30000"}], "max_moment": {"value": "45000", "position": "3"}, "max_deflection": {"value": "0.010546875", "position": "3"}, "points": [{"x": "3", "moment": "45000", "shear": "0", "deflection": "0.010546875"}]}}},
  {"name": "standard tables (AISC 3-23, Roark 8.1), cantilever with end load: δ = PL³/(3EI) = 1000·8/(3·200000) = 0.013333 m, M = -PL at the fixed end", "input": {"support": "cantilever", "length": 2, "loads": [{"type": "point", "magnitude": 1000, "position": 2}], "E": "200e9", "I": "1e-6", "points": [0, 2]}, "expect": {"exit": 0, "stdout_json": {"min_moment": {"value": "-2000", "position": "0"}, "max_deflection": {"value": "0.01333333333", "position": "2"}, "points": [{"x": "0", "moment": "-2000", "deflection": "0"}, {"x": "2", "moment": "0", "deflection": "0.01333333333"}]}}},
  {"name": "AISC Table 3-23 case 7 (simple beam, centre load): M = PL/4 = 10 kN·m, δ = PL³/(48EI) = 6.6667 mm", "input": {"support": "simply_supported", "length": 4, "loads": [{"type": "point", "magnitude": 10000, "position": 2}], "E": "200e9", "I": "1e-5", "points": [2]}, "expect": {"exit": 0, "stdout_json": {"max_moment": {"value": "10000"}, "max_deflection": {"value": "0.006666666667"}, "points": [{"x": "2", "shear_left": "5000", "shear_right": "-5000"}]}}},
  {"name": "AISC Table 3-23 case 2 (simple beam, load increasing to one end): R1 = W/3, R2 = 2W/3, Mmax = 2WL/(9√3) = 3464.1016 at L/√3", "input": {"support": "simply_supported", "length": 3, "loads": [{"type": "linear", "start_magnitude": 0, "end_magnitude": 6000}], "points": [0]}, "expect": {"exit": 0, "stdout_json": {"total_load": "9000", "reactions": [{"force": "3000"}, {"force": "6000"}], "max_moment": {"value": "3464.101615", "position": "1.732050808"}}}},
  {"name": "AISC Table 3-23 case 2: δmax = 0.01304 WL³/EI at x = 0.5193 L", "input": {"support": "simply_supported", "length": 3, "loads": [{"type": "linear", "start_magnitude": 0, "end_magnitude": 6000}], "E": "200e9", "I": "1e-5", "points": [0]}, "expect": {"exit": 0, "stdout_contains": "\"max_deflection\": {\"value\": \"0.001584"}},
  {"name": "imperial: 50 lbf/in over 240 in, E = 29e6 psi, I = 100 in⁴: M = 360,000 lbf·in, δ = 0.7448 in (5wL⁴/384EI by hand)", "input": {"support": "simply_supported", "length": 240, "units": "imperial", "loads": [{"type": "udl", "magnitude": 50}], "E": "29e6", "I": 100, "points": [120]}, "expect": {"exit": 0, "stdout_json": {"units": {"moment": "lbf·in", "deflection": "in"}, "max_moment": {"value": "360000"}, "max_deflection": {"value": "0.7448275862"}}}},
  {"name": "superposition on a cantilever: UDL wL⁴/8EI = 6.4 plus Pa²(3L-a)/6EI = 3.3333 gives 9.7333 at the tip", "input": {"support": "cantilever", "length": 4, "loads": [{"type": "udl", "magnitude": 2}, {"type": "point", "magnitude": 5, "position": 2}], "E": 10, "I": 1, "points": [4]}, "expect": {"exit": 0, "stdout_json": {"reactions": [{"force": "13", "moment": "26"}], "points": [{"x": "4", "deflection": "9.733333333"}]}}},
  {"name": "overhang: UDL 1 on 10 with supports at 0 and 8: R = 3.75 and 6.25, hogging -2 over the support, tip rises 30/EI", "input": {"support": "simply_supported", "length": 10, "supports": [0, 8], "loads": [{"type": "udl", "magnitude": 1}], "E": 1, "I": 1, "points": [8, 10]}, "expect": {"exit": 0, "stdout_json": {"reactions": [{"force": "3.75"}, {"force": "6.25"}], "max_moment": {"value": "7.03125", "position": "3.75"}, "points": [{"x": "8", "moment": "-2", "shear_left": "-4.25", "shear_right": "2", "deflection": "0"}, {"x": "10", "deflection": "-30"}]}}},
