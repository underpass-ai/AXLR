{
  "name": "eisenhower_matrix",
  "description": "Sort tasks into the Eisenhower matrix (do, schedule, delegate, eliminate) from urgent/important flags, 1-5 scores with thresholds, or due dates counted from a given today, and return an action plan ordered by quadrant, due date and effort, with the reason for each placement, as JSON and a Markdown table.",
  "input_schema": {
    "type": "object",
    "required": ["tasks"],
    "additionalProperties": false,
    "properties": {
      "tasks": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"type": ["object", "string"], "additionalProperties": false, "properties": {
        "name": {"type": "string"},
        "urgent": {"type": "boolean"},
        "important": {"type": "boolean"},
        "urgency": {"type": "number", "minimum": 1, "maximum": 5},
        "importance": {"type": "number", "minimum": 1, "maximum": 5},
        "due": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "effort": {"type": "number", "minimum": 0, "description": "Hours or any unit; used to order"},
        "notes": {"type": "string"}
      }}},
      "today": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Required with due dates"},
      "thresholds": {"type": "object", "additionalProperties": false, "properties": {
        "urgency": {"type": "number", "minimum": 1, "maximum": 5, "default": 4},
        "importance": {"type": "number", "minimum": 1, "maximum": 5, "default": 3},
        "due_within_days": {"type": "integer", "minimum": 0, "default": 2}
      }},
      "include_eliminate": {"type": "boolean", "default": false}
    }
  },
  "program": "python3",
  "args": ["eisenhower_matrix.py"],
  "files": ["eisenhower_matrix.py"],
  "catalog": {
    "version": "1.0.0",
    "category": "personal",
    "tags": ["productivity", "prioritization", "tasks", "planning", "eisenhower", "markdown"],
    "license": "MIT",
    "requires": {"program_min_version": "3.10", "packages": []},
    "network": false,
    "example": {"input": {"today": "2026-10-18", "tasks": [{"name": "Tax return", "importance": 5, "due": "2026-10-19", "effort": 3}, {"name": "Learn Rust", "importance": 4, "effort": 20}, {"name": "Call back vendor", "urgency": 5, "importance": 2}]}, "output": {"plan": [{"step": 1, "task": "Tax return", "action": "Do first", "due": "2026-10-19", "effort": 3}, {"step": 2, "task": "Learn Rust", "action": "Schedule", "effort": 20}, {"step": 3, "task": "Call back vendor", "action": "Delegate"}]}},
    "source": "original; the urgent/important matrix popularised by Stephen Covey, The 7 Habits of Highly Effective People (1989), after Dwight D. Eisenhower's 1954 remark"
  }
}
