[
  {"name": "hand-checked matrix as of 2026-10-18 (urgency >= 4, importance >= 3, due within 2 days is urgent)", "input": {"today": "2026-10-18", "tasks": [{"name": "Tax return", "importance": 5, "due": "2026-10-19", "effort": 3}, {"name": "Server outage", "urgent": true, "important": true, "effort": 1}, {"name": "Learn Rust", "importance": 4, "effort": 20}, {"name": "Plan holiday", "importance": 3, "due": "2026-11-30", "effort": 2}, {"name": "Reply to newsletter poll", "importance": 1, "due": "2026-10-18", "effort": 0.25}, {"name": "Book dentist", "importance": 4, "due": "2026-10-25", "effort": 0.5}, {"name": "Scroll social media", "urgency": 1, "importance": 1}, {"name": "Call back vendor", "urgency": 5, "importance": 2, "effort": 0.5}]}, "expect": {"exit": 0, "stdout_json": {"quadrants": {"do": {"tasks": ["Tax return", "Server outage"]}, "schedule": {"tasks": ["Book dentist", "Plan holiday", "Learn Rust"]}, "delegate": {"tasks": ["Reply to newsletter poll", "Call back vendor"]}, "eliminate": {"tasks": ["Scroll social media"]}}, "plan": [{"step": 1, "task": "Tax return"}, {"step": 2, "task": "Server outage"}, {"step": 3, "task": "Book dentist"}, {"step": 4, "task": "Plan holiday"}, {"step": 5, "task": "Learn Rust"}, {"step": 6, "task": "Reply to newsletter poll"}, {"step": 7, "task": "Call back vendor"}]}}},
  {"name": "same due date: the smaller effort goes first", "input": {"today": "2026-10-18", "tasks": [{"name": "big", "important": true, "due": "2026-10-20", "effort": 5}, {"name": "small", "important": true, "due": "2026-10-20", "effort": 1}]}, "expect": {"exit": 0, "stdout_json": {"plan": [{"task": "small", "action": "Do first"}, {"task": "big", "action": "Do first"}]}}},
  {"name": "overdue tasks are urgent and flagged", "input": {"today": "2026-10-18", "tasks": [{"name": "late", "importance": 4, "due": "2026-10-10"}]}, "expect": {"exit": 0, "stdout_json": {"tasks": [{"name": "late", "quadrant": 1, "days_left": -8, "overdue": true}]}}},
  {"name": "a low urgency score is overridden by a near due date", "input": {"today": "2026-10-18", "tasks": [{"name": "form", "urgency": 2, "importance": 4, "due": "2026-10-19"}], "thresholds": {"due_within_days": 1}}, "expect": {"exit": 0, "stdout_json": {"tasks": [{"quadrant": 1, "action": "do"}]}}},
  {"name": "Markdown matrix and the eliminated list", "input": {"tasks": [{"name": "a", "urgent": true, "important": true}, {"name": "b", "urgent": false, "important": false}]}, "expect": {"exit": 0, "stdout_contains": "Dropped (neither urgent nor important): b."}},
  {"name": "include_eliminate puts quadrant 4 at the end of the plan", "input": {"tasks": [{"name": "b", "urgent": false, "important": false}, {"name": "a", "urgent": false, "important": true}], "include_eliminate": true}, "expect": {"exit": 0, "stdout_json": {"plan": [{"task": "a", "action": "Schedule"}, {"task": "b", "action": "Eliminate"}]}}},
  {"name": "due dates need today", "input": {"tasks": [{"name": "x", "due": "2026-10-20"}]}, "expect": {"exit": 2, "stdout_contains": "today is required"}},
  {"name": "scores are 1 to 5", "input": {"tasks": [{"name": "x", "importance": 9}]}, "expect": {"exit": 2, "stdout_contains": "from 1 to 5"}}
]
