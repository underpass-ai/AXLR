{
  "name": "deadline_calc",
  "description": "Compute a legal or administrative time limit from a counting rule stated in the input: working or calendar days, weeks, months or years; counting from the next day or the same day; non-working weekdays, holidays and periods such as August; how months end; and moving a last day that falls on a non-working day. Never assumes a jurisdiction's rule.",
  "input_schema": {
    "type": "object",
    "required": ["start", "amount", "unit", "rule"],
    "additionalProperties": false,
    "properties": {
      "start": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Day of the notification or publication"},
      "amount": {"type": "integer", "minimum": 0},
      "unit": {"type": "string", "enum": ["working_days", "calendar_days", "weeks", "months", "years"]},
      "rule": {"type": "object", "required": ["count_from", "if_last_day_non_working"], "additionalProperties": false, "properties": {
        "count_from": {"type": "string", "enum": ["next_day", "same_day"]},
        "non_working_weekdays": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 7}, "description": "ISO weekdays; [6, 7] is Saturday and Sunday"},
        "holidays": {"type": "array", "items": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}},
        "non_working_periods": {"type": "array", "items": {"type": "object", "required": ["from", "to"], "additionalProperties": false, "properties": {"from": {"type": "string"}, "to": {"type": "string"}}}, "description": "MM-DD every year, or YYYY-MM-DD"},
        "month_end": {"type": "string", "enum": ["same_day", "day_before"], "default": "same_day"},
        "if_last_day_non_working": {"type": "string", "enum": ["next_working_day", "keep"]}}}
    }
  },
  "program": "python3",
  "args": ["deadline_calc.py"],
  "files": ["deadline_calc.py"],
  "catalog": {
    "version": "1.0.0",
    "category": "law",
    "tags": ["deadlines", "plazos", "dias-habiles", "legal-terms", "computo-de-plazos", "procedure"],
    "license": "MIT",
    "requires": {"program_min_version": "3.10", "packages": []},
    "network": false,
    "example": {
      "input": {"start": "2026-10-16", "amount": 10, "unit": "working_days", "rule": {"count_from": "next_day", "non_working_weekdays": [6, 7], "holidays": [], "if_last_day_non_working": "next_working_day"}},
      "output": {"end": "2026-10-30", "weekday": "Friday"}
    },
    "source": "original; counting rules as stated by Ley 39/2015 art. 30 and LEC arts. 130-133 (Spain), used as examples of rules the caller gives"
  }
}
