  {"name": "as_of is required", "input": {"schedule": [{"record_type": "invoice", "period": {"years": 4}, "trigger": "filing_deadline", "count_from": "next_day", "legal_basis": "Ley 58/2003 General Tributaria, arts. 66 and 67.1 (prescription)"}, {"record_type": "invoice", "period": "P6Y", "trigger": "last_book_entry", "legal_basis": "Código de Comercio, art. 30.1"}], "records": []}, "expect": {"exit": 2, "stdout_contains": "as_of must be a date"}},
