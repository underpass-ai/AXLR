  {"name": "hand-checked Spanish invoices: LGT arts. 66-67 four years vs Código de Comercio art. 30 six years, the longer governs", "input": {"as_of": "2026-10-18", "schedule": [{"record_type": "invoice", "period": {"years": 4}, "trigger": "filing_deadline", "count_from": "next_day", "legal_basis": "Ley 58/2003 General Tributaria, arts. 66 and 67.1 (prescription)"}, {"record_type": "invoice", "period": "P6Y", "trigger": "last_book_entry", "legal_basis": "Código de Comercio, art. 30.1"}], "records": [{"id": "F-2020-001", "record_type": "invoice", "dates": {"filing_deadline": "2021-01-30", "last_book_entry": "2020-12-31"}}, {"id": "F-2019-001", "record_type": "invoice", "dates": {"filing_deadline": "2020-01-30", "last_book_entry": "2019-12-31"}}]}, "expect": {"exit": 0, "stdout_json": {"records": [{"id": "F-2020-001", "rules": [{"counted_from": "2021-01-31", "retain_until": "2025-01-31"}, {"counted_from": "2020-12-31", "retain_until": "2026-12-31"}], "governing_rule": 1, "retain_until": "2026-12-31", "action_date": "2027-01-01", "status": "retain", "days_remaining": 74}, {"id": "F-2019-001", "retain_until": "2025-12-31", "status": "past_retention", "days_past_retention": 291}], "summary": {"retain": ["F-2020-001"], "past_retention": ["F-2019-001"]}}}},
  {"name": "a legal hold suspends destruction", "input": {"as_of": "2026-10-18", "schedule": [{"record_type": "invoice", "period": {"years": 4}, "trigger": "filing_deadline", "count_from": "next_day", "legal_basis": "Ley 58/2003 General Tributaria, arts. 66 and 67.1 (prescription)"}, {"record_type": "invoice", "period": "P6Y", "trigger": "last_book_entry", "legal_basis": "Código de Comercio, art. 30.1"}], "records": [{"id": "F-2019-002", "record_type": "invoice", "dates": {"filing_deadline": "2020-01-30", "last_book_entry": "2019-12-31"}, "legal_hold": true, "hold_reason": "tax audit"}]}, "expect": {"exit": 0, "stdout_json": {"records": [{"id": "F-2019-002", "status": "on_hold", "retain_until": "2025-12-31", "legal_hold": true}], "counts": {"on_hold": 1, "past_retention": 0}}}},
  {"name": "a missing trigger date keeps the record from being cleared", "input": {"as_of": "2026-10-18", "schedule": [{"record_type": "invoice", "period": {"years": 4}, "trigger": "filing_deadline", "count_from": "next_day", "legal_basis": "Ley 58/2003 General Tributaria, arts. 66 and 67.1 (prescription)"}, {"record_type": "invoice", "period": "P6Y", "trigger": "last_book_entry", "legal_basis": "Código de Comercio, art. 30.1"}], "records": [{"id": "F-2021-001", "record_type": "invoice", "dates": {"filing_deadline": "2022-01-30"}}]}, "expect": {"exit": 0, "stdout_json": {"records": [{"status": "missing_dates", "missing_dates": ["last_book_entry"], "retain_until_at_least": "2026-01-31"}]}}},
  {"name": "end-of-year rounding with an ISO period, a review action and an unscheduled type", "input": {"as_of": "2026-10-18", "schedule": [{"record_type": "payroll", "period": "P10Y", "trigger": "paid", "rounding": "end_of_year", "action": "review", "legal_basis": "given by the caller"}], "records": [{"id": "P-1", "record_type": "payroll", "dates": {"paid": "2019-06-15"}}, {"id": "C-1", "record_type": "contract", "date": "2020-01-01"}]}, "expect": {"exit": 0, "stdout_json": {"records": [{"id": "P-1", "retain_until": "2029-12-31", "action": "review", "action_date": "2030-01-01", "status": "retain"}, {"id": "C-1", "status": "unscheduled"}]}}},
