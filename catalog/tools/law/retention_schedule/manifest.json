{
  "name": "retention_schedule",
  "description": "Apply a records retention schedule given in the input (record type, period, trigger event, legal basis, action) to a list of dated records: the date each rule's retention ends, the governing rule when several apply, the destruction or review date, which records are past retention, and legal holds that suspend destruction. Never assumes a period: types without a rule are reported as unscheduled. With a disclaimer.",
  "input_schema": {
    "type": "object",
    "required": ["as_of", "schedule", "records"],
    "additionalProperties": false,
    "properties": {
      "as_of": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "The date to judge against"},
      "schedule": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["record_type", "period"], "additionalProperties": false, "properties": {
        "record_type": {"type": "string"},
        "period": {"anyOf": [{"type": "string", "description": "ISO 8601 like P6Y, or \"permanent\""}, {"type": "object", "additionalProperties": false, "properties": {"years": {"type": "integer", "minimum": 0}, "months": {"type": "integer", "minimum": 0}, "days": {"type": "integer", "minimum": 0}}}]},
        "trigger": {"type": "string", "default": "date", "description": "Name of the record date the period runs from"},
        "count_from": {"type": "string", "enum": ["trigger_date", "next_day"], "default": "trigger_date"},
        "rounding": {"type": "string", "enum": ["none", "end_of_month", "end_of_year"], "default": "none"},
        "action": {"type": "string", "enum": ["destroy", "review", "archive"], "default": "destroy"},
        "legal_basis": {"type": "string"}, "jurisdiction": {"type": "string"}, "note": {"type": "string"}}}},
      "records": {"type": "array", "items": {"type": "object", "required": ["record_type"], "additionalProperties": false, "properties": {
        "id": {"type": "string"}, "record_type": {"type": "string"}, "description": {"type": "string"},
        "dates": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}},
        "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Short for dates.date"},
        "legal_hold": {"type": "boolean", "default": false}, "hold_reason": {"type": "string"}}}}
    }
  },
  "program": "python3",
  "args": ["retention_schedule.py"],
  "files": ["retention_schedule.py"],
  "catalog": {
    "version": "1.0.0",
    "category": "law",
    "tags": ["records-management", "retention", "legal-hold", "compliance", "gdpr", "conservacion"],
    "license": "MIT",
    "requires": {"program_min_version": "3.10", "packages": []},
    "network": false,
    "example": {
      "input": {"as_of": "2026-10-18", "schedule": [{"record_type": "invoice", "period": {"years": 4}, "trigger": "filing_deadline", "count_from": "next_day", "legal_basis": "Ley 58/2003 General Tributaria, arts. 66 and 67.1"}, {"record_type": "invoice", "period": "P6Y", "trigger": "last_book_entry", "legal_basis": "Código de Comercio, art. 30.1"}], "records": [{"id": "F-2019-001", "record_type": "invoice", "dates": {"filing_deadline": "2020-01-30", "last_book_entry": "2019-12-31"}}]},
      "output": {"records": [{"id": "F-2019-001", "governing_rule": 1, "retain_until": "2025-12-31", "action_date": "2026-01-01", "status": "past_retention"}]}
    },
    "source": "original; date arithmetic as in deadline_calc (calendar months clamped to the month's end); the Spanish example rules (Ley 58/2003 arts. 66-67, Código de Comercio art. 30) are inputs, not bundled"
  }
}
