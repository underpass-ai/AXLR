[
  {"name": "GDPR Art. 30(1): the controller record has items (a) to (g)", "input": {"role": "controller"}, "expect": {"exit": 0, "stdout_json": {"article": "30(1)", "items": [{"ref": "30(1)(a)"}, {"ref": "30(1)(b)"}, {"ref": "30(1)(c)"}, {"ref": "30(1)(d)"}, {"ref": "30(1)(e)"}, {"ref": "30(1)(f)"}, {"ref": "30(1)(g)"}], "complete": false}}},
  {"name": "GDPR Art. 30(1)(d) wording", "input": {"role": "controller"}, "expect": {"exit": 0, "stdout_contains": "the categories of recipients to whom the personal data have been or will be disclosed including recipients in third countries or international organisations"}},
  {"name": "GDPR Art. 30(2): the processor record has items (a) to (d), in Spanish", "input": {"role": "processor", "language": "es"}, "expect": {"exit": 0, "stdout_json": {"items": [{"ref": "30(2)(a)"}, {"ref": "30(2)(b)", "text": "las categorías de tratamientos efectuados por cuenta de cada responsable"}, {"ref": "30(2)(c)"}, {"ref": "30(2)(d)"}]}}},
  {"name": "filled controller activity: no mandatory field missing, security measures listed as where possible", "input": {"role": "controller", "organisation": {"name": "Acme SL", "contact": "privacy@acme.example", "dpo": "dpo@acme.example"}, "activities": [{"name": "Payroll", "purposes": ["Paying salaries", "Tax and social security"], "data_subjects": "Employees", "data_categories": ["Identification", "Bank details"], "recipients": ["Tax agency", "Social security", "Bank"], "transfers": "none", "erasure_time_limits": "4 years after the end of the employment", "legal_basis": "Art. 6(1)(b) and (c)"}]}, "expect": {"exit": 0, "stdout_json": {"complete": true, "missing_mandatory": [], "missing_conditional": [{"field": "joint_controller", "requirement": "where_applicable"}, {"field": "organisation.representative"}, {"item": "30(1)(g)", "requirement": "where_possible"}]}}},
  {"name": "an empty activity lists its mandatory gaps", "input": {"role": "controller", "organisation": {"name": "Acme SL", "contact": "privacy@acme.example", "dpo": "dpo@acme.example"}, "activities": [{"name": "CCTV"}]}, "expect": {"exit": 0, "stdout_json": {"complete": false, "missing_mandatory": [{"item": "30(1)(b)", "field": "purposes"}, {"item": "30(1)(c)", "field": "data_subjects"}, {"item": "30(1)(c)", "field": "data_categories"}, {"item": "30(1)(d)", "field": "recipients"}]}}},
  {"name": "Markdown escapes a pipe in a value", "input": {"role": "processor", "organisation": {"name": "Cloud SA", "contact": "a | b"}, "activities": [{"name": "Hosting", "controller": "Acme SL", "processing_categories": "hosting"}]}, "expect": {"exit": 0, "stdout_contains": "a \\\\| b"}},
  {"name": "processor field on a controller record", "input": {"role": "controller", "activities": [{"processing_categories": "x"}]}, "expect": {"exit": 2, "stdout_contains": "unknown keys for a controller"}},
  {"name": "bad role", "input": {"role": "owner"}, "expect": {"exit": 2, "stdout_contains": "role must be"}}
