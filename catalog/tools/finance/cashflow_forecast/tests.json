  {"name": "six months checked by hand: salary, rent, quarterly insurance, yearly tax, a one-off bonus", "input": {"start": "2026-01", "months": 6, "opening_balance": 0, "items": [{"name": "salary", "amount": 2000}, {"name": "rent", "amount": -1500, "day": 1}, {"name": "insurance", "amount": -900, "frequency": "quarterly", "start": "2026-02"}, {"name": "bonus", "amount": 500, "frequency": "once", "start": "2026-06"}, {"name": "tax", "amount": -1200, "frequency": "yearly", "start": "2026-04"}]}, "expect": {"exit": 0, "stdout_json": {
