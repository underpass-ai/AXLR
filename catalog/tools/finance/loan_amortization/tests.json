    {"period": 6, "balance": "4079.93"}, {"period": 7, "balance": "3070.10"}, {"period": 8, "balance": "2053.54"}, {"period": 9, "balance": "1030.20"}, {"period": 10, "interest": "6.87", "principal": "1030.20", "balance": "0.00"}]}}},
  {"name": "numpy-financial pmt example: 200,000 at 7.5 % over 15 years is 1,854.02", "input": {"principal": 200000, "annual_rate": "7.5%", "years": 15, "schedule": false}, "expect": {"exit": 0, "stdout_json": {"payment": "1854.02", "periods_paid": 180}}},
  {"name": "German system by hand: 1,000 at 12 % over 4 years", "input": {"principal": 1000, "annual_rate": "12%", "periods": 4, "payments_per_year": 1, "system": "german"}, "expect": {"exit": 0, "stdout_json": {"totals": {"interest": "300.00"}, "schedule": [
