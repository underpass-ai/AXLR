  {"name": "standard mortgage example: 100,000 at 5 % over 30 years monthly is 536.82", "input": {"principal": 100000, "annual_rate": "5%", "years": 30, "schedule": false}, "expect": {"exit": 0, "stdout_json": {"payment": "536.82", "periods_paid": 360, "last_payment": "538.14", "totals": {"paid": "193256.52", "interest": "93256.52"}}}},
  {"name": "Excel PMT help example: 10,000 at 8 %/12 over 10 months is 1,037.03", "input": {"principal": 10000, "annual_rate": 0.08, "periods": 10}, "expect": {"exit": 0, "stdout_json": {"payment": "1037.03", "last_payment": "1037.07", "schedule": [
