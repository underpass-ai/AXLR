  {"name": "American system: interest only, principal at the end", "input": {"principal": 1000, "annual_rate": "10%", "periods": 3, "payments_per_year": 1, "system": "american"}, "expect": {"exit": 0, "stdout_json": {"schedule": [{"payment": "100.00"}, {"payment": "100.00"}, {"payment": "1100.00", "principal": "1000.00"}]}}},
  {"name": "German early repayment that lowers the instalment", "input": {"principal": 1000, "annual_rate": "12%", "periods": 4, "payments_per_year": 1, "system": "german", "early_repayments": [{"period": 1, "amount": 300, "mode": "reduce_payment"}]}, "expect": {"exit": 0, "stdout_json": {"periods_paid": 4, "without_early_repayments": {"interest_saved": "72.00"}, "schedule": [
    {"extra": "300.00", "balance": "450.00"}, {"payment": "204.00", "principal": "150.00"}, {"payment": "186.00"}, {"payment": "168.00", "balance": "0.00"}]}}},
  {"name": "German early repayment that shortens the term", "input": {"principal": 1000, "annual_rate": "12%", "periods": 4, "payments_per_year": 1, "system": "german", "early_repayments": [{"period": 1, "amount": 300}]}, "expect": {"exit": 0, "stdout_json": {"periods_paid": 3, "totals": {"interest": "198.00", "paid": "1198.00"}}}},
  {"name": "mortgage prepayment after five years cuts the term", "input": {"principal": 100000, "annual_rate": "5%", "years": 30, "schedule": false, "early_repayments": [{"period": 60, "amount": 20000}]}, "expect": {"exit": 0, "stdout_json": {"periods_paid": 257, "payment": "536.82", "totals": {"early_repayments": "20000.00"}}}},
  {"name": "zero rate divides the principal", "input": {"principal": 1200, "annual_rate": 0, "periods": 12, "schedule": false}, "expect": {"exit": 0, "stdout_json": {"payment": "100.00", "totals": {"interest": "0.00"}}}},
  {"name": "both periods and years", "input": {"principal": 1, "annual_rate": 0.01, "periods": 2, "years": 1}, "expect": {"exit": 2, "stdout_contains": "either periods or years"}},
  {"name": "repayment after the last period", "input": {"principal": 1000, "annual_rate": 0.01, "periods": 4, "early_repayments": [{"period": 5, "amount": 1}]}, "expect": {"exit": 2, "stdout_contains": "period must be an integer from 1 to 4"}}
