[
  {"name": "RFC 6902 A.1 adding an object member: {foo: bar} to {baz: qux, foo: bar} is add /baz qux", "input": {"a": {"foo": "bar"}, "b": {"baz": "qux", "foo": "bar"}}, "expect": {"exit": 0, "stdout_json": {"patch": [{"op": "add", "path": "/baz", "value": "qux"}], "differences": [{"op": "added", "path": "/baz", "new": "qux"}], "patch_verified": true}}},
  {"name": "RFC 6902 A.2 adding an array element: with arrays lcs the patch is add /foo/1 qux", "input": {"a": {"foo": ["bar", "baz"]}, "b": {"foo": ["bar", "qux", "baz"]}, "arrays": "lcs"}, "expect": {"exit": 0, "stdout_json": {"patch": [{"op": "add", "path": "/foo/1", "value": "qux"}]}}},
  {"name": "RFC 6902 A.3 removing an object member: remove /baz", "input": {"a": {"baz": "qux", "foo": "bar"}, "b": {"foo": "bar"}}, "expect": {"exit": 0, "stdout_json": {"patch": [{"op": "remove", "path": "/baz"}]}}},
  {"name": "RFC 6902 A.4 removing an array element: with arrays lcs the patch is remove /foo/1", "input": {"a": {"foo": ["bar", "qux", "baz"]}, "b": {"foo": ["bar", "baz"]}, "arrays": "lcs"}, "expect": {"exit": 0, "stdout_json": {"patch": [{"op": "remove", "path": "/foo/1"}], "summary": {"removed": 1}}}},
  {"name": "the same as A.4 compared by index: replace /foo/1 then remove /foo/2, still verified", "input": {"a": {"foo": ["bar", "qux", "baz"]}, "b": {"foo": ["bar", "baz"]}}, "expect": {"exit": 0, "stdout_json": {"patch": [{"op": "replace", "path": "/foo/1", "value": "baz"}, {"op": "remove", "path": "/foo/2"}], "patch_verified": true}}},
  {"name": "RFC 6902 A.5 replacing a value: replace /baz boo", "input": {"a": {"baz": "qux", "foo": "bar"}, "b": {"baz": "boo", "foo": "bar"}}, "expect": {"exit": 0, "stdout_json": {"patch": [{"op": "replace", "path": "/baz", "value": "boo"}], "differences": [{"op": "changed", "path": "/baz", "old": "qux", "new": "boo"}]}}},
  {"name": "RFC 6902 A.10 adding a nested member object: add /child", "input": {"a": {"foo": "bar"}, "b": {"foo": "bar", "child": {"grandchild": {}}}}, "expect": {"exit": 0, "stdout_json": {"patch": [{"op": "add", "path": "/child", "value": {"grandchild": {}}}]}}},
  {"name": "RFC 6902 A.14 / RFC 6901 escaping: the member named ~1 is the pointer /~01", "input": {"a": {"/": 9, "~1": 10}, "b": {"/": 9, "~1": 11}}, "expect": {"exit": 0, "stdout_json": {"patch": [{"op": "replace", "path": "/~01", "value": 11}]}}},
  {"name": "RFC 6902 A.6 moving a value (apply)", "input": {"operation": "apply", "doc": {"foo": {"bar": "baz", "waldo": "fred"}, "qux": {"corge": "grault"}}, "patch": [{"op": "move", "from": "/foo/waldo", "path": "/qux/thud"}]}, "expect": {"exit": 0, "stdout_json": {"applied": true, "result": {"foo": {"bar": "baz"}, "qux": {"corge": "grault", "thud": "fred"}}}}},
  {"name": "RFC 6902 A.7 moving an array element (apply)", "input": {"operation": "apply", "doc": {"foo": ["all", "grass", "cows", "eat"]}, "patch": [{"op": "move", "from": "/foo/1", "path": "/foo/3"}]}, "expect": {"exit": 0, "stdout_json": {"result": {"foo": ["all", "cows", "eat", "grass"]}}}},
  {"name": "RFC 6902 A.8 testing a value: success", "input": {"operation": "apply", "doc": {"baz": "qux", "foo": ["a", 2, "c"]}, "patch": [{"op": "test", "path": "/baz", "value": "qux"}, {"op": "test", "path": "/foo/1", "value": 2}]}, "expect": {"exit": 0, "stdout_json": {"applied": true, "result": {"baz": "qux", "foo": ["a", 2, "c"]}}}},
  {"name": "RFC 6902 A.9 testing a value: error", "input": {"operation": "apply", "doc": {"baz": "qux"}, "patch": [{"op": "test", "path": "/baz", "value": "bar"}]}, "expect": {"exit": 0, "stdout_json": {"applied": false, "result": null}}},
  {"name": "RFC 6902 A.12 adding to a nonexistent target is an error", "input": {"operation": "apply", "doc": {"foo": "bar"}, "patch": [{"op": "add", "path": "/baz/bat", "value": "qux"}]}, "expect": {"exit": 0, "stdout_json": {"applied": false}, "stdout_contains": "does not exist"}},
  {"name": "RFC 6902 A.16 adding an array value with /-", "input": {"operation": "apply", "doc": {"foo": ["bar"]}, "patch": [{"op": "add", "path": "/foo/-", "value": ["abc", "def"]}]}, "expect": {"exit": 0, "stdout_json": {"result": {"foo": ["bar", ["abc", "def"]]}}}},
  {"name": "RFC 6902 A.15 comparing strings and numbers: test /~01 \"10\" fails against 10", "input": {"operation": "apply", "doc": {"/": 9, "~1": 10}, "patch": [{"op": "test", "path": "/~01", "value": "10"}]}, "expect": {"exit": 0, "stdout_json": {"applied": false}}},
  {"name": "arrays matched by key (hand-checked): id 1 removed, id 2 changed v, id 4 added", "input": {"a": [{"id": 1, "v": "x"}, {"id": 2, "v": "y"}, {"id": 3}], "b": [{"id": 2, "v": "Y"}, {"id": 3}, {"id": 4}], "arrays": "key", "key": "id"}, "expect": {"exit": 0, "stdout_json": {"summary": {"added": 1, "removed": 1, "changed": 1, "reordered": 0}, "differences": [{"op": "removed", "path": "/0", "key": 1}, {"op": "changed", "path": "/1/v", "old": "y", "new": "Y", "key": 2}, {"op": "added", "path": "/2", "key": 4}], "patch": [{"op": "remove", "path": "/0"}, {"op": "replace", "path": "/0/v", "value": "Y"}, {"op": "add", "path": "/2", "value": {"id": 4}}], "patch_verified": true}}},
  {"name": "1 and 1.0 are equal JSON numbers, true and 1 are not", "input": {"a": {"x": 1, "y": true}, "b": {"x": 1.0, "y": 1}}, "expect": {"exit": 0, "stdout_json": {"differences": [{"op": "changed", "path": "/y", "old": true, "new": 1}]}}},
  {"name": "equal documents", "input": {"a_text": "{\"k\": [1, {\"z\": null}]}", "b_text": "{\"k\":[1,{\"z\":null}]}"}, "expect": {"exit": 0, "stdout_json": {"equal": true, "patch": [], "differences": []}}},
  {"name": "arrays key without key", "input": {"a": [], "b": [], "arrays": "key"}, "expect": {"exit": 2, "stdout_contains": "needs key"}},
  {"name": "missing b", "input": {"a": 1}, "expect": {"exit": 2, "stdout_contains": "b is required"}}
]
