[
  {"name": "round trip worked by hand, step 1: nested JSON flattens to dotted columns (address.geo.lat) and indexed arrays (tags.0, tags.1) (JSON given as text, so its key order is kept)", "input": {"json_text": "[{\"id\": 1, \"name\": \"Ana\", \"address\": {\"city\": \"Madrid\", \"geo\": {\"lat\": 40.4, \"lon\": -3.7}}, \"tags\": [\"a\", \"b\"], \"active\": true}, {\"id\": 2, \"name\": \"Ben\", \"address\": {\"city\": \"Lyon\", \"geo\": {\"lat\": 45.76, \"lon\": 4.84}}, \"tags\": [\"c\", \"d\"], \"active\": false}]"}, "expect": {"exit": 0, "stdout_json": {"to": "csv", "rows": 2, "csv": "id,name,address.city,address.geo.lat,address.geo.lon,tags.0,tags.1,active\n1,Ana,Madrid,40.4,-3.7,a,b,true\n2,Ben,Lyon,45.76,4.84,c,d,false\n", "columns": ["id", "name", "address.city", "address.geo.lat", "address.geo.lon", "tags.0", "tags.1", "active"]}}},
  {"name": "round trip step 2: the same CSV nests back to the original JSON exactly (types inferred)", "input": {"csv": "id,name,address.city,address.geo.lat,address.geo.lon,tags.0,tags.1,active\n1,Ana,Madrid,40.4,-3.7,a,b,true\n2,Ben,Lyon,45.76,4.84,c,d,false\n"}, "expect": {"exit": 0, "stdout_json": {"to": "json", "json": [{"id": 1, "name": "Ana", "address": {"city": "Madrid", "geo": {"lat": 40.4, "lon": -3.7}}, "tags": ["a", "b"], "active": true}, {"id": 2, "name": "Ben", "address": {"city": "Lyon", "geo": {"lat": 45.76, "lon": 4.84}}, "tags": ["c", "d"], "active": false}]}}},
  {"name": "csvkit-style flat conversion without nesting or inference", "input": {"csv": "a.b;c\n1;x\n", "nest": false, "infer_types": false}, "expect": {"exit": 0, "stdout_json": {"delimiter": ";", "json": [{"a.b": "1", "c": "x"}]}}},
  {"name": "leading zeros stay text, empty cells: null by default, omitted on request", "input": {"csv": "zip,n,note\n01234,2,\n", "empty": "omit"}, "expect": {"exit": 0, "stdout_json": {"json": [{"zip": "01234", "n": 2}]}}},
  {"name": "empty cell as null", "input": {"csv": "a,b\n1,\n"}, "expect": {"exit": 0, "stdout_json": {"json": [{"a": 1, "b": null}]}}},
  {"name": "arrays with a gap are padded with null", "input": {"csv": "x.0,x.2\n1,3\n"}, "expect": {"exit": 0, "stdout_json": {"json": [{"x": [1, null, 3]}]}}},
  {"name": "JSON Lines in, custom separator, arrays as JSON text", "input": {"json_text": "{\"a\": {\"b\": 1}, \"l\": [1, 2]}\n{\"a\": {\"b\": 2}, \"l\": []}\n", "separator": "/", "arrays": "json"}, "expect": {"exit": 0, "stdout_json": {"columns": ["a/b", "l"], "csv": "a/b,l\n1,\"[1, 2]\"\n2,[]\n"}}},
  {"name": "keyed output by a column", "input": {"csv": "code,name\nES,Spain\nFR,France\n", "format": "keyed", "key_column": "code"}, "expect": {"exit": 0, "stdout_json": {"json": {"ES": {"code": "ES", "name": "Spain"}, "FR": {"code": "FR", "name": "France"}}}}},
  {"name": "jsonl output", "input": {"csv": "a\n1\n2\n", "format": "jsonl"}, "expect": {"exit": 0, "stdout_json": {"jsonl": "{\"a\": 1}\n{\"a\": 2}\n"}}},
  {"name": "a column and a column nested under it conflict", "input": {"csv": "a,a.b\n1,2\n"}, "expect": {"exit": 2, "stdout_contains": "conflicts"}},
  {"name": "JSON that is not an array of objects", "input": {"json": []}, "expect": {"exit": 2, "stdout_contains": "array of objects"}},
  {"name": "two inputs", "input": {"csv": "a\n1\n", "json": []}, "expect": {"exit": 2, "stdout_contains": "exactly one input"}}
]
