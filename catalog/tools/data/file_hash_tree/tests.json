[
  {"name": "FIPS 180-2 Appendix B.1: SHA-256 of \"abc\" is ba7816bf...f20015ad; of the empty string e3b0c442...7852b855", "input": {"files": {"abc.txt": "abc", "empty.txt": ""}}, "expect": {"exit": 0, "stdout_json": {"count": 2, "entries": [{"path": "abc.txt", "hash": "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", "bytes": 3}, {"path": "empty.txt", "hash": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "bytes": 0}], "manifest": "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad  abc.txt\ne3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855  empty.txt\n"}}},
  {"name": "FIPS 180-2 Appendix C.1: SHA-512 of \"abc\" (as hex 616263)", "input": {"files_hex": {"abc.bin": "616263"}, "algorithm": "sha512"}, "expect": {"exit": 0, "stdout_contains": "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f  abc.bin"}},
  {"name": "identical to GNU sha256sum output (checked with sha256sum | LC_ALL=C sort): bytewise order and a backslash name escaped with a leading backslash", "input": {"files": {"we\\ird.txt": "x", "sub/hello.txt": "hello\n", "empty.txt": "", "abc.txt": "abc"}}, "expect": {"exit": 0, "stdout_json": {"manifest": "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad  abc.txt\ne3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855  empty.txt\n5891b5b522d5df086d0ff0b110fbd9d21bb4fc7163af34d08286a2e846f6be03  sub/hello.txt\n\\2d711642b726b04401627ca9fbac32f5c8530fb1903cc4db02258717921a4881  we\\\\ird.txt\n", "count": 4, "total_bytes": 10}}},
  {"name": "BSD-style manifest lines", "input": {"files": {"abc.txt": "abc"}}, "expect": {"exit": 0, "stdout_json": {"bsd_manifest": "SHA256 (abc.txt) = ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\n"}}},
  {"name": "verify: one ok (BSD line), one changed, one missing, one extra; binary-mode * line accepted", "input": {"operation": "verify", "files": {"abc.txt": "abd", "sub/hello.txt": "hello\n", "new.txt": ""}, "manifest": "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad  abc.txt\ne3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855 *empty.txt\nSHA256 (sub/hello.txt) = 5891b5b522d5df086d0ff0b110fbd9d21bb4fc7163af34d08286a2e846f6be03\n"}, "expect": {"exit": 0, "stdout_json": {"verify": {"valid": false, "ok": ["sub/hello.txt"], "changed": [{"path": "abc.txt", "expected": "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"}], "missing": ["empty.txt"], "extra": ["new.txt"], "manifest_problems": []}}}},
  {"name": "verify passes on its own manifest, escaped names included", "input": {"operation": "verify", "files": {"we\\ird.txt": "x", "sub/hello.txt": "hello\n", "empty.txt": "", "abc.txt": "abc"}, "manifest": "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad  abc.txt\ne3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855  empty.txt\n5891b5b522d5df086d0ff0b110fbd9d21bb4fc7163af34d08286a2e846f6be03  sub/hello.txt\n\\2d711642b726b04401627ca9fbac32f5c8530fb1903cc4db02258717921a4881  we\\\\ird.txt\n"}, "expect": {"exit": 0, "stdout_json": {"verify": {"valid": true, "changed": [], "missing": [], "extra": []}}}},
  {"name": "a relative directory is walked (only the program matches *.py)", "input": {"directory": ".", "include": ["*.py"]}, "expect": {"exit": 0, "stdout_json": {"count": 1, "entries": [{"path": "file_hash_tree.py"}]}}},
  {"name": "a malformed manifest line is reported", "input": {"operation": "verify", "files": {"a": "abc"}, "manifest": "abc123  a\n"}, "expect": {"exit": 0, "stdout_json": {"verify": {"valid": false, "manifest_problems": ["line 1: a sha256 digest has 64 hex digits, this one 6"]}}}},
  {"name": "directory outside the working directory", "input": {"directory": "../.."}, "expect": {"exit": 2, "stdout_contains": "must not contain"}},
  {"name": "nothing to hash", "input": {}, "expect": {"exit": 2, "stdout_contains": "give files"}},
  {"name": "unknown algorithm", "input": {"files": {"a": ""}, "algorithm": "crc32"}, "expect": {"exit": 2, "stdout_contains": "algorithm must be"}}
]
