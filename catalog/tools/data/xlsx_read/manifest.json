{
  "name": "xlsx_read",
  "description": "Read the sheets of an Excel .xlsx workbook into CSV and JSON with no package: the file (hex or a relative path) is opened as a zip and its SpreadsheetML parsed: shared strings (rich text runs joined), inline strings, numbers, booleans, errors and formulas' cached values. Numbers with a date or time format (built-in or custom) become ISO dates with the workbook's 1900 or 1904 date system, including Excel's phantom 1900-02-29; merged ranges are reported. Rows as arrays, records keyed by the header, and CSV.",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "hex": {
        "type": "string",
        "description": "The .xlsx file as hex"
      },
      "path": {
        "type": "string",
        "description": "Or a relative path to the .xlsx"
      },
      "sheet": {
        "type": [
          "string",
          "integer"
        ],
        "description": "Sheet name or 1-based index (default: all)"
      },
      "header": {
        "type": "boolean",
        "default": true,
        "description": "Also return records keyed by the first row"
      },
      "max_rows": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000000,
        "default": 10000
      },
      "dates": {
        "type": "string",
        "enum": [
          "iso",
          "serial"
        ],
        "default": "iso"
      }
    }
  },
  "program": "python3",
  "args": [
    "xlsx_read.py"
  ],
  "files": [
    "xlsx_read.py"
  ],
  "catalog": {
    "version": "1.0.0",
