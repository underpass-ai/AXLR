[
  {"name": "Anscombe (1973) quartet, data set I: mean of x = 9, sample variance of x = 11, mean of y = 7.50 (82.51 / 11), variance of y = 4.127", "input": {"csv": "x,y\n10,8.04\n8,6.95\n13,7.58\n9,8.81\n11,8.33\n14,9.96\n6,7.24\n4,4.26\n12,10.84\n7,4.82\n5,5.68\n"}, "expect": {"exit": 0, "stdout_json": {"rows": 11, "stats": [{"column": "x", "type": "integer", "mean": "9", "variance": "11", "sum": "99", "median": "9", "min": "4", "max": "14"}, {"column": "y", "type": "decimal", "sum": "82.51", "min": "4.26", "max": "10.84", "median": "7.58"}]}}},
  {"name": "Anscombe I: mean of y = 7.500909... and variance of y = 4.127269...", "input": {"csv": "x,y\n10,8.04\n8,6.95\n13,7.58\n9,8.81\n11,8.33\n14,9.96\n6,7.24\n4,4.26\n12,10.84\n7,4.82\n5,5.68\n", "columns": ["y"]}, "expect": {"exit": 0, "stdout_contains": "\"mean\": \"7.500909090909090909090909091\""}},
  {"name": "Anscombe I: variance of y", "input": {"csv": "x,y\n10,8.04\n8,6.95\n13,7.58\n9,8.81\n11,8.33\n14,9.96\n6,7.24\n4,4.26\n12,10.84\n7,4.82\n5,5.68\n", "columns": ["y"]}, "expect": {"exit": 0, "stdout_contains": "\"variance\": \"4.12726909090909090909090909"}},
  {"name": "semicolon dialect sniffed; nulls, integer, decimal, date, boolean and text columns (hand-checked: ages 34, 28, 41 have mean 103/3, median 34, variance 127/3)", "input": {"csv": "name;age;score;joined;active\nAna;34;7.5;2024-01-15;yes\nBen;28;;2023-06-01;no\nCruz;41;9.25;2025-03-10;yes\nDee;NA;6;2024-01-15;yes\n"}, "expect": {"exit": 0, "stdout_json": {"delimiter": ";", "delimiter_sniffed": true, "rows": 4, "stats": [{"column": "name", "type": "text", "min": "Ana", "max": "Dee", "unique": true}, {"column": "age", "type": "integer", "nulls": 1, "non_null": 3, "sum": "103", "median": "34", "mean": "34.33333333333333333333333333", "variance": "42.33333333333333333333333333"}, {"column": "score", "type": "decimal", "nulls": 1, "sum": "22.75", "median": "7.5", "max_decimal_places": 2}, {"column": "joined", "type": "date", "min": "2023-06-01", "max": "2025-03-10", "distinct": 3, "top": [{"value": "2024-01-15", "count": 2}, {"value": "2023-06-01", "count": 1}, {"value": "2025-03-10", "count": 1}]}, {"column": "active", "type": "boolean", "true": 3, "false": 1}]}}},
  {"name": "no header, tab delimiter given, quoted field with a comma", "input": {"csv": "a\t\"x, y\"\nb\tz\n", "delimiter": "\\t", "header": false, "top": 1}, "expect": {"exit": 0, "stdout_json": {"delimiter": "\t", "stats": [{"column": "column_1", "distinct": 2}, {"column": "column_2", "top": [{"value": "x, y", "count": 1}]}]}}},
  {"name": "precision 5", "input": {"csv": "v\n1\n2\n2\n", "precision": 5}, "expect": {"exit": 0, "stdout_json": {"stats": [{"mean": "1.6667", "median": "2", "stdev": "0.57735"}]}}},
  {"name": "unknown column", "input": {"csv": "a\n1\n", "columns": ["b"]}, "expect": {"exit": 2, "stdout_contains": "no such column"}},
  {"name": "no csv", "input": {}, "expect": {"exit": 2, "stdout_contains": "csv is required"}},
  {"name": "path with ..", "input": {"path": "../x.csv"}, "expect": {"exit": 2, "stdout_contains": "relative path"}}
]
