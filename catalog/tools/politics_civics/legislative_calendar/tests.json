 },
 {
  "name": "calendar without sittings",
  "input": {
   "calendar": {
    "start": "2026-10-01",
    "end": "2026-10-31"
   },
   "events": {
    "x": "2026-10-01"
   },
   "rules": [
    {
     "name": "a",
     "from": "x",
     "count": 1
    }
   ]
  },
  "expect": {
   "exit": 2,
   "stdout_contains": "calendar needs"
  }
 }
]