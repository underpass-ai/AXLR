{
  "name": "legislative_calendar",
  "description": "Compute a bill's procedural deadlines from its key dates, a session calendar and counting rules all given in the input: N sitting days after or before an event, calendar days with or without recess time, rolled to a sitting day if the rule says so, chained from other deadlines. Assumes no parliament's rules; prints a disclaimer.",
  "input_schema": {
    "type": "object",
    "required": ["calendar", "rules"],
    "additionalProperties": false,
    "properties": {
      "calendar": {"type": "object", "additionalProperties": false, "description": "sitting_days, or start, end and sitting_weekdays; plus optional recesses and exceptions", "properties": {
        "sitting_days": {"type": "array", "items": {"type": "string", "format": "date"}},
        "start": {"type": "string", "format": "date"},
        "end": {"type": "string", "format": "date"},
        "sitting_weekdays": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 7}, "description": "ISO weekdays, Monday = 1"},
        "recesses": {"type": "array", "items": {"type": "object", "required": ["start", "end"], "additionalProperties": false, "properties": {
          "start": {"type": "string", "format": "date"}, "end": {"type": "string", "format": "date"}, "name": {"type": "string"}}}},
        "non_sitting_days": {"type": "array", "items": {"type": "string", "format": "date"}},
        "extra_sitting_days": {"type": "array", "items": {"type": "string", "format": "date"}}
      }},
      "events": {"type": "object", "additionalProperties": {"type": "string", "format": "date"}, "description": "The bill's known dates by name"},
      "rules": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "from", "count"], "additionalProperties": false, "properties": {
        "name": {"type": "string"},
        "from": {"type": "string", "description": "An event or another rule"},
        "count": {"type": "integer", "minimum": 0, "maximum": 36500},
        "unit": {"type": "string", "enum": ["sitting_days", "calendar_days", "calendar_days_excluding_recess"], "default": "sitting_days"},
        "direction": {"type": "string", "enum": ["after", "before"], "default": "after"},
        "include_start": {"type": "boolean", "default": false, "description": "sitting_days: the from date counts as day one when it is a sitting day"},
        "roll": {"type": "string", "enum": ["none", "next_sitting_day", "previous_sitting_day"], "default": "none", "description": "Calendar units: move a deadline off a non-sitting day"}
      }}}
    }
  },
  "program": "python3",
  "args": ["legislative_calendar.py"],
  "files": ["legislative_calendar.py"],
  "catalog": {
    "version": "1.0.0",
    "category": "politics_civics",
    "tags": ["legislation", "parliament", "deadlines", "calendar", "sitting-days", "procedure"],
    "license": "MIT",
    "requires": {"program_min_version": "3.10", "packages": []},
    "network": false,
    "example": {
      "input": {"calendar": {"start": "2026-10-01", "end": "2026-11-30", "sitting_weekdays": [2, 3, 4], "recesses": [{"start": "2026-10-12", "end": "2026-10-16", "name": "October recess"}]}, "events": {"publication": "2026-10-01"}, "rules": [{"name": "amendments", "from": "publication", "count": 6}]},
      "output": {"deadlines": [{"name": "amendments", "deadline": "2026-10-22", "weekday": "Thursday", "is_sitting_day": true}]}
    },
    "source": "original; counting conventions (sitting days, recess exclusion, rolling to the next sitting day) as found in chamber standing orders, to be supplied by the user"
  }
}
