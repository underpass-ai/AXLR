{
  "name": "vote_borda",
  "description": "Score ranked ballots by the Borda count (n-1 to 0, or n to 1) or the Dowdall system (1, 1/2, 1/3, ...), in exact fractions. Ballots may tie candidates or leave some unranked; tied and unranked candidates score by the lowest position, the average, or the modified Borda count.",
  "input_schema": {
    "type": "object",
    "required": ["ballots"],
    "additionalProperties": false,
    "properties": {
      "ballots": {"type": "array", "minItems": 1, "description": "Each a ranking (list of names; an inner list is a tie) or {ranking, count}", "items": {
        "anyOf": [
          {"type": "array", "items": {"anyOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}]}},
          {"type": "object", "required": ["ranking"], "additionalProperties": false, "properties": {
            "ranking": {"type": "array", "items": {"anyOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}]}},
            "count": {"type": "integer", "minimum": 0, "default": 1}}}
        ]}},
      "candidates": {"type": "array", "items": {"type": "string"}, "description": "Every candidate, including any no ballot ranks; default the names on the ballots"},
      "variant": {"type": "string", "enum": ["borda", "borda_n", "dowdall"], "default": "borda"},
      "partial": {"type": "string", "enum": ["lowest", "average", "modified"], "default": "lowest", "description": "Scoring of tied and unranked candidates"}
    }
  },
  "program": "python3",
  "args": ["vote_borda.py"],
  "files": ["vote_borda.py"],
  "catalog": {
    "version": "1.0.0",
    "category": "politics_civics",
    "tags": ["elections", "borda", "dowdall", "ranked-choice", "positional-voting", "nauru"],
    "license": "MIT",
    "requires": {"program_min_version": "3.10", "packages": []},
    "network": false,
    "example": {
      "input": {"variant": "dowdall", "ballots": [{"ranking": ["Memphis", "Nashville", "Chattanooga", "Knoxville"], "count": 42}, {"ranking": ["Nashville", "Chattanooga", "Knoxville", "Memphis"], "count": 26}, {"ranking": ["Chattanooga", "Knoxville", "Nashville", "Memphis"], "count": 15}, {"ranking": ["Knoxville", "Chattanooga", "Nashville", "Memphis"], "count": 17}]},
      "output": {"scores": {"Nashville": "57.666667", "Memphis": "56.5", "Chattanooga": "50.5", "Knoxville": "43.666667"}, "winners": ["Nashville"]}
    },
    "source": "original; Borda, Mémoire sur les élections au scrutin (1781), and the Dowdall rule of Nauru's parliament, as described in Wikipedia's Borda count article"
  }
}
