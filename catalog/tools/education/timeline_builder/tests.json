[
 {
  "name": "no year 0 in the historical calendar (1 BC is followed by AD 1): 27 BC to AD 14 is 40 years, 1 BC to AD 1 is 1 year",
  "input": {
   "events": [
    {
     "label": "Augustus reigns",
     "start": "27 BC",
     "end": "AD 14"
    },
    {
     "label": "1 BC to AD 1",
     "start": -1,
     "end": 1
    },
    {
     "label": "Caesar killed",
     "date": "-44-03-15"
    },
    {
     "label": "Rome founded",
     "date": -753
    }
   ],
   "width": 30,
   "era": "BC"
  },
  "expect": {
   "exit": 0,
   "stdout_json": {
    "markdown_table": "| Start | End | Event | Years |\n|:--|:--|:--|--:|\n| 753 BC |  | Rome founded |  |\n| 44-03-15 BC |  | Caesar killed |  |\n| 27 BC | AD 14 | Augustus reigns | 40 |\n| 1 BC | AD 1 | 1 BC to AD 1 | 1 |\n",
    "overlaps": [
     {
      "events": [
       1,
       2
      ],
      "kind": "contains"
     }
    ]
   }
  }
 },
