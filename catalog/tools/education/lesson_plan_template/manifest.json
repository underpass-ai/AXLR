{
  "name": "lesson_plan_template",
  "description": "Lesson plan skeleton for a subject, level and duration: warm-up, presentation, practice, production, assessment and closure with whole minutes allocated in proportion to stage weights (largest remainder, so they add up exactly), and objectives written with verbs of the revised Bloom taxonomy (Anderson & Krathwohl 2001) chosen by level, in English or Spanish. Returns the stages, the objectives and a Markdown plan.",
  "input_schema": {
    "type": "object",
    "required": ["subject", "duration_minutes"],
    "additionalProperties": false,
    "properties": {
      "subject": {"type": "string", "minLength": 1, "maxLength": 200},
      "topic": {"type": "string", "maxLength": 200},
      "level": {"type": "string", "enum": ["primary", "secondary", "upper_secondary", "university", "adult"], "default": "secondary"},
      "duration_minutes": {"type": "integer", "minimum": 10, "maximum": 480},
      "language": {"type": "string", "enum": ["en", "es"], "default": "en"},
      "objectives": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "object", "additionalProperties": false, "required": ["level"], "properties": {
        "level": {"type": "string", "enum": ["remember", "understand", "apply", "analyze", "evaluate", "create"]},
        "content": {"type": "string", "maxLength": 200},
        "verb": {"type": "string", "maxLength": 40, "description": "Overrides the table's verb"}}}},
      "objective_count": {"type": "integer", "minimum": 1, "maximum": 6, "default": 3, "description": "Objectives to draft when none are given"},
      "stage_weights": {"type": "object", "additionalProperties": false, "properties": {
        "warm_up": {"type": "number", "minimum": 0}, "presentation": {"type": "number", "minimum": 0}, "practice": {"type": "number", "minimum": 0},
        "production": {"type": "number", "minimum": 0}, "assessment": {"type": "number", "minimum": 0}, "closure": {"type": "number", "minimum": 0}},
        "description": "Default 10, 25, 25, 20, 10, 10; 0 leaves a stage out"}
    }
  },
  "program": "python3",
  "args": ["lesson_plan_template.py"],
  "files": ["lesson_plan_template.py"],
  "catalog": {
    "version": "1.0.0",
    "category": "education",
    "tags": ["lesson-plan", "teaching", "bloom", "curriculum", "template", "spanish"],
    "license": "MIT",
    "requires": {"program_min_version": "3.10", "packages": []},
    "network": false,
    "example": {"input": {"subject": "Biology", "topic": "photosynthesis", "duration_minutes": 50}, "output": {"stages": [{"stage": "warm_up", "minutes": 5}, {"stage": "presentation", "minutes": 13}, {"stage": "practice", "minutes": 12}, {"stage": "production", "minutes": 10}, {"stage": "assessment", "minutes": 5}, {"stage": "closure", "minutes": 5}]}},
    "source": "Objective verbs after the revised Bloom taxonomy (Anderson & Krathwohl 2001, Table 5.1); stages after the presentation-practice-production lesson model; minutes by the largest-remainder (Hamilton) method"
  }
}
