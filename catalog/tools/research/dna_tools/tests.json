[
  {"name": "Biopython Tutorial (Seq objects): reverse complement of ATGGCC...GATAG", "input": {"sequence": "ATGGCCATTGTAATGGGCCGCTGAAAGGGTGCCCGATAG", "operation": "reverse_complement"}, "expect": {"stdout_json": {"reverse_complement": "CTATCGGGCACCCTTTCAGCGGCCCATTACAATGGCCAT"}}},
  {"name": "Biopython Tutorial (Transcription): mRNA AUGGCCAUUGUAAUGGGCCGCUGAAAGGGUGCCCGAUAG", "input": {"sequence": "ATGGCCATTGTAATGGGCCGCTGAAAGGGTGCCCGATAG", "operation": "transcribe"}, "expect": {"stdout_json": {"rna": "AUGGCCAUUGUAAUGGGCCGCUGAAAGGGUGCCCGAUAG"}}},
  {"name": "Biopython Tutorial (Translation): MAIVMGR*KGAR*, with to_stop MAIVMGR", "input": {"sequence": "ATGGCCATTGTAATGGGCCGCTGAAAGGGTGCCCGATAG", "operation": "translate"}, "expect": {"stdout_json": {"translations": [{"frame": "+1", "protein": "MAIVMGR*KGAR*"}]}}},
  {"name": "Biopython Tutorial: to_stop gives MAIVMGR", "input": {"sequence": "ATGGCCATTGTAATGGGCCGCTGAAAGGGTGCCCGATAG", "operation": "translate", "to_stop": true}, "expect": {"stdout_json": {"translations": [{"frame": "+1", "protein": "MAIVMGR"}]}}},
  {"name": "Biopython Tutorial (GC content): gc_fraction of GATCGATGGGCCTATATAGGATCGAAAATCGC = 0.46875", "input": {"sequence": "GATCGATGGGCCTATATAGGATCGAAAATCGC", "operation": "gc_content"}, "expect": {"stdout_json": {"gc": {"gc_bases": 15, "at_bases": 17, "gc_fraction": 0.46875}}}},
  {"name": "NCBI table 1: TTT F, TGA stop, ATG M, TGG W, AGA R, CTN resolves to L, TAR to stop, NNN to X", "input": {"sequence": "TTTTGAATGTGGAGACTNTARNNN", "operation": "translate"}, "expect": {"stdout_json": {"translations": [{"frame": "+1", "protein": "F*MWRL*X"}]}}},
  {"name": "IUPAC ambiguity codes complemented (R/Y, K/M, B/V, D/H; S, W, N unchanged)", "input": {"sequence": "ACGTRYSWKMBDHVN", "operation": "reverse_complement"}, "expect": {"stdout_json": {"reverse_complement": "NBDHVKMWSRYACGT"}}},
  {"name": "six frames of the tutorial sequence", "input": {"sequence": "ATGGCCATTGTAATGGGCCGCTGAAAGGGTGCCCGATAG", "operation": "translate", "frames": 6}, "expect": {"stdout_json": {"translations": [{"frame": "+1", "protein": "MAIVMGR*KGAR*"}, {"frame": "+2", "protein": "WPL*WAAERVPD"}, {"frame": "+3", "protein": "GHCNGPLKGCPI"}, {"frame": "-1", "protein": "LSGTLSAAHYNGH"}, {"frame": "-2", "protein": "YRAPFQRPITMA"}, {"frame": "-3", "protein": "IGHPFSGPLQWP"}]}}},
  {"name": "ORFs: the tutorial's ATG...TGA ORF of 7 aa at 1-24", "input": {"sequence": "ATGGCCATTGTAATGGGCCGCTGAAAGGGTGCCCGATAG", "operation": "orfs", "min_aa": 3}, "expect": {"stdout_json": {"count": 1, "orfs": [{"frame": "+1", "start": 1, "end": 24, "length_aa": 7, "protein": "MAIVMGR"}]}}},
  {"name": "ORFs on the reverse strand in forward coordinates, and one running off the end", "input": {"sequence": "CCTTAAAACCCGGGTTTCATGG", "operation": "orfs", "min_aa": 1, "require_stop": false}, "expect": {"stdout_json": {"count": 2, "orfs": [{"frame": "-3", "strand": "-", "start": 3, "end": 20, "length_nt": 18, "protein": "MKPGF", "has_stop": true}, {"frame": "+1", "start": 19, "end": 21, "has_stop": false}]}}},
  {"name": "molecular weight by hand: ATGC = 313.21 + 304.2 + 289.18 + 329.21 - 61.96 = 1173.84", "input": {"sequence": "ATGC", "operation": "molecular_weight"}, "expect": {"stdout_json": {"molecular_weight": {"molecular_weight": 1173.84}}}},
  {"name": "RNA molecular weight by hand: AUGC = 1285.77 + 159.0 = 1444.77", "input": {"sequence": "AUGC", "operation": "molecular_weight"}, "expect": {"stdout_json": {"type": "RNA", "molecular_weight": {"molecular_weight": 1444.77}}}},
  {"name": "FASTA header, spaces and numbers ignored", "input": {"sequence": ">seq1 test\nATGGCC ATTGTA 13\nATGGGC", "operation": "translate", "frames": 3}, "expect": {"stdout_json": {"length": 18, "translations": [{"protein": "MAIVMG"}, {"protein": "WPL*W"}, {"protein": "GHCNG"}]}}},
  {"name": "non-IUPAC letters", "input": {"sequence": "ATGXYZ"}, "expect": {"exit": 2, "stdout_contains": "not IUPAC nucleotide codes: XZ"}},
  {"name": "mixed T and U", "input": {"sequence": "ATGU"}, "expect": {"exit": 2, "stdout_contains": "mixes T and U"}}
]
