[
  {"name": "PRISMA 2020 statement (Page et al., BMJ 2021, fig 1) template boxes, numbers hand-checked: 220 identified - 45 removed = 175 screened, - 120 = 55 sought, - 5 = 50 assessed, - 40 = 10 + 5 other = 15 reports", "input": {"databases": {"MEDLINE": 120, "Embase": 85}, "registers": {"ClinicalTrials.gov": 15}, "duplicates_removed": 40, "automation_removed": 5, "other_removed": 0, "records_excluded": 120, "reports_not_retrieved": 5, "reports_excluded": {"Wrong population": 20, "Wrong outcome": 12, "Not an RCT": 8}, "studies_included": 8, "records_screened": 175, "other_methods": {"sources": {"Websites": 6, "Citation searching": 10}, "reports_not_retrieved": 2, "reports_excluded": {"Wrong population": 9}}}, "expect": {"stdout_json": {"consistent": true, "counts": {"identification": {"databases": 205, "registers": 15, "records_identified": 220, "removed_before_screening": 45}, "screening": {"records_screened": 175, "reports_sought": 55, "reports_assessed": 50, "reports_excluded": 40}, "included": {"studies_included": 8, "reports_included": 15}, "other_methods": {"reports_sought": 16, "reports_assessed": 14, "reports_included": 5}}}}},
  {"name": "PRISMA 2020 template box wording (Page et al., BMJ 2021, fig 1)", "input": {"databases": {"MEDLINE": 120, "Embase": 85}, "registers": {"ClinicalTrials.gov": 15}, "duplicates_removed": 40, "automation_removed": 5, "other_removed": 0, "records_excluded": 120, "reports_not_retrieved": 5, "reports_excluded": {"Wrong population": 20, "Wrong outcome": 12, "Not an RCT": 8}, "studies_included": 8, "records_screened": 175, "other_methods": {"sources": {"Websites": 6, "Citation searching": 10}, "reports_not_retrieved": 2, "reports_excluded": {"Wrong population": 9}}}, "expect": {"stdout_json": {"boxes": [{"id": "identified", "lines": ["Records identified from:", "Databases (n = 205)", "  Embase (n = 85)", "  MEDLINE (n = 120)", "Registers (n = 15)", "  ClinicalTrials.gov (n = 15)"]}, {"id": "removed", "lines": ["Records removed before screening:", "Duplicate records removed (n = 40)", "Records marked as ineligible by automation tools (n = 5)", "Records removed for other reasons (n = 0)"]}, {"lines": ["Records screened (n = 175)"]}, {"lines": ["Records excluded (n = 120)"]}, {"lines": ["Reports sought for retrieval (n = 55)"]}, {"lines": ["Reports not retrieved (n = 5)"]}, {"lines": ["Reports assessed for eligibility (n = 50)"]}, {"lines": ["Reports excluded:", "Not an RCT (n = 8)", "Wrong outcome (n = 12)", "Wrong population (n = 20)"]}, {"id": "other_identified", "lines": ["Records identified from:", "Citation searching (n = 10)", "Websites (n = 6)"]}, {"lines": ["Reports sought for retrieval (n = 16)"]}, {"lines": ["Reports not retrieved (n = 2)"]}, {"lines": ["Reports assessed for eligibility (n = 14)"]}, {"lines": ["Reports excluded:", "Wrong population (n = 9)"]}, {"id": "included", "stage": "Included", "lines": ["Studies included in review (n = 8)", "Reports of included studies (n = 15)"]}]}}},
  {"name": "Mermaid flowchart edges", "input": {"databases": {"MEDLINE": 120, "Embase": 85}, "registers": {"ClinicalTrials.gov": 15}, "duplicates_removed": 40, "automation_removed": 5, "other_removed": 0, "records_excluded": 120, "reports_not_retrieved": 5, "reports_excluded": {"Wrong population": 20, "Wrong outcome": 12, "Not an RCT": 8}, "studies_included": 8, "records_screened": 175, "other_methods": {"sources": {"Websites": 6, "Citation searching": 10}, "reports_not_retrieved": 2, "reports_excluded": {"Wrong population": 9}}}, "expect": {"stdout_contains": "  assessed --> included\\n  other_identified --> other_sought"}},
  {"name": "per-record decisions counted by hand: 7 records from databases/registers, 1 duplicate, 1 excluded, 1 not retrieved, 1 excluded for design, 3 reports of 2 studies plus 1 from citation searching", "input": {"records": [{"source": "MEDLINE", "screening": "include", "study": "S1"}, {"source": "MEDLINE", "screening": "include", "study": "S1"}, {"source": "MEDLINE", "screening": "exclude"}, {"source": "Embase", "removed": "duplicate"}, {"source": "Embase", "screening": "include", "retrieved": false}, {"source": "Embase", "screening": "include", "excluded_reason": "Wrong design"}, {"source": "CENTRAL", "via": "register", "screening": "include", "study": "S2"}, {"source": "Citation searching", "via": "other", "study": "S3"}, {"source": "Citation searching", "via": "other", "excluded_reason": "Wrong design"}]}, "expect": {"stdout_json": {"input_mode": "records", "consistent": true, "counts": {"identification": {"databases": 6, "databases_by_source": {"MEDLINE": 3, "Embase": 3}, "registers": 1, "duplicates_removed": 1}, "screening": {"records_screened": 6, "records_excluded": 1, "reports_sought": 5, "reports_not_retrieved": 1, "reports_assessed": 4, "reasons": {"Wrong design": 1}}, "other_methods": {"records_identified": 2, "reports_assessed": 2, "reports_excluded": 1, "reports_included": 1}, "included": {"studies_included": 3, "reports_included": 4}}}}},
  {"name": "inconsistent counts are reported, not hidden", "input": {"databases": 100, "duplicates_removed": 10, "records_excluded": 95, "records_screened": 80}, "expect": {"stdout_json": {"consistent": false, "checks": [{"check": "removed before screening <= identified", "ok": true}, {"check": "records excluded <= records screened", "ok": false, "detail": "95 excluded of 90 screened"}, {"check": "reports not retrieved <= reports sought", "ok": false}, {"check": "reports excluded <= reports assessed", "ok": false}, {"check": "records_screened given matches the flow", "ok": false, "detail": "given 80, computed 90"}]}}},
  {"name": "a single database total gets the per-database note; studies default to reports", "input": {"databases": 50, "records_excluded": 40, "reports_excluded": {"Wrong population": 6}}, "expect": {"stdout_json": {"counts": {"included": {"studies_included": 4, "reports_included": 4}}, "notes": ["studies_included not given: one report per study assumed", "PRISMA 2020 suggests reporting the records from each database separately, if feasible"]}}},
  {"name": "missing databases", "input": {"records_excluded": 3}, "expect": {"exit": 2, "stdout_contains": "databases is required"}},
  {"name": "negative count", "input": {"databases": 10, "records_excluded": -1}, "expect": {"exit": 2, "stdout_contains": "records_excluded must be a non-negative integer"}},
