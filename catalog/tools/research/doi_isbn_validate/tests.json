[
  {"name": "Wikipedia (ISBN article): ISBN-13 978-0-306-40615-7 is valid and is ISBN-10 0-306-40615-2", "input": {"value": "978-0-306-40615-7"}, "expect": {"stdout_json": {"type": "isbn", "format": "ISBN-13", "valid": true, "isbn13": "9780306406157", "isbn10": "0306406152"}}},
  {"name": "Wikipedia (ISBN article): ISBN-10 0-306-40615-2 converts to 978-0-306-40615-7", "input": {"value": "0-306-40615-2"}, "expect": {"stdout_json": {"format": "ISBN-10", "valid": true, "check_digit": "2", "isbn13": "9780306406157"}}},
  {"name": "a wrong ISBN-13 check digit names the expected one", "input": {"value": "978-0-306-40615-8"}, "expect": {"stdout_json": {"valid": false, "expected_check_digit": "7", "errors": ["check digit is 8, expected 7"]}}},
  {"name": "ISBN-10 with check digit X: 0-8044-2957-X (weighted sum 199, by hand), label stripped", "input": {"value": "ISBN 0-8044-2957-X"}, "expect": {"stdout_json": {"valid": true, "isbn10": "080442957X", "isbn13": "9780804429573"}}},
  {"name": "a 979 ISBN has no ISBN-10", "input": {"value": "979-10-90636-07-1"}, "expect": {"stdout_json": {"valid": true, "isbn10": null, "note": "979 ISBNs have no ISBN-10 form"}}},
  {"name": "Wikipedia (ISSN article): ISSN 0378-5955 (Hearing Research) is valid; EAN-13 977 0378595 00 2 by hand", "input": {"value": "ISSN 0378-5955"}, "expect": {"stdout_json": {"type": "issn", "valid": true, "issn": "0378-5955", "ean13": "9770378595002"}}},
  {"name": "ISSN with a wrong check digit", "input": {"value": "0378-5956", "type": "issn"}, "expect": {"stdout_json": {"valid": false, "expected_check_digit": "5"}}},
  {"name": "Wikipedia (ISMN article): check-digit example 979-0-060-11561-5 (sum 85, check 5) and the legacy form example M-2306-7118-7 = 979-0-2306-7118-7", "input": {"identifiers": ["979-0-060-11561-5", "M-2306-7118-7"]}, "expect": {"stdout_json": {"count": 2, "valid": 2, "results": [{"type": "ismn", "format": "ISMN-13", "check_digit": "5", "ismn10": "M060115615"}, {"type": "ismn", "format": "ISMN-10 (legacy M-)", "ismn13": "9790230671187"}]}}},
  {"name": "DOI Handbook's own DOI 10.1000/182, bare and as an encoded doi.org URL", "input": {"identifiers": ["10.1000/182", "https://doi.org/10.1000%2F182", "doi:10.1038/nphys1170"]}, "expect": {"stdout_json": {"valid": 3, "results": [{"type": "doi", "form": "bare", "prefix": "10.1000", "registrant": "1000", "suffix": "182", "url": "https://doi.org/10.1000/182", "crossref_pattern": true}, {"form": "url", "doi": "10.1000/182"}, {"form": "doi:", "doi": "10.1038/nphys1170"}]}}},
  {"name": "an old Wiley SICI DOI is valid syntax, encoded in the URL, and flagged outside the Crossref pattern", "input": {"value": "https://dx.doi.org/10.1002/(SICI)1097-4636(199706)35:4<473::AID-JBM8>3.0.CO;2-L"}, "expect": {"stdout_json": {"valid": true, "crossref_pattern": false, "url": "https://doi.org/10.1002/(SICI)1097-4636(199706)35:4%3C473::AID-JBM8%3E3.0.CO;2-L"}}},
  {"name": "DOI syntax errors", "input": {"identifiers": ["11.1000/x", "10.abc/x", "10.1000/"]}, "expect": {"stdout_json": {"valid": 0, "results": [{"valid": false, "errors": ["a DOI starts with the directory indicator 10."]}, {"valid": false}, {"valid": false}]}}},
  {"name": "neither value nor identifiers", "input": {"type": "isbn"}, "expect": {"exit": 2, "stdout_contains": "give value or identifiers"}},
  {"name": "bad type", "input": {"value": "x", "type": "upc"}, "expect": {"exit": 2, "stdout_contains": "type must be"}}
]
