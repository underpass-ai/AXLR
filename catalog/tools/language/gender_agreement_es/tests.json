[
  {"name": "RAE (DPD, 'el', 2.1): el agua fría — el before stressed a, the adjective stays feminine", "input": {"text": "el agua fría"},
   "expect": {"stdout_json": {"ok": true, "errors": 0, "phrases": [{"noun": "agua", "gender": "f", "number": "s", "issues": []}]}}},
  {"name": "RAE (DPD, 'el'): in the plural the feminine article returns: las aguas", "input": {"text": "las aguas"},
   "expect": {"stdout_json": {"ok": true, "phrases": [{"noun": "aguas", "gender": "f", "number": "p", "issues": []}]}}},
  {"name": "RAE (DPD, 'el'): la agua is wrong, el agua", "input": {"text": "la agua"},
   "expect": {"stdout_json": {"ok": false, "errors": 1, "phrases": [{"issues": [{"word": "la", "suggestion": "el", "severity": "error"}]}]}}},
  {"name": "RAE (DPD, 'el'): el agua frío is wrong, the adjective is feminine (fría)", "input": {"text": "el agua frío"},
   "expect": {"stdout_json": {"ok": false, "phrases": [{"issues": [{"word": "frío", "suggestion": "fría"}]}]}}},
  {"name": "RAE (DPD, 'este'): esta agua, not este agua", "input": {"text": "este agua"},
   "expect": {"stdout_json": {"ok": false, "phrases": [{"issues": [{"word": "este", "suggestion": "esta"}]}]}}},
  {"name": "RAE (DPD, 'hambre'): mucha hambre, not mucho hambre", "input": {"text": "mucho hambre"},
   "expect": {"stdout_json": {"ok": false, "phrases": [{"issues": [{"word": "mucho", "suggestion": "mucha"}]}]}}},
  {"name": "RAE (DPD, 'el'): with an adjective between, la fría agua; el fría agua is wrong", "input": {"text": "el fría agua"},
   "expect": {"stdout_json": {"ok": false, "phrases": [{"issues": [{"word": "el", "suggestion": "la"}]}]}}},
  {"name": "RAE (DPD, 'un'): un águila is the usual form, una águila is accepted (a note, not an error)", "input": {"text": "una águila"},
   "expect": {"stdout_json": {"ok": true, "notes": 1, "phrases": [{"issues": [{"word": "una", "suggestion": "un", "severity": "note"}]}]}}},
  {"name": "lexicon: el problema (Greek -ma), la mano, el día", "input": {"text": "el problema grave, la mano derecha, el día soleado"},
   "expect": {"stdout_json": {"ok": true, "phrases": [{"noun": "problema", "gender": "m"}, {"noun": "mano", "gender": "f"}, {"noun": "día", "gender": "m"}]}}},
  {"name": "lexicon: la problema and el mano are flagged", "input": {"text": "la problema y el mano"},
   "expect": {"stdout_json": {"errors": 2, "phrases": [{"issues": [{"word": "la", "suggestion": "el"}]}, {"issues": [{"word": "el", "suggestion": "la"}]}]}}},
  {"name": "number: los casa blanca", "input": {"text": "los casa blanca"},
   "expect": {"stdout_json": {"phrases": [{"number": "s", "issues": [{"word": "los", "suggestion": "el"}]}]}}},
  {"name": "common-gender noun takes the determiner's gender: el estudiante aplicada", "input": {"text": "el estudiante aplicada"},
   "expect": {"stdout_json": {"phrases": [{"gender": "m", "issues": [{"word": "aplicada", "suggestion": "aplicado"}]}]}}},
  {"name": "-or and -és adjectives: la señora trabajador, una mujer francés", "input": {"text": "la señora trabajador; una mujer francés"},
   "expect": {"stdout_json": {"errors": 2, "phrases": [{"issues": [{"suggestion": "trabajadora"}]}, {"issues": [{"suggestion": "francesa"}]}]}}},
  {"name": "invariable plural noun takes the determiner's number: las crisis económicas", "input": {"text": "las crisis económicas"},
   "expect": {"stdout_json": {"ok": true, "phrases": [{"number": "p", "issues": []}]}}},
  {"name": "predicate adjective after a copula: la casa es blanco", "input": {"text": "La casa es blanco."},
   "expect": {"stdout_json": {"ok": false, "phrases": [{"noun": "casa", "issues": []}, {"role": "predicate", "issues": [{"word": "blanco", "suggestion": "blanca"}]}]}}},
  {"name": "empty text", "input": {"text": " "}, "expect": {"exit": 2, "stdout_contains": "non-empty string"}},
  {"name": "unknown field", "input": {"text": "el agua", "lang": "es"}, "expect": {"exit": 2, "stdout_contains": "unknown field"}}
]
