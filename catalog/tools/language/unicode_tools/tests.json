[
  {"name": "UnicodeData.txt: U+00E9 decomposes to 0065 0301, so NFC of é is U+00E9 and NFD is U+0065 U+0301", "input": {"operation": "normalize", "text": "é"}, "expect": {"exit": 0, "stdout_json": {"input_codepoints": ["U+00E9"], "forms": {"NFC": {"codepoints": ["U+00E9"], "input_is_normalized": true}, "NFD": {"codepoints": ["U+0065", "U+0301"], "input_is_normalized": false}, "NFKC": {"codepoints": ["U+00E9"]}, "NFKD": {"codepoints": ["U+0065", "U+0301"]}}}}},
  {"name": "NFC recomposes e + combining acute", "input": {"operation": "normalize", "text": "é", "form": "NFC"}, "expect": {"exit": 0, "stdout_json": {"forms": {"NFC": {"text": "é", "codepoints": ["U+00E9"], "length": 1, "input_is_normalized": false}}}}},
  {"name": "UAX #15: the fi ligature U+FB01 is unchanged by NFC and becomes f i under NFKC", "input": {"operation": "normalize", "text": "ﬁ"}, "expect": {"exit": 0, "stdout_json": {"forms": {"NFC": {"codepoints": ["U+FB01"]}, "NFKC": {"codepoints": ["U+0066", "U+0069"]}}}}},
  {"name": "UnicodeData.txt names: LATIN SMALL LETTER E WITH ACUTE and COMBINING ACUTE ACCENT", "input": {"operation": "codepoints", "text": "éé"}, "expect": {"exit": 0, "stdout_json": {"length": 3, "codepoints": [{"codepoint": "U+00E9", "name": "LATIN SMALL LETTER E WITH ACUTE", "category": "Ll", "decomposition": "0065 0301", "utf_8_hex": "C3 A9"}, {"codepoint": "U+0065", "name": "LATIN SMALL LETTER E", "script": "Latin"}, {"codepoint": "U+0301", "name": "COMBINING ACUTE ACCENT", "category": "Mn", "combining_class": 230, "script": "Inherited"}]}}},
  {"name": "RFC 3629 section 7: U+0041 U+2262 U+0391 U+002E is 41 E2 89 A2 CE 91 2E in UTF-8", "input": {"operation": "bytes", "text": "A≢Α."}, "expect": {"exit": 0, "stdout_json": {"utf_8_hex": "41 E2 89 A2 CE 91 2E", "utf_8_length": 7, "codepoint_count": 4}}},
  {"name": "RFC 3629 section 7: Japanese nihongo U+65E5 U+672C U+8A9E is E6 97 A5 E6 9C AC E8 AA 9E", "input": {"operation": "bytes", "text": "日本語"}, "expect": {"exit": 0, "stdout_json": {"utf_8_hex": "E6 97 A5 E6 9C AC E8 AA 9E"}}},
  {"name": "RFC 2781 section 5: U+12345 followed by =Ra is D8 08 DF 45 00 3D 00 52 00 61 in UTF-16BE and 08 D8 45 DF 3D 00 52 00 61 00 in UTF-16LE", "input": {"operation": "bytes", "text": "𒍅=Ra"}, "expect": {"exit": 0, "stdout_json": {"utf_16_be_hex": "D8 08 DF 45 00 3D 00 52 00 61", "utf_16_le_hex": "08 D8 45 DF 3D 00 52 00 61 00", "utf_16_code_units": 5, "codepoint_count": 4}}},
  {"name": "RFC 3629 section 7: EF BB BF F0 A3 8E B4 decodes to a BOM and U+233B4", "input": {"operation": "decode", "hex": "EF BB BF F0 A3 8E B4"}, "expect": {"exit": 0, "stdout_json": {"codepoints": [{"codepoint": "U+FEFF", "name": "ZERO WIDTH NO-BREAK SPACE"}, {"codepoint": "U+233B4", "category": "Lo"}]}}},
  {"name": "strip accents keeps letters that do not decompose", "input": {"operation": "strip_accents", "text": "Ångström, señor, Łódź, straße"}, "expect": {"exit": 0, "stdout_json": {"text": "Angstrom, senor, Łodz, straße", "marks_removed": 5, "non_ascii_letters_left": ["ß", "Ł"]}}},
  {"name": "confusables.txt line 0430 ; 0061 (CYRILLIC SMALL LETTER A -> LATIN SMALL LETTER A): a Cyrillic a inside paypal is a mixed-script word", "input": {"operation": "confusables", "text": "pаypal.com"}, "expect": {"exit": 0, "stdout_json": {"verdict": "suspicious", "mixed_script_words": 1, "suspicious_words": [{"word": "pаypal", "scripts": ["Latin", "Cyrillic"], "mixed_script": true, "lookalikes": [{"codepoint": "U+0430", "name": "CYRILLIC SMALL LETTER A", "looks_like": "a", "looks_like_codepoint": "U+0061"}], "latin_skeleton": "paypal"}]}}},
  {"name": "confusables.txt 0441 ; 0063 and 043E ; 006F: Cyrillic сосо looks wholly Latin (coco)", "input": {"operation": "confusables", "text": "сосо"}, "expect": {"exit": 0, "stdout_json": {"whole_script_lookalike_words": 1, "suspicious_words": [{"scripts": ["Cyrillic"], "mixed_script": false, "all_letters_look_latin": true, "latin_skeleton": "coco"}]}}},
  {"name": "ordinary Russian and English words are not flagged", "input": {"operation": "confusables", "text": "Москва and Paris"}, "expect": {"exit": 0, "stdout_json": {"suspicious_count": 0, "suspicious_words": []}}},
  {"name": "the Unicode version is reported", "input": {"operation": "codepoints", "text": "a"}, "expect": {"exit": 0, "stdout_contains": "\"unidata_version\": \""}},
  {"name": "invalid UTF-8", "input": {"operation": "decode", "hex": "FF"}, "expect": {"exit": 2, "stdout_contains": "not valid utf-8"}},
  {"name": "bad operation", "input": {"operation": "upper", "text": "a"}, "expect": {"exit": 2, "stdout_contains": "operation must be one of"}},
  {"name": "bad form", "input": {"operation": "normalize", "text": "a", "form": "NFX"}, "expect": {"exit": 2, "stdout_contains": "form must be"}}
]
