[
  {"name": "RAE model amar (Nueva gramática, conjugation models; DLE): presente, pretérito perfecto simple, imperfecto de subjuntivo",
   "input": {"verb": "amar", "compound": false},
   "expect": {"stdout_json": {"model": "amar (regular -ar)", "irregular": false, "gerundio": "amando", "participio": "amado",
     "indicativo": {"presente": {"yo": "amo", "tú": "amas", "él": "ama", "nosotros": "amamos", "vosotros": "amáis", "ellos": "aman"},
       "preterito_imperfecto": {"yo": "amaba", "nosotros": "amábamos"},
       "preterito_perfecto_simple": {"yo": "amé", "tú": "amaste", "él": "amó", "nosotros": "amamos", "vosotros": "amasteis", "ellos": "amaron"},
       "futuro_simple": {"yo": "amaré", "vosotros": "amaréis"}, "condicional_simple": {"nosotros": "amaríamos"}},
     "subjuntivo": {"presente": {"yo": "ame", "vosotros": "améis"},
       "preterito_imperfecto_ra": {"yo": "amara", "nosotros": "amáramos"}, "preterito_imperfecto_se": {"yo": "amase", "nosotros": "amásemos"},
       "futuro_simple": {"yo": "amare", "nosotros": "amáremos"}},
     "imperativo": {"afirmativo": {"tú": "ama", "vosotros": "amad"}}}}},
  {"name": "RAE model temer: presente and pretérito perfecto simple",
