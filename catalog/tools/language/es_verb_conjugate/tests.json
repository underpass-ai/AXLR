     "indicativo": {"presente": {"yo": "temo", "tú": "temes", "él": "teme", "nosotros": "tememos", "vosotros": "teméis", "ellos": "temen"},
       "preterito_imperfecto": {"yo": "temía"},
       "preterito_perfecto_simple": {"yo": "temí", "tú": "temiste", "él": "temió", "nosotros": "temimos", "vosotros": "temisteis", "ellos": "temieron"}},
     "subjuntivo": {"presente": {"yo": "tema", "ellos": "teman"}, "preterito_imperfecto_ra": {"nosotros": "temiéramos"}}}}},
  {"name": "RAE model partir: presente, subjuntivo and compound tenses with haber",
   "input": {"verb": "partir"},
   "expect": {"stdout_json": {"gerundio": "partiendo", "participio": "partido", "infinitivo_compuesto": "haber partido",
     "indicativo": {"presente": {"yo": "parto", "tú": "partes", "él": "parte", "nosotros": "partimos", "vosotros": "partís", "ellos": "parten"},
       "preterito_perfecto_compuesto": {"yo": "he partido", "vosotros": "habéis partido"},
       "preterito_pluscuamperfecto": {"él": "había partido"}, "preterito_anterior": {"yo": "hube partido"},
       "futuro_compuesto": {"ellos": "habrán partido"}, "condicional_compuesto": {"nosotros": "habríamos partido"}},
     "subjuntivo": {"presente": {"yo": "parta", "tú": "partas", "él": "parta", "nosotros": "partamos", "vosotros": "partáis", "ellos": "partan"},
       "preterito_perfecto_compuesto": {"yo": "haya partido"}, "preterito_pluscuamperfecto_ra": {"nosotros": "hubiéramos partido"},
       "preterito_pluscuamperfecto_se": {"yo": "hubiese partido"}, "futuro_compuesto": {"yo": "hubiere partido"}},
     "imperativo": {"afirmativo": {"tú": "parte", "vosotros": "partid"}, "negativo": {"tú": "no partas"}}}}},
  {"name": "RAE paradigm ser, with voseo sos",
