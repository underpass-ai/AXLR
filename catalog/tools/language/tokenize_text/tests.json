[
  {"name": "hand-checked tokens and offsets: abbreviation, currency, URL with trailing period, ellipsis before lowercase",
   "input": {"text": "Dr. Smith paid $3.50 at https://example.com/a?b=1. He left... then came back!", "top": 0},
   "expect": {"stdout_json": {"counts": {"tokens": 16, "words": 9, "numbers": 1, "urls": 1, "symbols": 1, "sentences": 2},
     "tokens": [{"text": "Dr", "type": "word", "start": 0, "end": 2}, {"text": ".", "type": "punctuation", "start": 2, "end": 3},
       {"text": "Smith", "type": "word", "start": 4, "end": 9}, {"text": "paid", "type": "word", "start": 10, "end": 14},
       {"text": "$", "type": "symbol", "start": 15, "end": 16}, {"text": "3.50", "type": "number", "start": 16, "end": 20},
       {"text": "at", "type": "word", "start": 21, "end": 23}, {"text": "https://example.com/a?b=1", "type": "url", "start": 24, "end": 49},
       {"text": ".", "type": "punctuation", "start": 49, "end": 50}, {"text": "He", "type": "word", "start": 51, "end": 53},
       {"text": "left", "type": "word", "start": 54, "end": 58}, {"text": "...", "type": "punctuation", "start": 58, "end": 61},
       {"text": "then", "type": "word", "start": 62, "end": 66}, {"text": "came", "type": "word", "start": 67, "end": 71},
       {"text": "back", "type": "word", "start": 72, "end": 76}, {"text": "!", "type": "punctuation", "start": 76, "end": 77}],
     "sentences": [{"text": "Dr. Smith paid $3.50 at https://example.com/a?b=1.", "start": 0, "end": 50}, {"text": "He left... then came back!", "start": 51, "end": 77}]}}},
  {"name": "Spanish: Sr. does not end a sentence, etc. before ¿ does; ¿…? and ¡…! are sentences",
   "input": {"text": "El Sr. García llegó el 3 de mayo, etc. ¿Vienes? ¡Claro!", "language": "es", "tokens": false, "top": 0},
   "expect": {"stdout_json": {"sentences": [{"text": "El Sr. García llegó el 3 de mayo, etc.", "start": 0, "end": 38}, {"text": "¿Vienes?", "start": 39, "end": 47}, {"text": "¡Claro!", "start": 48, "end": 55}]}}},
  {"name": "German: ordinal 3. and spaced z. B. are not sentence ends",
   "input": {"text": "Am 3. Oktober feiert man z. B. die Einheit. Das ist z.B. gut.", "language": "de", "tokens": false, "top": 0},
   "expect": {"stdout_json": {"counts": {"sentences": 2}, "sentences": [{"text": "Am 3. Oktober feiert man z. B. die Einheit.", "start": 0, "end": 43}, {"text": "Das ist z.B. gut.", "start": 44, "end": 61}]}}},
  {"name": "initials, closing quote and bracket stay with their sentence",
   "input": {"text": "He said \"Stop.\" Then he left. J. R. R. Tolkien wrote it in 1937. (It sold well.) Yes.", "tokens": false, "top": 0},
   "expect": {"stdout_json": {"sentences": [{"text": "He said \"Stop.\"", "start": 0, "end": 15}, {"text": "Then he left.", "start": 16, "end": 29}, {"text": "J. R. R. Tolkien wrote it in 1937.", "start": 30, "end": 64}, {"text": "(It sold well.)", "start": 65, "end": 80}, {"text": "Yes.", "start": 81, "end": 85}]}}},
  {"name": "Japanese: one token per kanji or kana, 。 ends a sentence without a space",
   "input": {"text": "東京は日本の首都です。人口は多い。", "tokens": false, "top": 0},
   "expect": {"stdout_json": {"counts": {"cjk": 15, "punctuation": 2, "sentences": 2}, "sentences": [{"text": "東京は日本の首都です。", "start": 0, "end": 11}, {"text": "人口は多い。", "start": 11, "end": 17}]}}},
  {"name": "apostrophes, hyphens, e-mail and frequencies",
   "input": {"text": "L'homme well-known COVID-19 mail j.doe@example.org, l'homme!", "language": "fr", "sentences": false, "top": 1},
   "expect": {"stdout_json": {"counts": {"words": 5, "emails": 1, "unique_words": 4}, "top_words": [{"word": "l'homme", "count": 2}],
     "tokens": [{"text": "L'homme", "type": "word", "start": 0, "end": 7}, {"text": "well-known", "type": "word", "start": 8, "end": 18},
       {"text": "COVID-19", "type": "word", "start": 19, "end": 27}, {"text": "mail", "type": "word", "start": 28, "end": 32},
       {"text": "j.doe@example.org", "type": "email", "start": 33, "end": 50}, {"text": ",", "type": "punctuation", "start": 50, "end": 51},
       {"text": "l'homme", "type": "word", "start": 52, "end": 59}, {"text": "!", "type": "punctuation", "start": 59, "end": 60}]}}},
  {"name": "a blank line ends a sentence without punctuation",
   "input": {"text": "First line\n\nSecond line", "tokens": false, "top": 0},
   "expect": {"stdout_json": {"counts": {"sentences": 2, "paragraphs": 2}}}},
  {"name": "unsupported language", "input": {"text": "Ciao.", "language": "it"}, "expect": {"exit": 2, "stdout_contains": "language must be"}},
  {"name": "text must be a string", "input": {"text": 5}, "expect": {"exit": 2, "stdout_contains": "text must be a string"}}
]
