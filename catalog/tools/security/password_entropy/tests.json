[
  {"name": "pool-entropy formula (NIST SP 800-63 v1 appendix A, H = L log2 N): 12 random lowercase letters = 12 x log2 26 = 56.4 bits", "input": {"password": "kxqbvtmzrwpj"}, "expect": {"exit": 0, "stdout_json": {"length": 12, "pool_size": 26, "pool_entropy_bits": 56.41, "estimated_entropy_bits": 56.41, "patterns": [], "character_classes": {"lowercase": true, "uppercase": false, "digits": false, "symbols": false}}}},
  {"name": "pool-entropy formula: 8 characters from the 94 printable ASCII without space = 8 x log2 94 = 52.44 bits", "input": {"password": "zQ8#mK2!"}, "expect": {"exit": 0, "stdout_json": {"pool_size": 94, "pool_entropy_bits": 52.44, "bits_per_character": 6.5546}}},
  {"name": "pool-entropy formula: 10 digits = 33.22 bits; a descending sequence 9-0 is charged 9.49 bits", "input": {"password": "9876543210"}, "expect": {"exit": 0, "stdout_json": {"pool_size": 10, "pool_entropy_bits": 33.22, "patterns": [{"type": "sequence", "start": 0, "length": 10}], "rating": "very weak"}}},
  {"name": "the most common password in the SecLists list (rank 1) is about 1 bit and flagged by the blocklist rule", "input": {"password": "password"}, "expect": {"exit": 0, "stdout_json": {"whole_password_is_common": true, "estimated_entropy_bits": 1.0, "rating": "very weak", "patterns": [{"type": "common_password", "start": 0, "length": 8}]}}},
  {"name": "l33t substitutions of a common password are undone", "input": {"password": "P@ssw0rd"}, "expect": {"exit": 0, "stdout_json": {"patterns": [{"type": "common_password_l33t", "start": 0, "length": 8}], "rating": "very weak"}}},
  {"name": "keyboard run and repeated character", "input": {"password": "rtyuio!!!!"}, "expect": {"exit": 0, "stdout_json": {"patterns": [{"type": "keyboard_run", "start": 0, "length": 6}, {"type": "repeated_character", "start": 6, "length": 4}]}}},
  {"name": "a date with separators", "input": {"password": "25/12/1990x"}, "expect": {"exit": 0, "stdout_json": {"patterns": [{"type": "date", "start": 0, "length": 10}]}}},
  {"name": "context word from the e-mail and a year", "input": {"password": "maria1985", "context": ["maria@example.com"]}, "expect": {"exit": 0, "stdout_json": {"patterns": [{"type": "context_word", "start": 0, "length": 5}, {"type": "year", "start": 5, "length": 4}]}}},
  {"name": "crack time: 56.41 bits at 10^10 guesses per second is 2^55.41 / 10^10 s = about 4.77e6 s (1 month); at 10^12 it is 13.3 hours", "input": {"password": "kxqbvtmzrwpj", "guesses_per_second": {"my_rig": 1000000000000}}, "expect": {"exit": 0, "stdout_json": {"crack_time": {"offline_fast_hash": {"display": "1 month"}, "my_rig": {"guesses_per_second": 1000000000000.0, "display": "13 hours"}}}}},
  {"name": "crack time in seconds: 2^55.405 / 10^10 = 4.771e6", "input": {"password": "kxqbvtmzrwpj"}, "expect": {"exit": 0, "stdout_contains": "\"seconds\": 4771000.0"}},
  {"name": "a short password gets the SP 800-63B length advice", "input": {"password": "zQ8#"}, "expect": {"exit": 0, "stdout_contains": "at least 8 characters"}},
  {"name": "empty password", "input": {"password": ""}, "expect": {"exit": 2, "stdout_contains": "password is empty"}},
  {"name": "password missing", "input": {"context": []}, "expect": {"exit": 2, "stdout_contains": "password is required"}},
  {"name": "bad guess rate", "input": {"password": "abc", "guesses_per_second": {"x": -1}}, "expect": {"exit": 2, "stdout_contains": "positive number"}}
]
