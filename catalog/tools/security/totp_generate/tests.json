[
  {"name": "RFC 6238 Appendix B: SHA-1, T = 59 s gives 94287082 (8 digits, secret 12345678901234567890)", "input": {"secret": "12345678901234567890", "secret_encoding": "ascii", "time": 59, "digits": 8}, "expect": {"exit": 0, "stdout_json": {"code": "94287082", "counter": 1, "counter_hex": "0000000000000001", "key_bytes": 20}}},
  {"name": "RFC 6238 Appendix B: SHA-256, T = 1111111109 gives 68084774 (32-byte seed)", "input": {"secret": "12345678901234567890123456789012", "secret_encoding": "ascii", "time": 1111111109, "algorithm": "SHA256", "digits": 8}, "expect": {"exit": 0, "stdout_json": {"code": "68084774", "counter_hex": "00000000023523EC"}}},
  {"name": "RFC 6238 Appendix B: SHA-512, 2033-05-18T03:33:20Z (T = 2000000000) gives 38618901 (64-byte seed, as hex)", "input": {"secret": "31323334353637383930313233343536373839303132333435363738393031323334353637383930313233343536373839303132333435363738393031323334", "secret_encoding": "hex", "time": "2033-05-18T03:33:20Z", "algorithm": "SHA512", "digits": 8}, "expect": {"exit": 0, "stdout_json": {"code": "38618901", "time": 2000000000, "counter_hex": "0000000003F940AA"}}},
  {"name": "RFC 6238 Appendix B: SHA-1, T = 20000000000 (year 2603) gives 65353130", "input": {"secret": "12345678901234567890", "secret_encoding": "ascii", "time": 20000000000, "digits": 8}, "expect": {"exit": 0, "stdout_json": {"code": "65353130", "counter_hex": "0000000027BC86AA"}}},
  {"name": "RFC 4226 Appendix D: HOTP counter 0 gives 755224 (base32 GEZDGNBVGY3TQOJQ... is 12345678901234567890)", "input": {"secret": "GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ", "mode": "hotp", "counter": 0}, "expect": {"exit": 0, "stdout_json": {"code": "755224", "key_bytes": 20}}},
  {"name": "RFC 4226 Appendix D: HOTP counter 9 gives 520489 (lower-case base32 with spaces)", "input": {"secret": "gezd gnbv gy3t qojq gezd gnbv gy3t qojq", "mode": "hotp", "counter": 9}, "expect": {"exit": 0, "stdout_json": {"code": "520489"}}},
  {"name": "verify: RFC 4226 counter 3 code 969429 accepted at offset +1 from counter 2", "input": {"secret": "3132333435363738393031323334353637383930", "secret_encoding": "hex", "mode": "hotp", "counter": 2, "code": "969429", "window": 1}, "expect": {"exit": 0, "stdout_json": {"code": "359152", "verify": {"valid": true, "matched_offset": 1, "matched_counter": 3}}}},
  {"name": "verify TOTP: the 6-digit RFC 6238 code of T = 59 (287082) accepted 30 s later with window 1, rejected with window 0", "input": {"secret": "GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ", "time": 89, "code": "287082", "window": 1}, "expect": {"exit": 0, "stdout_json": {"counter": 2, "seconds_remaining": 1, "verify": {"valid": true, "matched_offset": -1}}}},
  {"name": "verify with window 0 rejects the previous step", "input": {"secret": "GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ", "time": 89, "code": "287082", "window": 0}, "expect": {"exit": 0, "stdout_json": {"verify": {"valid": false, "matched_offset": null}}}},
  {"name": "T = 0: first step, valid until 00:00:30 UTC", "input": {"secret": "JBSWY3DPEHPK3PXP", "time": 0}, "expect": {"exit": 0, "stdout_json": {"counter": 0, "valid_until_utc": "1970-01-01T00:00:30Z"}}},
  {"name": "time is required", "input": {"secret": "JBSWY3DPEHPK3PXP"}, "expect": {"exit": 2, "stdout_contains": "time is required"}},
  {"name": "bad base32", "input": {"secret": "JBSWY3DP1", "time": 0}, "expect": {"exit": 2, "stdout_contains": "not valid base32"}},
  {"name": "digits out of range", "input": {"secret": "JBSWY3DPEHPK3PXP", "time": 0, "digits": 9}, "expect": {"exit": 2, "stdout_contains": "digits must be between 6 and 8"}},
  {"name": "unknown algorithm", "input": {"secret": "JBSWY3DPEHPK3PXP", "time": 0, "algorithm": "MD5"}, "expect": {"exit": 2, "stdout_contains": "algorithm must be"}}
