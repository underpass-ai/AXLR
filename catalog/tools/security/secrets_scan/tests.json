[
  {"name": "AWS documentation example credentials (AKIAIOSFODNN7EXAMPLE, wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY from the AWS CLI configuration docs) are found and redacted to 4 characters", "input": {"text": "[default]\naws_access_key_id = AKIAIOSFODNN7EXAMPLE\naws_secret_access_key = wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY\n"}, "expect": {"exit": 0, "stdout_json": {"count": 2, "findings": [{"rule": "aws-access-token", "line": 2, "column": 21, "secret_redacted": "AKIA************ (20 chars)", "looks_like_placeholder": true}, {"rule": "aws-secret-access-key", "line": 3, "column": 25, "secret_redacted": "wJal************ (40 chars)", "length": 40}]}}},
  {"name": "Shannon entropy of AKIAIOSFODNN7EXAMPLE worked by hand: 20 characters, A x3, I x2, O x2, N x2, E x2, nine singletons = 3.684 bits per character", "input": {"text": "key AKIAIOSFODNN7EXAMPLE"}, "expect": {"exit": 0, "stdout_json": {"findings": [{"rule": "aws-access-token", "entropy": 3.684}]}}},
  {"name": "include_examples false drops the AWS documentation placeholders", "input": {"text": "[default]\naws_access_key_id = AKIAIOSFODNN7EXAMPLE\naws_secret_access_key = wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY\n", "include_examples": false}, "expect": {"exit": 0, "stdout_json": {"count": 0, "skipped": {"placeholders": 2}}}},
  {"name": "visibly fake GitHub classic token (ghp_ + A-Z0-9), Slack bot token and generic api_key in an inline file", "input": {"files": {"app.env": "GITHUB_TOKEN=ghp_ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\nSLACK=\u0078oxb-1234567890-1234567890123-FAKEfakeFAKEfake\napi_key: \"FAKE1234abcdEFGH5678ijkl\"\n"}}, "expect": {"exit": 0, "stdout_json": {"by_rule": {"github-pat": 1, "slack-bot-token": 1, "generic-api-key": 1}, "findings": [{"rule": "github-pat", "source": "app.env", "line": 1, "secret_redacted": "ghp_************ (40 chars)"}, {"rule": "slack-bot-token", "line": 2}, {"rule": "generic-api-key", "line": 3, "column": 11}]}}},
  {"name": "generic rule: a low-entropy password value (2.81 bits per character) stays under the 3.5 threshold, lowered to 2.5 it is reported", "input": {"files": {"a": "password = hunter2hunter2\n"}, "entropy_threshold": 2.5}, "expect": {"exit": 0, "stdout_json": {"findings": [{"rule": "generic-api-key", "entropy": 2.807}]}}},
  {"name": "the same value with the default threshold is not reported", "input": {"text": "password = hunter2hunter2\n"}, "expect": {"exit": 0, "stdout_json": {"count": 0}}},
  {"name": "private key PEM header (header line only, no key material)", "input": {"text": "x\n-----BEGIN OPENSSH PRIVATE KEY-----\n"}, "expect": {"exit": 0, "stdout_json": {"findings": [{"rule": "private-key", "line": 2, "column": 1, "secret_redacted": "----************ (35 chars)"}]}}},
  {"name": "the RFC 7519 section 3.1 example JWT is found by the jwt rule", "input": {"text": "Authorization: Bearer eyJ0eXAiOiJKV1QiLA0KICJhbGciOiJIUzI1NiJ9.eyJpc3MiOiJqb2UiLA0KICJleHAiOjEzMDA4MTkzODAsDQogImh0dHA6Ly9leGFtcGxlLmNvbS9pc19yb290Ijp0cnVlfQ.dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk"}, "expect": {"exit": 0, "stdout_json": {"findings": [{"rule": "jwt", "column": 23, "length": 179}]}}},
  {"name": "plain configuration is clean", "input": {"text": "name = some_value_here\nport: 8080\nversion = 1.2.3\n"}, "expect": {"exit": 0, "stdout_json": {"count": 0, "findings": []}}},
  {"name": "a relative path in the working directory is read (the tool's own source has no secrets)", "input": {"paths": ["secrets_scan.py"]}, "expect": {"exit": 0, "stdout_json": {"sources_scanned": ["secrets_scan.py"], "count": 0}}},
  {"name": "paths with .. are refused", "input": {"paths": ["../x"]}, "expect": {"exit": 2, "stdout_contains": "must not contain"}},
  {"name": "absolute paths are refused", "input": {"paths": ["/tmp/x"]}, "expect": {"exit": 2, "stdout_contains": "relative paths"}},
  {"name": "nothing to scan", "input": {}, "expect": {"exit": 2, "stdout_contains": "give text, files or paths"}},
  {"name": "unknown rule id", "input": {"text": "x", "rules": ["nope"]}, "expect": {"exit": 2, "stdout_contains": "rules must be"}}
]
