[
  {"name": "CycloneDX specification test resource valid-minimal-viable-1.5.json (bomFormat, specVersion, serialNumber, version, one library) is valid: one component, no version, no purl, no licence", "input": {"sbom": {"bomFormat": "CycloneDX", "specVersion": "1.5", "serialNumber": "urn:uuid:3e671687-395b-41f5-a30f-a58921a69b79", "version": 1, "components": [{"type": "library", "name": "acme-library"}]}}, "expect": {"exit": 0, "stdout_json": {"format": "CycloneDX", "spec_version": "1.5", "valid": true, "errors": [], "components": {"count": 1, "without_version": {"count": 1, "names": ["acme-library"]}, "without_purl": {"count": 1}, "without_license": {"count": 1}}}}},
  {"name": "CycloneDX 1.4 schema: bomFormat and specVersion are the only required properties", "input": {"sbom_text": "{\"bomFormat\": \"CycloneDX\", \"specVersion\": \"1.4\"}"}, "expect": {"exit": 0, "stdout_json": {"valid": true, "spec_version": "1.4", "components": {"count": 0}}}},
  {"name": "SPDX 2.3 minimal document with every field clauses 6 and 7 require (hand-built): valid, licence Zlib counted, NTIA elements present", "input": {"sbom": {"spdxVersion": "SPDX-2.3", "dataLicense": "CC0-1.0", "SPDXID": "SPDXRef-DOCUMENT", "name": "minimal", "documentNamespace": "https://example.com/spdx/minimal-1", "creationInfo": {"created": "2026-10-18T10:00:00Z", "creators": ["Tool: hand"]}, "packages": [{"name": "zlib", "SPDXID": "SPDXRef-zlib", "versionInfo": "1.3.1", "downloadLocation": "https://zlib.net/zlib-1.3.1.tar.gz", "filesAnalyzed": false, "licenseConcluded": "Zlib", "licenseDeclared": "Zlib", "supplier": "Organization: zlib", "externalRefs": [{"referenceCategory": "PACKAGE-MANAGER", "referenceType": "purl", "referenceLocator": "pkg:generic/zlib@1.3.1"}]}], "relationships": [{"spdxElementId": "SPDXRef-DOCUMENT", "relationshipType": "DESCRIBES", "relatedSpdxElement": "SPDXRef-zlib"}]}}, "expect": {"exit": 0, "stdout_json": {"format": "SPDX", "spec_version": "2.3", "valid": true, "errors": [], "describes": ["SPDXRef-zlib"], "licenses": {"spdx_ids": {"Zlib": 2}}, "components": {"count": 1, "without_version": {"count": 0}, "without_purl": {"count": 0}}, "ntia_minimum_elements": {"supplier_name": true, "version": true, "unique_identifiers": true, "timestamp": true}}}},
  {"name": "the same document as SPDX 2.2 lacks the package copyrightText that 2.2 makes mandatory (clause 7.17)", "input": {"sbom": {"spdxVersion": "SPDX-2.2", "dataLicense": "CC0-1.0", "SPDXID": "SPDXRef-DOCUMENT", "name": "minimal", "documentNamespace": "https://example.com/spdx/minimal-1", "creationInfo": {"created": "2026-10-18T10:00:00Z", "creators": ["Tool: hand"]}, "packages": [{"name": "zlib", "SPDXID": "SPDXRef-zlib", "versionInfo": "1.3.1", "downloadLocation": "https://zlib.net/zlib-1.3.1.tar.gz", "filesAnalyzed": false, "licenseConcluded": "Zlib", "licenseDeclared": "Zlib", "supplier": "Organization: zlib", "externalRefs": [{"referenceCategory": "PACKAGE-MANAGER", "referenceType": "purl", "referenceLocator": "pkg:generic/zlib@1.3.1"}]}], "relationships": [{"spdxElementId": "SPDXRef-DOCUMENT", "relationshipType": "DESCRIBES", "relatedSpdxElement": "SPDXRef-zlib"}]}}, "expect": {"exit": 0, "stdout_json": {"valid": false, "errors": [{"path": "/packages/0/copyrightText"}]}}},
  {"name": "SPDX errors: dataLicense, document SPDXID, namespace, creationInfo, downloadLocation, verification code, duplicate SPDXID, bad expression, no DESCRIBES", "input": {"sbom": {"spdxVersion": "SPDX-2.3", "dataLicense": "CC-BY-4.0", "SPDXID": "SPDXRef-DOC", "name": "x", "packages": [{"name": "a", "SPDXID": "SPDXRef-a", "licenseConcluded": "NOASSERTION"}, {"name": "b", "SPDXID": "SPDXRef-a", "downloadLocation": "NONE", "filesAnalyzed": false, "licenseDeclared": "LicenseRef-undefined OR"}]}}, "expect": {"exit": 0, "stdout_json": {"valid": false, "error_count": 10, "licenses": {"noassertion": 1}}}},
  {"name": "CycloneDX 1.6: licence summary (ids, expression with an exception, free-text name, deprecated GPL-2.0, unknown id), duplicates and a dangling dependency", "input": {"sbom": {"bomFormat": "CycloneDX", "specVersion": "1.6", "serialNumber": "urn:uuid:3e671687-395b-41f5-a30f-a58921a69b79", "version": 1, "metadata": {"timestamp": "2026-10-18T10:00:00Z", "tools": {"components": [{"type": "application", "name": "hand"}]}, "component": {"type": "application", "name": "shop", "version": "2.0.0", "bom-ref": "shop"}}, "components": [{"type": "library", "name": "lodash", "version": "4.17.21", "purl": "pkg:npm/lodash@4.17.21", "bom-ref": "lodash", "supplier": {"name": "OpenJS"}, "licenses": [{"license": {"id": "MIT"}}]}, {"type": "library", "name": "left-pad", "purl": "pkg:npm/left-pad", "bom-ref": "left-pad", "licenses": [{"license": {"name": "WTFPL-ish custom"}}]}, {"type": "library", "name": "lodash", "version": "4.17.21", "bom-ref": "lodash-copy", "licenses": [{"expression": "(MIT OR Apache-2.0) AND GPL-2.0-or-later WITH Classpath-exception-2.0"}]}, {"type": "library", "name": "oldlib", "version": "1.0", "bom-ref": "oldlib", "licenses": [{"license": {"id": "GPL-2.0"}}]}, {"type": "library", "name": "weird", "version": "0.1", "licenses": [{"license": {"id": "Not-A-Licence"}}]}], "dependencies": [{"ref": "shop", "dependsOn": ["lodash", "left-pad", "ghost"]}]}}, "expect": {"exit": 0, "stdout_json": {"valid": false, "describes": "shop", "licenses": {"spdx_ids": {"MIT": 2, "Apache-2.0": 1, "GPL-2.0": 1, "GPL-2.0-or-later": 1}, "exceptions": {"Classpath-exception-2.0": 1}, "names_not_spdx": {"WTFPL-ish custom": 1}, "deprecated_ids": {"GPL-2.0": 1}, "unknown_ids": {"Not-A-Licence": 1}, "expressions": 1}, "components": {"count": 5, "without_version": {"count": 1, "names": ["left-pad"]}, "duplicates": [{"name": "lodash", "version": "4.17.21", "paths": ["/components/0", "/components/2"]}]}, "errors": [{"path": "/components/4/licenses/0/license/id"}, {"path": "/dependencies/0", "message": "'ghost' is not the bom-ref of any component"}]}}},
  {"name": "CycloneDX: missing type and name, bad serial, unknown component type for 1.4", "input": {"sbom": {"bomFormat": "CycloneDX", "specVersion": "1.4", "serialNumber": "123", "components": [{"type": "data", "name": "x"}, {}]}}, "expect": {"exit": 0, "stdout_json": {"valid": false, "error_count": 4}}},
  {"name": "not an SBOM", "input": {"sbom": {"hello": "world"}}, "expect": {"exit": 2, "stdout_contains": "not a CycloneDX"}},
  {"name": "invalid JSON text", "input": {"sbom_text": "{nope"}, "expect": {"exit": 2, "stdout_contains": "not valid JSON"}},
  {"name": "two inputs", "input": {"sbom": {}, "sbom_text": "{}"}, "expect": {"exit": 2, "stdout_contains": "exactly one"}},
  {"name": "path outside the working directory", "input": {"path": "../sbom.json"}, "expect": {"exit": 2, "stdout_contains": "relative path"}}
]
