{
  "name": "rounding_report",
  "description": "Round numbers correctly and report measurements: significant figures or decimal places in seven modes (half up, half even, half down, up, down, ceiling, floor) with scientific and engineering notation, all done in Decimal; and first-order propagation of independent uncertainties through sums, products, quotients and powers, with the result rounded to the uncertainty's significant figures (9.81 +- 0.0234 becomes 9.81 +- 0.02).",
  "input_schema": {
    "type": "object",
    "required": ["operation"],
    "additionalProperties": false,
    "properties": {
      "operation": {"type": "string", "enum": ["round", "report", "propagate"]},
      "value": {"type": ["number", "string"], "description": "round, report"},
      "sig_figs": {"type": "integer", "minimum": 1, "maximum": 50},
      "decimals": {"type": "integer", "minimum": -50, "maximum": 50, "description": "Decimal places; negative rounds to tens, hundreds..."},
      "mode": {"type": "string", "enum": ["half_up", "half_even", "half_down", "up", "down", "ceiling", "floor"], "default": "half_even"},
      "uncertainty": {"type": ["number", "string"], "description": "report: standard uncertainty"},
      "kind": {"type": "string", "enum": ["sum", "product", "quotient", "power"], "description": "propagate"},
      "terms": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["value"], "additionalProperties": false, "properties": {
        "name": {"type": "string"}, "value": {"type": ["number", "string"]}, "uncertainty": {"type": ["number", "string"], "default": 0},
        "coefficient": {"type": ["number", "string"], "default": 1, "description": "sum"}, "power": {"type": ["number", "string"], "default": 1, "description": "product, power"}}}},
      "constant": {"type": ["number", "string"], "default": 1, "description": "Exact factor of a product"},
      "uncertainty_sig_figs": {"type": "integer", "enum": [1, 2], "default": 1}
    }
  },
  "program": "python3",
  "args": ["rounding_report.py"],
  "files": ["rounding_report.py"],
  "catalog": {
    "version": "1.0.0",
    "category": "mathematics",
    "tags": ["rounding", "significant-figures", "uncertainty", "error-propagation", "measurement", "decimal"],
    "license": "MIT",
    "requires": {"program_min_version": "3.10", "packages": []},
    "network": false,
    "example": {"input": {"operation": "report", "value": "9.81", "uncertainty": "0.0234"}, "output": {"reported_value": "9.81", "reported_uncertainty": "0.02"}},
    "source": "Python decimal rounding modes (IEEE 754 / General Decimal Arithmetic); first-order propagation of uncorrelated standard uncertainties, JCGM 100:2008 (GUM) 5.1.2 and 5.1.6, reporting as in GUM 7.2"
  }
}
