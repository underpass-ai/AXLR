[
  {"name": "textbook: binomial(10, 1/2) P(X = 5) is 63/256", "input": {"distribution": "binomial", "n": 10, "p": "0.5", "x": 5},
   "expect": {"exit": 0, "stdout_json": {"pmf": 0.24609375, "exact": {"pmf": "63/256", "cdf": "319/512", "sf": "193/512", "mean": "5", "variance": "5/2"}}}},
  {"name": "Poisson lambda 2: P(X = 0) is e^-2 = 0.1353352832", "input": {"distribution": "poisson", "lambda": 2, "x": 0},
   "expect": {"exit": 0, "stdout_contains": "\"pmf\": 0.13533528323"}},
  {"name": "standard normal table (Abramowitz and Stegun 26.2): Phi(1.96) = 0.9750021", "input": {"distribution": "normal", "mean": 0, "sd": 1, "x": 1.96},
   "expect": {"exit": 0, "stdout_contains": "\"cdf\": 0.97500210485"}},
  {"name": "standard normal 97.5 % quantile is 1.959964", "input": {"distribution": "normal", "mean": 0, "sd": 1, "q": 0.975},
   "expect": {"exit": 0, "stdout_contains": "\"quantile\": 1.95996398"}},
  {"name": "exactly one ace in a five-card hand: 4 C(48,4) / C(52,5) = 778320/2598960", "input": {"distribution": "hypergeometric", "population": 52, "successes": 4, "draws": 5, "x": 1},
   "expect": {"exit": 0, "stdout_json": {"exact": {"pmf": "3243/10829", "mean": "5/13"}}}},
  {"name": "first six on the third roll: (5/6)^2 (1/6) = 25/216", "input": {"distribution": "geometric", "p": "1/6", "x": 3},
   "expect": {"exit": 0, "stdout_json": {"exact": {"pmf": "25/216", "cdf": "91/216"}, "mean": 6.0}}},
  {"name": "binomial interval and median", "input": {"distribution": "binomial", "n": 10, "p": "1/2", "between": [4, 6], "q": 0.5},
   "expect": {"exit": 0, "stdout_json": {"quantile": 5, "exact": {"between": "21/32"}}}},
  {"name": "negative binomial: 2 failures before the 3rd success at p 1/2", "input": {"distribution": "negative_binomial", "r": 3, "p": "1/2", "x": 2},
   "expect": {"exit": 0, "stdout_json": {"exact": {"pmf": "3/16", "cdf": "1/2"}}}},
  {"name": "exponential median ln 2 / rate", "input": {"distribution": "exponential", "rate": "0.5", "q": 0.5},
   "expect": {"exit": 0, "stdout_contains": "\"quantile\": 1.38629436"}},
  {"name": "uniform is exact", "input": {"distribution": "uniform", "low": 0, "high": 10, "x": 3, "q": "1/4"},
   "expect": {"exit": 0, "stdout_json": {"exact": {"pdf": "1/10", "cdf": "3/10", "quantile": "5/2", "variance": "25/3"}}}},
  {"name": "poker hands C(52, 5) = 2598960", "input": {"operation": "choose", "n": 52, "k": 5}, "expect": {"exit": 0, "stdout_json": {"result": "2598960"}}},
  {"name": "arrangements of MISSISSIPPI: 11! / (1! 4! 4! 2!) = 34650", "input": {"operation": "multinomial", "counts": [1, 4, 4, 2]}, "expect": {"exit": 0, "stdout_json": {"result": "34650"}}},
  {"name": "probability above 1", "input": {"distribution": "binomial", "n": 10, "p": "1.5", "x": 5}, "expect": {"exit": 2, "stdout_contains": "p must be at most 1"}},
  {"name": "unknown distribution", "input": {"distribution": "cauchy", "x": 1}, "expect": {"exit": 2, "stdout_contains": "distribution must be"}}
