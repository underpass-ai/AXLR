[
  {"name": "decimal literals are exact", "input": {"expression": "0.1 + 0.2"}, "expect": {"exit": 0, "stdout_json": {"result": "3/10", "decimal": "0.3", "exact": true}}},
  {"name": "two to the hundred", "input": {"expression": "2**100"}, "expect": {"exit": 0, "stdout_json": {"result": "1267650600228229401496703205376", "is_integer": true}}},
  {"name": "poker hands", "input": {"expression": "binomial(52, 5)"}, "expect": {"exit": 0, "stdout_json": {"result": "2598960"}}},
  {"name": "compound interest with variables", "input": {"expression": "x * (1 + r)^n", "variables": {"x": "1000", "r": "0.05", "n": 3}}, "expect": {"exit": 0, "stdout_json": {"result": "9261/8", "decimal": "1157.625"}}},
  {"name": "square root of two to twenty digits", "input": {"expression": "sqrt(2)", "precision": 20}, "expect": {"exit": 0, "stdout_json": {"exact": false, "result": null, "decimal": "1.4142135623730950488"}}},
  {"name": "perfect roots stay exact", "input": {"expression": "sqrt(9/4) + 8**(1/3)"}, "expect": {"exit": 0, "stdout_json": {"result": "7/2", "exact": true}}},
  {"name": "attribute access refused", "input": {"expression": "(1).__class__"}, "expect": {"exit": 2, "stdout_contains": "not allowed"}},
  {"name": "division by zero", "input": {"expression": "1/(2-2)"}, "expect": {"exit": 2, "stdout_contains": "division by zero"}}
]
