[
  {"name": "solve a quadratic equation", "input": {"operation": "solve", "expression": "x^2 - 5x + 6 = 0"},
   "expect": {"exit": 0, "stdout_json": {"operation": "solve", "symbol": "x", "count": 2, "solutions": [{"result": "2"}, {"result": "3"}]}}},
  {"name": "solve for a named symbol", "input": {"operation": "solve", "expression": "a*y + b", "symbol": "y"},
   "expect": {"exit": 0, "stdout_json": {"solutions": [{"result": "-b/a"}]}}},
  {"name": "simplify a trigonometric identity", "input": {"operation": "simplify", "expression": "sin(x)**2 + cos(x)**2"},
   "expect": {"exit": 0, "stdout_json": {"result": "1", "decimal": "1.00000000000000"}}},
  {"name": "expand and factor", "input": {"operation": "expand", "expression": "(x + 1)^3"},
   "expect": {"exit": 0, "stdout_json": {"result": "x**3 + 3*x**2 + 3*x + 1"}}},
  {"name": "factor", "input": {"operation": "factor", "expression": "x**2 - 1"},
   "expect": {"exit": 0, "stdout_json": {"result": "(x - 1)*(x + 1)"}}},
  {"name": "second derivative", "input": {"operation": "differentiate", "expression": "x**4", "order": 2},
   "expect": {"exit": 0, "stdout_json": {"result": "12*x**2", "order": 2}}},
  {"name": "definite integral", "input": {"operation": "integrate", "expression": "x**2", "lower": 0, "upper": 3},
   "expect": {"exit": 0, "stdout_json": {"definite": true, "result": "9", "decimal": "9.00000000000000"}}},
  {"name": "indefinite integral", "input": {"operation": "integrate", "expression": "cos(x)"},
   "expect": {"exit": 0, "stdout_json": {"definite": false, "result": "sin(x)"}}},
  {"name": "classic limit", "input": {"operation": "limit", "expression": "sin(x)/x", "point": 0},
   "expect": {"exit": 0, "stdout_json": {"result": "1"}}},
  {"name": "limit at infinity", "input": {"operation": "limit", "expression": "(1 + 1/n)**n", "symbol": "n", "point": "oo"},
   "expect": {"exit": 0, "stdout_json": {"result": "E", "latex": "e"}}},
  {"name": "series of the exponential", "input": {"operation": "series", "expression": "exp(x)", "order": 4},
   "expect": {"exit": 0, "stdout_json": {"result": "1 + x + x**2/2 + x**3/6 + O(x**4)"}}},
  {"name": "ambiguous symbol is refused", "input": {"operation": "differentiate", "expression": "x*y"},
   "expect": {"exit": 2, "stdout_contains": "symbol is required"}},
  {"name": "code is not an expression", "input": {"operation": "simplify", "expression": "__import__('os')"},
   "expect": {"exit": 2, "stdout_contains": "may use letters"}},
  {"name": "unknown operation", "input": {"operation": "prove", "expression": "x"},
   "expect": {"exit": 2, "stdout_contains": "operation must be"}}
]
