  {"name": "RAE DPD 'diptongo' 1: vien.to, a.cei.te, cau.sa, sua.ve", "input": {"operation": "syllables", "words": ["viento", "aceite", "causa", "suave"]}, "expect": {"exit": 0, "stdout_json": {"words": [{"syllables": ["vien", "to"]}, {"syllables": ["a", "cei", "te"]}, {"syllables": ["cau", "sa"]}, {"syllables": ["sua", "ve"]}], "total": 9}}},
  {"name": "RAE DPD 'hiato' 1: grú.a, pa.ís, ca.er, dis.cu.tí.ais", "input": {"operation": "syllables", "words": ["grúa", "país", "caer", "discutíais"]}, "expect": {"exit": 0, "stdout_json": {"words": [{"syllables": ["grú", "a"], "type": "llana"}, {"syllables": ["pa", "ís"], "type": "aguda"}, {"syllables": ["ca", "er"], "type": "aguda"}, {"syllables": ["dis", "cu", "tí", "ais"], "stressed": 3}]}}},
