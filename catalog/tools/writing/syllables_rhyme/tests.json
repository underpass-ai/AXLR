  {"name": "RAE DPD 'tilde' 2.2: triphthongs averiguáis and buey (monosyllable), biaural aguda; silent u in que and guerra, ü in pingüino", "input": {"operation": "syllables", "words": ["averiguáis", "buey", "biaural", "queso", "guerra", "pingüino"]}, "expect": {"exit": 0, "stdout_json": {"words": [{"syllables": ["a", "ve", "ri", "guáis"], "type": "aguda"}, {"count": 1}, {"syllables": ["biau", "ral"], "type": "aguda"}, {"syllables": ["que", "so"]}, {"syllables": ["gue", "rra"]}, {"syllables": ["pin", "güi", "no"]}]}}},
  {"name": "RAE DPD 'tilde' 1.2: balón, robots, virrey agudas; dicen, clímax llanas; cántaro esdrújula; llévesemelo sobresdrújula", "input": {"operation": "syllables", "words": ["balón", "robots", "virrey", "dicen", "clímax", "cántaro", "llévesemelo"]}, "expect": {"exit": 0, "stdout_json": {"words": [{"type": "aguda"}, {"type": "aguda"}, {"type": "aguda", "syllables": ["vi", "rrey"]}, {"type": "llana", "stressed": 1}, {"type": "llana"}, {"type": "esdrújula"}, {"type": "sobresdrújula", "count": 5}]}}},
  {"name": "consonant rhyme from the stressed vowel: canción / corazón", "input": {"operation": "rhyme", "a": "canción", "b": "corazón"}, "expect": {"exit": 0, "stdout_json": {"rhyme": "consonant", "tails": ["ón", "ón"]}}},
  {"name": "assonant rhyme: casa / mala (a-a)", "input": {"operation": "rhyme", "a": "casa", "b": "mala"}, "expect": {"exit": 0, "stdout_json": {"rhyme": "assonant", "assonance": ["a-a", "a-a"]}}},
  {"name": "assonance ignores the unstressed weak vowel of a diphthong: gloria / sombra (o-a)", "input": {"operation": "rhyme", "a": "gloria", "b": "sombra"}, "expect": {"exit": 0, "stdout_json": {"rhyme": "assonant", "assonance": ["o-a", "o-a"]}}},
  {"name": "assonance skips the middle post-tonic vowel of an esdrújula: rápido / cántaro (a-o)", "input": {"operation": "rhyme", "a": "rápido", "b": "cántaro"}, "expect": {"exit": 0, "stdout_json": {"rhyme": "assonant", "assonance": ["a-o", "a-o"]}}},
  {"name": "Castilian b = v in consonant rhyme: estuvo / tubo", "input": {"operation": "rhyme", "a": "estuvo", "b": "tubo"}, "expect": {"exit": 0, "stdout_json": {"rhyme": "consonant", "sounds": ["ubo", "ubo"]}}},
