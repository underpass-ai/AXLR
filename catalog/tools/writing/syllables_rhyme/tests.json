  {"name": "Lorca, Romance sonámbulo: octosyllables assonant in a-a on the even lines (-a-a)", "input": {"operation": "scheme", "text": "Verde que te quiero verde.\nVerde viento. Verdes ramas.\nEl barco sobre la mar\ny el caballo en la montaña."}, "expect": {"exit": 0, "stdout_json": {"scheme": "-a-a", "lines": [{"metric_syllables_natural": 8}, {"metric_syllables_natural": 8}, {"metric_syllables_natural": 8}, {"metric_syllables_natural": 8, "rhyme_with_earlier": "assonant"}]}}},
  {"name": "English heuristic: Shakespeare, Sonnet 18 quatrain ABAB (day/May, temperate/date); line 1 has 10 syllables", "input": {"operation": "scheme", "language": "en", "lines": ["Shall I compare thee to a summer's day?", "Thou art more lovely and more temperate:", "Rough winds do shake the darling buds of May,", "And summer's lease hath all too short a date;"]}, "expect": {"exit": 0, "stdout_json": {"scheme": "ABAB", "approximate": true, "lines": [{"syllables": 10}, {"syllables": 10}, {"syllables": 10}, {"syllables": 10}]}}},
