[
  {"name": "hand-solved 3x3 with a black centre and a fixed T: CAT / BOW across, CAB / TOW down, and it is the only fill", "input": {"grid": ["..T", ".#.", "..."], "words": ["cat", "cab", "tow", "bow", "dog"], "max_solutions": 10}, "expect": {"exit": 0, "stdout_json": {"status": "filled", "grid": ["CAT", "A#O", "BOW"], "unique": true, "search_complete": true, "entries": [{"number": 1, "direction": "across", "word": "CAT"}, {"number": 3, "direction": "across", "row": 3, "col": 1, "word": "BOW"}, {"number": 1, "direction": "down", "word": "CAB"}, {"number": 2, "direction": "down", "row": 1, "col": 3, "word": "TOW"}]}}},
  {"name": "without the fixed letter the transposed fill (CAB / TOW across) is a second solution", "input": {"grid": ["...", ".#.", "..."], "words": ["cat", "cab", "tow", "bow", "dog"], "max_solutions": 10}, "expect": {"exit": 0, "stdout_json": {"solutions_found": 2, "unique": false, "grid": ["CAB", "A#O", "TOW"], "other_solutions": [["CAT", "A#O", "BOW"]]}}},
  {"name": "word square BAT / ARE / TEN reads the same across and down: no fill without repeats (six slots, three words)", "input": {"grid": ["...", "...", "..."], "words": ["BAT", "ARE", "TEN"]}, "expect": {"exit": 0, "stdout_json": {"status": "no_fill", "slots": 6, "solutions_found": 0}}},
  {"name": "the same word square with repeats allowed", "input": {"grid": ["...", "...", "..."], "words": ["bat", "are", "ten"], "allow_repeats": true, "max_solutions": 5}, "expect": {"exit": 0, "stdout_json": {"status": "filled", "grid": ["BAT", "ARE", "TEN"], "unique": true}}},
  {"name": "standard numbering and missing word lengths reported", "input": {"grid": ["....", "#..."], "words": ["abcd"]}, "expect": {"exit": 0, "stdout_json": {"status": "no_fill", "slots": 5, "no_words_of_length": [2, 3]}}},
  {"name": "accented words are folded to A-Z", "input": {"grid": ["...."], "words": ["Café", "niño"]}, "expect": {"exit": 0, "stdout_json": {"grid": ["CAFE"], "entries": [{"word": "CAFE", "direction": "across", "length": 4}]}}},
  {"name": "rows of different length", "input": {"grid": ["...", ".."], "words": ["ab"]}, "expect": {"exit": 2, "stdout_contains": "same length"}},
  {"name": "time limit out of range", "input": {"grid": ["..."], "words": ["abc"], "time_limit": 60}, "expect": {"exit": 2, "stdout_contains": "time_limit"}}
]
