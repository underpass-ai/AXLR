[
  {"name": "classic anagram: listen / silent (also enlist, inlets, tinsel), from the bundled list", "input": {"operation": "anagrams", "text": "listen", "bundled": true}, "expect": {"exit": 0, "stdout_json": {"letters": "eilnst", "single_word": ["enlist", "inlets", "silent", "tinsel"]}}},
  {"name": "multi-word: dormitory = dirty room, from a word list in the input", "input": {"operation": "anagrams", "text": "Dormitory", "words": ["dirty", "room", "rod", "my", "riot", "to", "dorm", "story"], "multi_word": true}, "expect": {"exit": 0, "stdout_json": {"single_word": [], "multi_word": ["dirty room", "my riot rod"], "search_complete": true}}},
  {"name": "known palindrome: 'A man, a plan, a canal: Panama' (Leigh Mercer, 1948)", "input": {"operation": "palindrome", "text": "A man, a plan, a canal: Panama"}, "expect": {"exit": 0, "stdout_json": {"is_palindrome": true, "normalized": "amanaplanacanalpanama", "length": 21}}},
  {"name": "Spanish palindrome with accents: 'Dábale arroz a la zorra el abad'", "input": {"operation": "palindrome", "text": "Dábale arroz a la zorra el abad"}, "expect": {"exit": 0, "stdout_json": {"is_palindrome": true, "length": 25}}},
  {"name": "not a palindrome", "input": {"operation": "palindrome", "text": "Panama canal"}, "expect": {"exit": 0, "stdout_json": {"is_palindrome": false}}},
  {"name": "Lewis Carroll's doublet HEAD to TAIL (Vanity Fair, 1879): head heal teal tell tall tail", "input": {"operation": "word_ladder", "start": "HEAD", "end": "tail", "words": ["heal", "teal", "tell", "tall", "hall", "hell"]}, "expect": {"exit": 0, "stdout_json": {"found": true, "steps": 5, "ladder": ["head", "heal", "teal", "tell", "tall", "tail"]}}},
  {"name": "no ladder through the list", "input": {"operation": "word_ladder", "start": "cat", "end": "dog", "words": ["cot", "cut", "hut"]}, "expect": {"exit": 0, "stdout_json": {"found": false, "steps": null}}},
  {"name": "pangram 'The quick brown fox jumps over the lazy dog': 35 letters, o four times, none missing", "input": {"operation": "letter_frequency", "text": "The quick brown fox jumps over the lazy dog"}, "expect": {"exit": 0, "stdout_json": {"total_letters": 35, "is_pangram": true, "missing_letters": [], "counts": {"o": 4, "e": 3, "u": 2}}}},
  {"name": "lipogram in e: 'Hello there' breaks it at offsets 1, 8 and 10 (hand count)", "input": {"operation": "lipogram", "text": "Hello there", "letters": "e"}, "expect": {"exit": 0, "stdout_json": {"is_lipogram": false, "violation_count": 3, "violations": [{"offset": 1, "char": "e"}, {"offset": 8, "char": "e"}, {"offset": 10, "char": "e"}]}}},
  {"name": "lipogram without a and e", "input": {"operation": "lipogram", "text": "Bright fox", "letters": ["a", "E"]}, "expect": {"exit": 0, "stdout_json": {"is_lipogram": true, "letters": ["a", "e"]}}},
  {"name": "ladder words of different length", "input": {"operation": "word_ladder", "start": "cat", "end": "goat", "words": ["coat"]}, "expect": {"exit": 2, "stdout_contains": "same number of letters"}},
  {"name": "anagrams without a word list", "input": {"operation": "anagrams", "text": "listen"}, "expect": {"exit": 2, "stdout_contains": "give words"}},
  {"name": "unknown operation", "input": {"operation": "rhyme", "text": "x"}, "expect": {"exit": 2, "stdout_contains": "operation must be one of"}}
]
