[
  {"name": "CommonMark 0.31.2 spec example 62 (ATX headings 1-6)", "input": {"markdown": "# foo\n## foo\n### foo\n#### foo\n##### foo\n###### foo\n"}, "expect": {"exit": 0, "stdout_json": {"html": "<h1>foo</h1>\n<h2>foo</h2>\n<h3>foo</h3>\n<h4>foo</h4>\n<h5>foo</h5>\n<h6>foo</h6>\n"}}},
  {"name": "CommonMark 0.31.2 spec example 80 (setext headings with emphasis)", "input": {"markdown": "Foo *bar*\n=========\n\nFoo *bar*\n---------\n"}, "expect": {"exit": 0, "stdout_json": {"html": "<h1>Foo <em>bar</em></h1>\n<h2>Foo <em>bar</em></h2>\n"}}},
  {"name": "CommonMark 0.31.2 spec example 107 (indented code block)", "input": {"markdown": "    a simple\n      indented code block\n"}, "expect": {"exit": 0, "stdout_json": {"html": "<pre><code>a simple\n  indented code block\n</code></pre>\n"}}},
  {"name": "CommonMark 0.31.2 spec example 119 (fenced code escapes < and >)", "input": {"markdown": "```\n<\n >\n```\n"}, "expect": {"exit": 0, "stdout_json": {"html": "<pre><code>&lt;\n &gt;\n</code></pre>\n"}}},
  {"name": "CommonMark 0.31.2 spec example 228 (block quote with a heading and a paragraph)", "input": {"markdown": "> # Foo\n> bar\n> baz\n"}, "expect": {"exit": 0, "stdout_json": {"html": "<blockquote>\n<h1>Foo</h1>\n<p>bar\nbaz</p>\n</blockquote>\n"}}},
  {"name": "CommonMark 0.31.2 spec example 301 (changing the bullet starts a new list)", "input": {"markdown": "- foo\n- bar\n+ baz\n"}, "expect": {"exit": 0, "stdout_json": {"html": "<ul>\n<li>foo</li>\n<li>bar</li>\n</ul>\n<ul>\n<li>baz</li>\n</ul>\n"}}},
  {"name": "CommonMark 0.31.2 spec example 306 (loose list)", "input": {"markdown": "- foo\n\n- bar\n\n\n- baz\n"}, "expect": {"exit": 0, "stdout_json": {"html": "<ul>\n<li>\n<p>foo</p>\n</li>\n<li>\n<p>bar</p>\n</li>\n<li>\n<p>baz</p>\n</li>\n</ul>\n"}}},
  {"name": "CommonMark 0.31.2 spec example 350 (emphasis)", "input": {"markdown": "*foo bar*\n"}, "expect": {"exit": 0, "stdout_json": {"html": "<p><em>foo bar</em></p>\n"}}},
  {"name": "CommonMark 0.31.2 spec example 402 (strong emphasis with inner underscores)", "input": {"markdown": "__foo__bar__baz__\n"}, "expect": {"exit": 0, "stdout_json": {"html": "<p><strong>foo__bar__baz</strong></p>\n"}}},
  {"name": "CommonMark 0.31.2 spec example 505 (link titles in three quote styles)", "input": {"markdown": "[link](/url \"title\")\n[link](/url 'title')\n[link](/url (title))\n"}, "expect": {"exit": 0, "stdout_json": {"html": "<p><a href=\"/url\" title=\"title\">link</a>\n<a href=\"/url\" title=\"title\">link</a>\n<a href=\"/url\" title=\"title\">link</a></p>\n"}}},
  {"name": "CommonMark 0.31.2 spec example 572 (image with a title)", "input": {"markdown": "![foo](/url \"title\")\n"}, "expect": {"exit": 0, "stdout_json": {"html": "<p><img src=\"/url\" alt=\"foo\" title=\"title\" /></p>\n"}}},
  {"name": "CommonMark 0.31.2 spec example 594 (autolink)", "input": {"markdown": "<http://foo.bar.baz>\n"}, "expect": {"exit": 0, "stdout_json": {"html": "<p><a href=\"http://foo.bar.baz\">http://foo.bar.baz</a></p>\n"}}},
  {"name": "CommonMark 0.31.2 spec example 633 (hard line break from two spaces)", "input": {"markdown": "foo  \nbaz\n"}, "expect": {"exit": 0, "stdout_json": {"html": "<p>foo<br />\nbaz</p>\n"}}},
  {"name": "CommonMark 0.31.2 spec example 12 (backslash escapes of every ASCII punctuation character)", "input": {"markdown": "\\!\\\"\\#\\$\\%\\&\\'\\(\\)\\*\\+\\,\\-\\.\\/\\:\\;\\<\\=\\>\\?\\@\\[\\\\\\]\\^\\_\\`\\{\\|\\}\\~\n"}, "expect": {"exit": 0, "stdout_json": {"html": "<p>!&quot;#$%&amp;'()*+,-./:;&lt;=&gt;?@[\\]^_`{|}~</p>\n"}}},
  {"name": "CommonMark 0.31.2 spec example 25 (named entity references)", "input": {"markdown": "&nbsp; &amp; &copy; &AElig; &Dcaron;\n&frac34; &HilbertSpace; &DifferentialD;\n&ClockwiseContourIntegral; &ngE;\n"}, "expect": {"exit": 0, "stdout_json": {"html": "<p>  &amp; © Æ Ď\n¾ ℋ ⅆ\n∲ ≧̸</p>\n"}}},
  {"name": "GitHub Flavored Markdown spec example 198 (tables extension: pipe table)", "input": {"markdown": "| foo | bar |\n| --- | --- |\n| baz | bim |\n"}, "expect": {"exit": 0, "stdout_json": {"html": "<table>\n<thead>\n<tr>\n<th>foo</th>\n<th>bar</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>baz</td>\n<td>bim</td>\n</tr>\n</tbody>\n</table>\n"}}},
  {"name": "GitHub Flavored Markdown spec example 199 (tables extension: column alignment)", "input": {"markdown": "| abc | defghi |\n:-: | -----------:\nbar | baz\n"}, "expect": {"exit": 0, "stdout_json": {"html": "<table>\n<thead>\n<tr>\n<th align=\"center\">abc</th>\n<th align=\"right\">defghi</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td align=\"center\">bar</td>\n<td align=\"right\">baz</td>\n</tr>\n</tbody>\n</table>\n"}}},
  {"name": "GitHub Flavored Markdown spec example 200 (tables extension: escaped pipes in cells)", "input": {"markdown": "| f\\|oo  |\n| ------ |\n| b `\\|` az |\n| b **\\|** im |\n"}, "expect": {"exit": 0, "stdout_json": {"html": "<table>\n<thead>\n<tr>\n<th>f|oo</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>b <code>|</code> az</td>\n</tr>\n<tr>\n<td>b <strong>|</strong> im</td>\n</tr>\n</tbody>\n</table>\n"}}},
  {"name": "raw HTML is escaped, never passed through", "input": {"markdown": "<script>alert(1)</script> & <b>x</b>"}, "expect": {"exit": 0, "stdout_json": {"html": "<p>&lt;script&gt;alert(1)&lt;/script&gt; &amp; &lt;b&gt;x&lt;/b&gt;</p>\n"}}},
  {"name": "unsafe URL schemes are emptied, as cmark --safe does (javascript:, data: other than images)", "input": {"markdown": "[x](javascript:alert(1)) ![i](data:text/html,x) [ok](https://a.b)"}, "expect": {"exit": 0, "stdout_json": {"html": "<p><a href=\"\">x</a> <img src=\"\" alt=\"i\" /> <a href=\"https://a.b\">ok</a></p>\n"}}},
  {"name": "plain text: markup removed, link URL kept in brackets, list markers and code kept (hand-checked)", "input": {"markdown": "# Title\n\nSome *bold* text with a [link](http://x.org).\n\n- one\n- two\n\n```\ncode\n```\n", "to": "text"}, "expect": {"exit": 0, "stdout_json": {"text": "Title\n\nSome bold text with a link (http://x.org).\n\n- one\n- two\n\ncode\n"}}},
  {"name": "slide outline split on headings of level 1 and 2 (hand-checked)", "input": {"markdown": "# Deck\n\nIntro line.\n\n## First\n\n- a\n- b\n\n## Second\n\nText **here**.\n", "to": "slides"}, "expect": {"exit": 0, "stdout_json": {"count": 3, "slides": [{"number": 1, "title": "Deck", "level": 1, "points": ["Intro line."]}, {"number": 2, "title": "First", "points": ["a", "b"]}, {"number": 3, "title": "Second", "points": ["Text here."]}], "outline": "1. Deck\n   - Intro line.\n2. First\n   - a\n   - b\n3. Second\n   - Text here.\n"}}},
  {"name": "unknown target", "input": {"markdown": "x", "to": "pdf"}, "expect": {"exit": 2, "stdout_contains": "to must be"}},
  {"name": "markdown missing", "input": {"to": "html"}, "expect": {"exit": 2, "stdout_contains": "markdown must be"}}
