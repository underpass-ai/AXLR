  {"name": "determinism, run 1: seed 42 gives these pharma names; each decomposes into syllables of the table (Mir/Dex/Cel/Ven + a/i + vax/pril/tex) and has 6 to 8 letters (hand-checked)", "input": {"kind": "product", "style": "pharma", "count": 5, "seed": 42, "min_length": 6, "max_length": 8}, "expect": {"exit": 0, "stdout_json": {"count": 5, "names": [{"name": "Mirivax", "parts": [["Mir", "i", "vax"]]}, {"name": "Dexpril", "parts": [["Dex", "pril"]]}, {"name": "Celatex", "parts": [["Cel", "a", "tex"]]}, {"name": "Celvax", "parts": [["Cel", "vax"]]}, {"name": "Venpril", "parts": [["Ven", "pril"]]}], "checks": {"within_bounds": true, "unique": true}}}},
  {"name": "determinism, run 2: the same input in a new process gives the same names", "input": {"kind": "product", "style": "pharma", "count": 5, "seed": 42, "min_length": 6, "max_length": 8}, "expect": {"exit": 0, "stdout_json": {"names": [{"name": "Mirivax"}, {"name": "Dexpril"}, {"name": "Celatex"}, {"name": "Celvax"}, {"name": "Venpril"}]}}},
  {"name": "female Nordic names with surnames, seed 2026 (Frey+var+rid, Vik+qvist... checked against the tables)", "input": {"kind": "character", "style": "nordic", "count": 3, "seed": 2026, "gender": "female"}, "expect": {"exit": 0, "stdout_json": {"names": [{"name": "Freyvarrid Vikqvist", "gender": "female"}, {"name": "Kjellun Dahlström", "gender": "female"}, {"name": "Freyvarny Lindlund", "gender": "female"}]}}},
  {"name": "constraints hold over 50 names", "input": {"kind": "character", "style": "fantasy", "count": 50, "seed": 9, "min_length": 5, "max_length": 7, "surname": false}, "expect": {"exit": 0, "stdout_json": {"count": 50, "checks": {"within_bounds": true, "unique": true}}}},
  {"name": "impossible length bounds: none generated, with a warning", "input": {"kind": "character", "style": "japanese", "count": 3, "seed": 1, "min_length": 15, "max_length": 15}, "expect": {"exit": 0, "stdout_json": {"count": 0, "names": []}, "stdout_contains": "only 0 names met the constraints"}},
  {"name": "list the styles", "input": {"list_styles": true}, "expect": {"exit": 0, "stdout_json": {"styles": {"product": ["brand", "pharma", "tech"], "place": ["english", "fantasy", "nordic", "spanish"]}}}},
