[
  {"name": "hand-checked merge: quoted comma in a cell, default for an empty city, empty amount reported", "input": {"csv": "id,name,city,amount\n1,Ana García,Madrid,120.50\n2,\"Smith, John\",,80\n3,Li,Lyon,\n", "template": "Dear {{ name }},\nWe will ship to {{city|your address}}. Amount due: {{amount}} EUR."}, "expect": {"stdout_json": {"rendered": 3, "rows_with_missing": [{"row": 3, "fields": ["amount"]}], "documents": [{"row": 1, "text": "Dear Ana García,\nWe will ship to Madrid. Amount due: 120.50 EUR.", "missing": []}, {"row": 2, "text": "Dear Smith, John,\nWe will ship to your address. Amount due: 80 EUR.", "missing": [], "defaults_used": ["city"]}, {"row": 3, "text": "Dear Li,\nWe will ship to Lyon. Amount due: {{amount}} EUR.", "missing": [{"field": "amount", "reason": "empty cell"}]}]}}},
  {"name": "missing empty: blank instead of the placeholder; a column that does not exist is named", "input": {"csv": "name\nAna\n", "template": "Hi {{name}} {{surname}}!", "missing": "empty"}, "expect": {"stdout_json": {"placeholders_without_column": ["surname"], "documents": [{"row": 1, "text": "Hi Ana !", "missing": [{"field": "surname", "reason": "no such column"}]}]}}},
  {"name": "file names: unsafe characters replaced, duplicates flagged; BOM and semicolon delimiter", "input": {"csv": "﻿id;name\n1;a/b\n1;c\n", "delimiter": ";", "template": "{{name}}", "filename_template": "doc_{{id}}.txt"}, "expect": {"stdout_json": {"columns": ["id", "name"], "documents": [{"filename": "doc_1.txt", "text": "a/b"}, {"filename": "doc_1.txt", "text": "c"}], "warnings": ["duplicate file names: doc_1.txt (rows 1, 2)"]}}},
  {"name": "only selected rows", "input": {"csv": "n\nx\ny\nz\n", "template": "[{{n}}]", "rows": [3, 1]}, "expect": {"stdout_json": {"rendered": 2, "documents": [{"row": 3, "text": "[z]"}, {"row": 1, "text": "[x]"}]}}},
  {"name": "missing error mode exits 2", "input": {"csv": "a\n\n1\n,\n", "template": "{{b}}", "missing": "error"}, "expect": {"exit": 2, "stdout_contains": "row(s) have missing fields"}},
  {"name": "duplicate header", "input": {"csv": "a,a\n1,2\n", "template": "{{a}}"}, "expect": {"exit": 2, "stdout_contains": "repeats column name"}},
  {"name": "no csv", "input": {"template": "x"}, "expect": {"exit": 2, "stdout_contains": "csv must be"}}
]
