{
  "name": "expense_split",
  "description": "Split shared expenses (equally, by weights or by exact shares among some participants) and settle up with the fewest transfers: balances paid minus owed in exact decimal minor units, leftover cents by largest remainder with a deterministic tie-break, payments already made, and a settlement found by splitting the balances into the most zero-sum groups and pairing largest creditor with largest debtor.",
  "input_schema": {
    "type": "object",
    "required": ["expenses"],
    "additionalProperties": false,
    "properties": {
      "expenses": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["paid_by", "amount"], "additionalProperties": false, "properties": {
        "description": {"type": "string"},
        "paid_by": {"type": "string"},
        "amount": {"type": ["number", "string"], "description": "Positive; a decimal string keeps exact cents"},
        "among": {"type": "array", "items": {"type": "string"}, "description": "Default: everyone"},
        "weights": {"type": "object", "additionalProperties": {"type": ["number", "string"]}, "description": "Relative shares, e.g. nights stayed"},
        "shares": {"type": "object", "additionalProperties": {"type": ["number", "string"]}, "description": "Exact amounts that add up to amount"}}}},
      "participants": {"type": "array", "items": {"type": "string"}, "description": "Default: in order of appearance; order breaks ties"},
      "payments": {"type": "array", "items": {"type": "object", "required": ["from", "to", "amount"], "additionalProperties": false, "properties": {
        "from": {"type": "string"}, "to": {"type": "string"}, "amount": {"type": ["number", "string"]}}}},
      "decimals": {"type": "integer", "minimum": 0, "maximum": 6, "default": 2},
      "currency": {"type": "string"}
    }
  },
  "program": "python3",
  "args": ["expense_split.py"],
  "files": ["expense_split.py"],
  "catalog": {
    "version": "1.0.0",
    "category": "administration",
    "tags": ["expenses", "splitting", "settlement", "group-travel", "decimal", "debts"],
    "license": "MIT",
    "requires": {"program_min_version": "3.10", "packages": []},
    "network": false,
    "example": {"input": {"expenses": [{"description": "Dinner", "paid_by": "A", "amount": "90.00", "among": ["A", "B", "C"]}, {"description": "Taxi", "paid_by": "B", "amount": 30, "among": ["A", "B", "C"]}]},
                "output": {"balances": {"A": "50.00", "B": "-10.00", "C": "-40.00"}, "transfers": [{"from": "C", "to": "A", "amount": "40.00"}, {"from": "B", "to": "A", "amount": "10.00"}]}},
    "source": "original; largest-remainder (Hamilton) rounding of shares; minimum-transfer settlement as the maximum partition of balances into zero-sum groups"
  }
}
