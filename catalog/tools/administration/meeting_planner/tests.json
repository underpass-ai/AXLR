   "expect": {"stdout_json": {"windows": [{"start_utc": "2026-06-30T23:00Z", "end_utc": "2026-07-01T01:00Z", "local": {"Tokyo": {"start": {"date": "2026-07-01", "time": "08:00"}}, "LA": {"start": {"date": "2026-06-30", "time": "16:00", "weekday": "Tuesday"}}}}],
