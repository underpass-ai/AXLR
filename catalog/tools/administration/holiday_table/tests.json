   "expect": {"stdout_json": {"days_off": ["2027-01-01", "2027-01-18", "2027-02-15", "2027-05-31", "2027-06-18", "2027-07-05", "2027-09-06", "2027-10-11", "2027-11-11", "2027-11-25", "2027-12-24", "2027-12-31"]}}},
  {"name": "England and Wales 2026 bank holidays as published on gov.uk/bank-holidays, Boxing Day substitute Monday 28 December",
