[
  {"name": "RFC 5545 3.3.11 TEXT example: newlines escaped as \\n in DESCRIPTION", "input": {"summary": "Review", "start": "2026-10-20T10:00:00", "description": "Project XYZ Final Review\nConference Room - 3B\nCome Prepared.", "uid": "rfc-text@example.com"}, "expect": {"stdout_contains": "\\r\\nDESCRIPTION:Project XYZ Final Review\\\\nConference Room - 3B\\\\nCome Prepared.\\r\\n"}},
  {"name": "RFC 5545 3.8.5.3 example: every other week on MO, WE, FR until 24 Dec 1997 (UNTIL in UTC with a TZID start)", "input": {"summary": "Biweekly", "start": "1997-09-02T09:00:00", "tzid": "America/New_York", "duration_minutes": 60, "uid": "rfc-rrule@example.com", "rrule": {"freq": "WEEKLY", "interval": 2, "until": "1997-12-24T00:00:00Z", "wkst": "SU", "byday": ["MO", "WE", "FR"]}}, "expect": {"stdout_contains": "\\r\\nDTSTART;TZID=America/New_York:19970902T090000\\r\\nDURATION:PT1H\\r\\nSUMMARY:Biweekly\\r\\nRRULE:FREQ=WEEKLY;INTERVAL=2;UNTIL=19971224T000000Z;WKST=SU;BYDAY=MO,WE,FR\\r\\n"}},
  {"name": "RFC 5545 3.8.5.3 example: monthly on the first Friday for 10 occurrences", "input": {"summary": "First Friday", "start": "1997-09-05T09:00:00", "tzid": "America/New_York", "uid": "rfc-monthly@example.com", "include_vtimezone": false, "rrule": {"freq": "MONTHLY", "count": 10, "byday": ["1FR"]}}, "expect": {"stdout_contains": "RRULE:FREQ=MONTHLY;COUNT=10;BYDAY=1FR\\r\\n"}},
  {"name": "VTIMEZONE for New York 1997 has the then-current US rule (first Sunday of April, last Sunday of October)", "input": {"summary": "x", "start": "1997-09-02T09:00:00", "tzid": "America/New_York", "uid": "tz@example.com"}, "expect": {"stdout_contains": "BEGIN:DAYLIGHT\\r\\nDTSTART:19960407T020000\\r\\nRRULE:FREQ=YEARLY;BYMONTH=4;BYDAY=1SU\\r\\nTZOFFSETFROM:-0500\\r\\nTZOFFSETTO:-0400\\r\\nTZNAME:EDT\\r\\nEND:DAYLIGHT\\r\\n"}},
  {"name": "VTIMEZONE for Madrid 2026: EU rule, last Sunday of March at 02:00 CET", "input": {"summary": "x", "start": "2026-10-20T10:00", "tzid": "Europe/Madrid", "uid": "mad@example.com"}, "expect": {"stdout_contains": "BEGIN:DAYLIGHT\\r\\nDTSTART:20250330T020000\\r\\nRRULE:FREQ=YEARLY;BYMONTH=3;BYDAY=-1SU\\r\\nTZOFFSETFROM:+0100\\r\\nTZOFFSETTO:+0200\\r\\nTZNAME:CEST\\r\\n"}},
  {"name": "RFC 5545 3.3.11 escaping of semicolon, comma and backslash (colon left alone)", "input": {"summary": "Lunch; bring snacks, drinks \\ more: ok", "start": "2026-10-20T13:00:00", "uid": "esc@example.com"}, "expect": {"stdout_contains": "\\r\\nSUMMARY:Lunch\\\\; bring snacks\\\\, drinks \\\\\\\\ more: ok\\r\\n"}},
  {"name": "RFC 5545 3.1 folding: 75 octets, then CRLF and one space (hand-checked: 12 + 63, then 1 + 37)", "input": {"summary": "f", "start": "2026-10-20T13:00:00", "uid": "fold@example.com", "description": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"}, "expect": {"stdout_contains": "\\r\\nDESCRIPTION:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\\r\\n xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\\r\\n"}},
  {"name": "folding never splits a UTF-8 sequence: 31 two-octet chars (74 octets with the name), then 37, then 9", "input": {"summary": "f", "start": "2026-10-20T13:00:00", "uid": "fold8@example.com", "description": "ééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééé"}, "expect": {"stdout_contains": "\\r\\nDESCRIPTION:ééééééééééééééééééééééééééééééé\\r\\n ééééééééééééééééééééééééééééééééééééé\\r\\n ééééééééé\\r\\n"}},
  {"name": "RFC 5545 3.8.4.3 ORGANIZER example and a quoted CN with a comma (72 octets + FAL = 75), alarm 15 minutes before", "input": {"summary": "Meet", "start": "2026-10-20T10:00:00Z", "end": "2026-10-20T11:00:00Z", "uid": "org@example.com", "dtstamp": "2026-10-18T09:00:00Z", "organizer": {"email": "jsmith@example.com", "name": "John Smith"}, "attendees": [{"email": "jane@example.com", "name": "Doe, Jane", "rsvp": false}], "alarms": [{"minutes_before": 15, "description": "Soon"}]}, "expect": {"stdout_contains": "DTSTAMP:20261018T090000Z\\r\\nDTSTART:20261020T100000Z\\r\\nDTEND:20261020T110000Z\\r\\nSUMMARY:Meet\\r\\nORGANIZER;CN=John Smith:mailto:jsmith@example.com\\r\\nATTENDEE;CN=\\\"Doe, Jane\\\";ROLE=REQ-PARTICIPANT;PARTSTAT=NEEDS-ACTION;RSVP=FAL\\r\\n SE:mailto:jane@example.com\\r\\nBEGIN:VALARM\\r\\nACTION:DISPLAY\\r\\nTRIGGER:-PT15M\\r\\nDESCRIPTION:Soon\\r\\nEND:VALARM\\r\\n"}},
  {"name": "all-day event: VALUE=DATE and DTEND the next day", "input": {"summary": "Holiday", "start": "2026-12-24", "uid": "day@example.com"}, "expect": {"stdout_contains": "DTSTART;VALUE=DATE:20261224\\r\\nDTEND;VALUE=DATE:20261225\\r\\n"}},
  {"name": "local time converted to UTC with utc true (Madrid UTC+2 in October)", "input": {"summary": "x", "start": "2026-10-20T10:00", "tzid": "Europe/Madrid", "utc": true, "uid": "u@example.com"}, "expect": {"stdout_json": {"time_mode": "utc", "uid": "u@example.com"}, "stdout_contains": "DTSTART:20261020T080000Z\\r\\n"}},
  {"name": "derived UID is stable and fixed DTSTAMP", "input": {"summary": "Stable", "start": "2026-10-20T10:00"}, "expect": {"stdout_json": {"uid_rule": "derived: first 32 hex digits of SHA-256 of the input", "dtstamp": "19700101T000000Z", "time_mode": "floating"}}},
  {"name": "count and until together", "input": {"summary": "x", "start": "2026-10-20T10:00", "rrule": {"freq": "DAILY", "count": 3, "until": "2026-10-30"}}, "expect": {"exit": 2, "stdout_contains": "count or until, not both"}},
  {"name": "unknown time zone", "input": {"summary": "x", "start": "2026-10-20T10:00", "tzid": "Mars/Olympus"}, "expect": {"exit": 2, "stdout_contains": "not a known IANA time zone"}},
  {"name": "ordinal BYDAY needs monthly or yearly", "input": {"summary": "x", "start": "2026-10-20T10:00", "rrule": {"freq": "WEEKLY", "byday": ["1FR"]}}, "expect": {"exit": 2, "stdout_contains": "needs freq MONTHLY or YEARLY"}}
]
