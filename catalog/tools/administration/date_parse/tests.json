[
  {"name": "the commonly cited ISO 8601 duration example P3Y6M4DT12H30M5S (3 years, 6 months, 4 days, 12 hours, 30 minutes, 5 seconds)",
   "input": {"text": "P3Y6M4DT12H30M5S"},
   "expect": {"stdout_json": {"type": "duration", "components": {"years": "3", "months": "6", "days": "4", "hours": "12", "minutes": "30", "seconds": "5"}}}},
  {"name": "P1DT2H is 26 hours = 93600 s (hand-checked)", "input": {"text": "P1DT2H"},
   "expect": {"stdout_json": {"total_seconds": "93600"}}},
  {"name": "P4W from 18 Oct 2026 ends 15 Nov 2026 (28 days)", "input": {"text": "P4W", "reference": "2026-10-18"},
   "expect": {"stdout_json": {"total_seconds": "2419200", "end": "2026-11-15"}}},
  {"name": "P1M from 31 January clamps to 28 February", "input": {"text": "P1M", "reference": "2026-01-31"},
   "expect": {"stdout_json": {"end": "2026-02-28"}}},
  {"name": "next Monday from Sunday 18 Oct 2026 is 19 Oct", "input": {"text": "next Monday", "reference": "2026-10-18"},
   "expect": {"stdout_json": {"value": "2026-10-19", "rule": "weekday_next"}}},
  {"name": "next Sunday on a Sunday is a week later", "input": {"text": "next Sunday", "reference": "2026-10-18"},
   "expect": {"stdout_json": {"value": "2026-10-25"}}},
  {"name": "3 weeks ago", "input": {"text": "3 weeks ago", "reference": "2026-10-18"},
   "expect": {"stdout_json": {"value": "2026-09-27", "rule": "relative_ago_weeks"}}},
  {"name": "Spanish: hace 3 días", "input": {"text": "hace 3 días", "reference": "2026-10-18"},
   "expect": {"stdout_json": {"value": "2026-10-15"}}},
  {"name": "Spanish: el próximo lunes", "input": {"text": "el próximo lunes", "reference": "2026-10-18"},
   "expect": {"stdout_json": {"value": "2026-10-19"}}},
  {"name": "Spanish: mañana a las 10:30", "input": {"text": "mañana a las 10:30", "reference": "2026-10-18"},
   "expect": {"stdout_json": {"type": "datetime", "value": "2026-10-19T10:30:00"}}},
  {"name": "in 2 hours crosses midnight", "input": {"text": "in 2 hours", "reference": "2026-10-18T23:00"},
   "expect": {"stdout_json": {"value": "2026-10-19T01:00:00"}}},
  {"name": "18/10/2026 day first (unambiguous)", "input": {"text": "18/10/2026"},
   "expect": {"stdout_json": {"value": "2026-10-18", "rule": "numeric_dmy_inferred"}}},
  {"name": "05/10/2026 month first", "input": {"text": "05/10/2026", "date_order": "MDY"},
   "expect": {"stdout_json": {"value": "2026-05-10"}}},
  {"name": "ISO week date 2026-W42-7 is Sunday 18 Oct 2026", "input": {"text": "2026-W42-7"},
   "expect": {"stdout_json": {"value": "2026-10-18", "weekday": "Sunday"}}},
  {"name": "basic-format UTC datetime", "input": {"text": "20261018T103000Z"},
   "expect": {"stdout_json": {"value": "2026-10-18T10:30:00+00:00"}}},
  {"name": "18 de octubre de 2026", "input": {"text": "18 de octubre de 2026"}, "expect": {"stdout_json": {"value": "2026-10-18"}}},
  {"name": "ambiguous slash date without date_order", "input": {"text": "05/10/2026"}, "expect": {"exit": 2, "stdout_contains": "ambiguous"}},
  {"name": "relative form without reference", "input": {"text": "tomorrow"}, "expect": {"exit": 2, "stdout_contains": "reference is required"}},
  {"name": "weekday that does not match", "input": {"text": "Monday, October 18, 2026"}, "expect": {"exit": 2, "stdout_contains": "is a Sunday"}},
  {"name": "unparseable", "input": {"text": "blah blah"}, "expect": {"exit": 2, "stdout_contains": "could not parse"}}
]
