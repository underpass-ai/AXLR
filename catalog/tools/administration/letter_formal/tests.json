[
  {"name": "UK rule (Cambridge Dictionary, 'Yours faithfully'): no named recipient, Dear Sir or Madam closes Yours faithfully",
   "input": {"language": "en", "date": "2026-10-18", "subject": "Application", "sender": {"name": "Tirso García", "address": ["1 High St", "London"]}, "recipient": {"organisation": "Acme Ltd"}},
   "expect": {"stdout_json": {"salutation": "Dear Sir or Madam,", "closing": "Yours faithfully,", "date_line": "18 October 2026", "subject_line": "Subject: Application"}}},
  {"name": "UK rule (Cambridge Dictionary, 'Yours sincerely'): named recipient, Dear Ms Smith closes Yours sincerely, no full stop after Ms",
   "input": {"language": "en", "date": "2026-10-18", "recipient": {"name": "Jane Smith", "gender": "female"}},
   "expect": {"stdout_json": {"salutation": "Dear Ms Smith,", "closing": "Yours sincerely,"}}},
  {"name": "US business letter (Gregg Reference Manual): colon after the salutation, Sincerely, month-first date",
   "input": {"language": "en", "variant": "us", "date": "2026-10-18", "place": "Boston", "recipient": {"name": "John Smith", "gender": "male", "title": "Dr"}},
   "expect": {"stdout_json": {"salutation": "Dear Dr. Smith:", "closing": "Sincerely,", "date_line": "Boston, October 18, 2026"}}},
  {"name": "German standard formulas (DIN 5008, Duden): Sehr geehrte Damen und Herren, ... Mit freundlichen Grüßen without a comma",
   "input": {"language": "de", "date": "2026-10-18", "place": "Berlin", "subject": "Ihre Anfrage"},
   "expect": {"stdout_json": {"salutation": "Sehr geehrte Damen und Herren,", "closing": "Mit freundlichen Grüßen", "date_line": "Berlin, 18. Oktober 2026", "subject_line": "Ihre Anfrage"}}},
  {"name": "German named recipient with academic title: Sehr geehrte Frau Dr. Müller",
   "input": {"language": "de", "date": "2026-10-18", "recipient": {"name": "Erika Müller", "gender": "female", "title": "Dr."}},
   "expect": {"stdout_json": {"salutation": "Sehr geehrte Frau Dr. Müller,"}, "stdout_contains": "Frau Dr. Erika Müller\\n"}},
  {"name": "French standard formula (service-public.fr model letters): Madame, Monsieur, ... Veuillez agréer, Madame, Monsieur, l'expression de mes salutations distinguées; le 1er",
   "input": {"language": "fr", "date": "2026-10-01", "place": "Paris", "subject": "Demande"},
   "expect": {"stdout_json": {"salutation": "Madame, Monsieur,", "closing": "Veuillez agréer, Madame, Monsieur, l'expression de mes salutations distinguées.", "date_line": "Paris, le 1er octobre 2026", "subject_line": "Objet : Demande"}}},
  {"name": "French very formal: the closing repeats Monsieur le Directeur",
   "input": {"language": "fr", "register": "very_formal", "date": "2026-10-18", "recipient": {"name": "Jean Dupont", "gender": "male", "position": "le Directeur"}},
   "expect": {"stdout_json": {"salutation": "Monsieur le Directeur,", "closing": "Je vous prie de croire, Monsieur le Directeur, à l'assurance de ma haute considération."}}},
  {"name": "Spanish (RAE): colon after Estimada Sra. García, Atentamente, date with lower-case month",
   "input": {"language": "es", "date": "2026-10-18", "place": "Madrid", "recipient": {"name": "Ana García López", "surname": "García", "gender": "female"}},
   "expect": {"stdout_json": {"salutation": "Estimada Sra. García:", "closing": "Atentamente,", "date_line": "Madrid, 18 de octubre de 2026"}}},
  {"name": "Spanish administrative writing: EXPONE and SOLICITA, En Madrid, a ...",
   "input": {"language": "es", "register": "administrative", "date": "2026-10-18", "place": "Madrid", "sender": {"name": "Ana García", "address": ["C/ Mayor 1, Madrid"]}, "recipient": {"position": "Director General", "organisation": "de Tráfico"}, "body": ["Que necesito el certificado."], "request": "Que se expida el certificado."},
   "expect": {"stdout_json": {"date_line": "En Madrid, a 18 de octubre de 2026.", "salutation": null}, "stdout_contains": "EXPONE:\\n\\n1. Que necesito el certificado.\\n\\nSOLICITA:\\n\\nQue se expida el certificado."}},
  {"name": "Italian very formal: Egregio Signor Rossi, Distinti saluti", "input": {"language": "it", "register": "very_formal", "date": "2026-10-18", "place": "Roma", "recipient": {"name": "Mario Rossi", "gender": "male"}},
   "expect": {"stdout_json": {"salutation": "Egregio Signor Rossi,", "closing": "Distinti saluti", "date_line": "Roma, 18 ottobre 2026"}}},
  {"name": "Portuguese requerimento: Exmos. Senhores, Pede deferimento", "input": {"language": "pt", "register": "administrative", "date": "2026-10-18", "place": "Lisboa"},
   "expect": {"stdout_json": {"salutation": "Exmos. Senhores,", "closing": "Pede deferimento.", "date_line": "Lisboa, 18 de outubro de 2026"}}},
