[
  {"name": "docx: {{name}} split across two runs (ECMA-376 Part 1 17.3: w:p > w:r > w:t, hand-built file) is merged and filled, XML escaped, default and missing reported", "input": {"docx_hex": "", "values": {"name": "Ada <Lovelace>", "amount": 12.5}}, "expect": {"stdout_json": {"format": "docx", "paragraphs": ["Dear Ada <Lovelace>,", "Total: 12.5 & EUR due {{date}}."], "parts_changed": ["word/document.xml"], "placeholders_found": ["name", "amount", "currency", "date"], "missing": ["date"], "defaults_used": ["currency"]}}},
  {"name": "docx: all values given", "input": {"docx_hex": "", "values": {"name": "Ada", "amount": "12.50", "currency": "USD", "date": "1 Nov"}}, "expect": {"stdout_json": {"paragraphs": ["Dear Ada,", "Total: 12.50 & USD due 1 Nov."], "missing": []}}},
  {"name": "docx: a newline in a value (written as w:br in the run)", "input": {"docx_hex": "", "values": {"name": "Ada\nLovelace", "amount": 1, "date": "x"}}, "expect": {"stdout_json": {"paragraphs": ["Dear Ada\nLovelace,", "Total: 1 & EUR due x."]}}},
  {"name": "text: hand-checked fill with spaces in braces, a default and a kept placeholder", "input": {"text": "Hello {{ name }}, your order {{order}} ships {{when|soon}}. {{ps}}", "values": {"name": "Ana", "order": 1042, "extra": "x"}}, "expect": {"stdout_json": {"text": "Hello Ana, your order 1042 ships soon. {{ps}}", "missing": ["ps"], "defaults_used": ["when"], "values_not_used": ["extra"]}}},
  {"name": "text: missing empty", "input": {"text": "[{{a}}][{{b}}]", "values": {"a": true}, "missing": "empty"}, "expect": {"stdout_json": {"text": "[true][]"}}},
  {"name": "missing error", "input": {"text": "{{a}}", "values": {}, "missing": "error"}, "expect": {"exit": 2, "stdout_contains": "no value for: a"}},
  {"name": "not hex", "input": {"docx_hex": "zz", "values": {}}, "expect": {"exit": 2, "stdout_contains": "not valid hex"}},
  {"name": "not a zip", "input": {"docx_hex": "00112233", "values": {}}, "expect": {"exit": 2, "stdout_contains": "not a zip"}},
  {"name": "both inputs", "input": {"text": "x", "docx_hex": "00"}, "expect": {"exit": 2, "stdout_contains": "exactly one"}}
]
