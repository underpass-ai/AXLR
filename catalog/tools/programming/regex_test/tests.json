[
  {"name": "Python re docs (findall): \\bf[a-z]* in 'which foot or hand fell fastest' finds foot, fell, fastest", "input": {"pattern": "\\bf[a-z]*", "text": "which foot or hand fell fastest"}, "expect": {"stdout_json": {"match_count": 3, "matches": [{"match": "foot", "span": [6, 10]}, {"match": "fell", "span": [19, 23]}, {"match": "fastest", "span": [24, 31]}]}}},
  {"name": "Python re docs (split): \\W+ and (\\W+) over 'Words, words, words.'", "input": {"pattern": "(\\W+)", "text": "Words, words, words.", "split": true}, "expect": {"stdout_json": {"split": ["Words", ", ", "words", ", ", "words", ".", ""]}}},
  {"name": "Python re docs (split): maxsplit 1 gives ['Words', 'words, words.']", "input": {"pattern": "\\W+", "text": "Words, words, words.", "split": true, "maxsplit": 1}, "expect": {"stdout_json": {"split": ["Words", "words, words."]}}},
  {"name": "Python re docs (split): '[a-f]+' over '0a3B9' with IGNORECASE gives ['0', '3', '9']", "input": {"pattern": "[a-f]+", "text": "0a3B9", "flags": ["IGNORECASE"], "split": true}, "expect": {"stdout_json": {"flags": ["IGNORECASE"], "split": ["0", "3", "9"]}}},
  {"name": "Python re docs (Match.groupdict): (?P<first_name>\\w+) (?P<last_name>\\w+) on 'Malcolm Reynolds'", "input": {"pattern": "(?P<first_name>\\w+) (?P<last_name>\\w+)", "text": "Malcolm Reynolds", "anchor": "match"}, "expect": {"stdout_json": {"group_names": ["first_name", "last_name"], "matches": [{"match": "Malcolm Reynolds", "groups": ["Malcolm", "Reynolds"], "named": {"first_name": "Malcolm", "last_name": "Reynolds"}, "group_spans": [[0, 7], [8, 16]]}]}}},
  {"name": "Python re docs (Match.start/end): remove_this in tony@tiremove_thisger.net spans 7-18", "input": {"pattern": "remove_this", "text": "tony@tiremove_thisger.net", "replacement": ""}, "expect": {"stdout_json": {"matches": [{"span": [7, 18]}], "substitution": {"result": "tony@tiger.net", "replacements": 1}}}},
  {"name": "Python re docs (sub): def myfunc(): becomes a C function header with \\1", "input": {"pattern": "def\\s+([a-zA-Z_][a-zA-Z_0-9]*)\\s*\\(\\s*\\):", "text": "def myfunc():", "replacement": "static PyObject*\\npy_\\1(void)\\n{"}, "expect": {"stdout_json": {"substitution": {"result": "static PyObject*\npy_myfunc(void)\n{"}}}},
  {"name": "Python re docs (sub): empty matches, x* over abxd with - gives -a-b--d-", "input": {"pattern": "x*", "text": "abxd", "replacement": "-"}, "expect": {"stdout_json": {"substitution": {"result": "-a-b--d-", "replacements": 5}}}},
  {"name": "Python re docs (subn): \\sAND\\s with IGNORECASE on 'Baked Beans And Spam'", "input": {"pattern": "\\sAND\\s", "text": "Baked Beans And Spam", "replacement": " & ", "flags": ["i"]}, "expect": {"stdout_json": {"substitution": {"result": "Baked Beans & Spam", "replacements": 1}}}},
  {"name": "fullmatch fails on a partial match", "input": {"pattern": "\\d+", "text": "123abc", "anchor": "fullmatch"}, "expect": {"stdout_json": {"matched": false, "matches": []}}},
  {"name": "an optional group that did not take part is null", "input": {"pattern": "(a)(b)?", "text": "a"}, "expect": {"stdout_json": {"matches": [{"groups": ["a", null], "group_spans": [[0, 1], null]}]}}},
  {"name": "catastrophic backtracking (a+)+$ is stopped by the timeout", "input": {"pattern": "(a+)+$", "text": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaab", "timeout": 0.5}, "expect": {"exit": 2, "stdout_contains": "timed out after 0.5 s while matching"}},
  {"name": "invalid pattern reports the position", "input": {"pattern": "(abc", "text": "abc"}, "expect": {"exit": 2, "stdout_contains": "invalid pattern at position 0"}},
  {"name": "unknown flag", "input": {"pattern": "a", "text": "a", "flags": ["GLOBAL"]}, "expect": {"exit": 2, "stdout_contains": "unknown flag"}}
]
