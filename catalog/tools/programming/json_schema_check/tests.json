[
  {"name": "json-schema.org Getting started: the product schema accepts its valid instance (productId 1, An ice sculpture, 12.5, tags cold/ice)", "input": {"schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://example.com/product.schema.json", "title": "Product", "description": "A product from Acme's catalog", "type": "object", "properties": {"productId": {"description": "The unique identifier for a product", "type": "integer"}, "productName": {"description": "Name of the product", "type": "string"}, "price": {"description": "The price of the product", "type": "number", "exclusiveMinimum": 0}, "tags": {"description": "Tags for the product", "type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}}, "required": ["productId", "productName", "price"]}, "instance": {"productId": 1, "productName": "An ice sculpture", "price": 12.5, "tags": ["cold", "ice"]}}, "expect": {"stdout_json": {"valid": true, "errors": [], "complete": true}}},
  {"name": "json-schema.org Getting started: the invalid instance misses productName and has price \"100\" as a string", "input": {"schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://example.com/product.schema.json", "title": "Product", "description": "A product from Acme's catalog", "type": "object", "properties": {"productId": {"description": "The unique identifier for a product", "type": "integer"}, "productName": {"description": "Name of the product", "type": "string"}, "price": {"description": "The price of the product", "type": "number", "exclusiveMinimum": 0}, "tags": {"description": "Tags for the product", "type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}}, "required": ["productId", "productName", "price"]}, "instance": {"productId": 1, "product": "An ice sculpture", "price": "100"}}, "expect": {"stdout_json": {"valid": false, "errors": [{"instance_path": "", "schema_path": "/required", "keyword": "required", "property": "productName"}, {"instance_path": "/price", "schema_path": "/properties/price/type", "keyword": "type"}]}}},
  {"name": "json-schema.org Getting started final schema: the external $ref of warehouseLocation is reported as unsupported, the rest is checked", "input": {"schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://example.com/product.schema.json", "title": "Product", "description": "A product from Acme's catalog", "type": "object", "properties": {"productId": {"description": "The unique identifier for a product", "type": "integer"}, "productName": {"description": "Name of the product", "type": "string"}, "price": {"description": "The price of the product", "type": "number", "exclusiveMinimum": 0}, "tags": {"description": "Tags for the product", "type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}, "dimensions": {"type": "object", "properties": {"length": {"type": "number"}, "width": {"type": "number"}, "height": {"type": "number"}}, "required": ["length", "width", "height"]}, "warehouseLocation": {"description": "Coordinates of the warehouse where the product is located.", "$ref": "https://example.com/geographical-location.schema.json"}}, "required": ["productId", "productName", "price"]}, "instance": {"productId": 1, "productName": "An ice sculpture", "price": 12.5, "tags": ["cold", "ice"], "dimensions": {"length": 7.0, "width": 12.0, "height": 9.5}, "warehouseLocation": {"latitude": -78.75, "longitude": 20.4}}}, "expect": {"stdout_json": {"valid": true, "complete": false, "unsupported": [{"keyword": "$ref (non-local: https://example.com/geographical-location.schema.json)", "schema_path": "/properties/warehouseLocation/$ref"}]}}},
  {"name": "Getting started schema: exclusiveMinimum 0, minItems 1 and the nested dimensions required list", "input": {"schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://example.com/product.schema.json", "title": "Product", "description": "A product from Acme's catalog", "type": "object", "properties": {"productId": {"description": "The unique identifier for a product", "type": "integer"}, "productName": {"description": "Name of the product", "type": "string"}, "price": {"description": "The price of the product", "type": "number", "exclusiveMinimum": 0}, "tags": {"description": "Tags for the product", "type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}, "dimensions": {"type": "object", "properties": {"length": {"type": "number"}, "width": {"type": "number"}, "height": {"type": "number"}}, "required": ["length", "width", "height"]}}, "required": ["productId", "productName", "price"]}, "instance": {"productId": 1, "productName": "x", "price": 0, "tags": [], "dimensions": {"length": 1}}}, "expect": {"stdout_json": {"error_count": 4, "errors": [{"instance_path": "/dimensions", "property": "width"}, {"instance_path": "/dimensions", "property": "height"}, {"instance_path": "/price", "keyword": "exclusiveMinimum"}, {"instance_path": "/tags", "keyword": "minItems"}]}}},
  {"name": "JSON Schema 2020-12 Validation 6.1.1 (integer: any number with a zero fractional part) and Core 4.2.1-4.2.2: 1.0 is an integer, true is not a number", "input": {"schema": {"type": "array", "items": {"type": "integer"}}, "instance": [1.0, true]}, "expect": {"stdout_json": {"errors": [{"instance_path": "/1", "keyword": "type", "message": "boolean is not of type integer"}]}}},
  {"name": "local $ref into $defs, prefixItems then items, uniqueItems with JSON equality", "input": {"schema": {"$defs": {"pos": {"type": "integer", "minimum": 1}}, "type": "array", "prefixItems": [{"const": "a"}, {"$ref": "#/$defs/pos"}], "items": {"enum": [true, null]}, "uniqueItems": true}, "instance": ["a", 0, true, 1, true]}, "expect": {"stdout_json": {"errors": [{"keyword": "uniqueItems"}, {"instance_path": "/1", "schema_path": "/prefixItems/1/$ref/minimum"}, {"instance_path": "/3", "schema_path": "/items/enum"}]}}},
  {"name": "oneOf matched twice, additionalProperties false, patternProperties", "input": {"schema": {"type": "object", "properties": {"n": {"oneOf": [{"type": "integer"}, {"multipleOf": 0.5}]}}, "patternProperties": {"^x-": {"type": "string"}}, "additionalProperties": false}, "instance": {"n": 2, "x-a": "ok", "other": 1}}, "expect": {"stdout_json": {"errors": [{"instance_path": "/n", "keyword": "oneOf"}, {"instance_path": "/other", "keyword": "additionalProperties"}]}}},
  {"name": "format is an annotation by default and an error with formats assert", "input": {"schema": {"type": "object", "properties": {"d": {"format": "date"}, "e": {"format": "email"}}}, "instance": {"d": "2026-02-30", "e": "no-at-sign"}, "formats": "assert"}, "expect": {"stdout_json": {"valid": false, "errors": [{"instance_path": "/d", "keyword": "format"}, {"instance_path": "/e", "keyword": "format"}]}}},
  {"name": "unsupported and unknown keywords are reported, not silently ignored", "input": {"schema": {"unevaluatedProperties": false, "colour": "red"}, "instance": {}}, "expect": {"stdout_json": {"complete": false, "unsupported": [{"keyword": "unevaluatedProperties"}], "unknown_keywords": [{"keyword": "colour"}]}}},
  {"name": "schema and instance as JSON text", "input": {"schema_text": "{\"type\": \"string\", \"maxLength\": 3}", "instance_text": "\"abcd\""}, "expect": {"stdout_json": {"errors": [{"keyword": "maxLength"}]}}},
  {"name": "circular $ref", "input": {"schema": {"$defs": {"a": {"$ref": "#/$defs/a"}}, "$ref": "#/$defs/a"}, "instance": 1}, "expect": {"exit": 2, "stdout_contains": "loops"}},
  {"name": "missing instance", "input": {"schema": {}}, "expect": {"exit": 2, "stdout_contains": "instance (or instance_text) is required"}}
]
