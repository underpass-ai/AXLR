[
  {"name": "GeographicLib GeoConvert man page: echo 38SMB4488 | GeoConvert => 33.33424 44.40363", "input": {"operation": "from_mgrs", "mgrs": "38SMB4488"},
   "expect": {"exit": 0, "stdout_json": {"utm": {"zone": 38, "hemisphere": "N", "band": "S", "easting": 444500.0, "northing": 3688500.0, "text": "38n 444500 3688500"}}, "stdout_contains": "\"lat\": 33.33423"}},
  {"name": "GeoConvert man page: 38SMB4488 with -: -p 1 => 33:20:03.25N 044:24:13.06E", "input": {"operation": "from_mgrs", "mgrs": "38SMB4488"},
   "expect": {"exit": 0, "stdout_json": {"dms": "33°20′03.25″N 044°24′13.06″E"}}},
  {"name": "GeoConvert man page: 38n 444500 3688500 (the -u output) back to 33.33424 44.40363", "input": {"operation": "from_utm", "zone": 38, "hemisphere": "N", "easting": 444500, "northing": 3688500},
   "expect": {"exit": 0, "stdout_contains": "\"lon\": 44.40362"}},
  {"name": "GeoConvert man page: echo E44d24 N33d20 | GeoConvert -m -p -3 => 38SMB4488", "input": {"operation": "to_mgrs", "position": "E44d24 N33d20", "mgrs_digits": 2},
   "expect": {"exit": 0, "stdout_json": {"lat": 33.3333333333, "lon": 44.4, "mgrs": {"mgrs": "38SMB4488", "square_m": 1000}}}},
  {"name": "GeoConvert forward: 33.33424 44.40363 is within a metre of 38n 444500 3688500", "input": {"operation": "to_utm", "lat": 33.33424, "lon": 44.40363},
   "expect": {"exit": 0, "stdout_json": {"utm": {"zone": 38, "band": "S", "hemisphere": "N"}}, "stdout_contains": "\"easting\": 444500."}},
  {"name": "Wikipedia Geohash article: ezs42 decodes to 42.605, -5.603 with error ±0.022", "input": {"operation": "geohash_decode", "geohash": "ezs42"},
   "expect": {"exit": 0, "stdout_json": {"lat": 42.6049804688, "lon": -5.60302734375, "geohash": {"lat_error": 0.02197265625, "bbox": [-5.625, 42.5830078125, -5.5810546875, 42.626953125]}}}},
  {"name": "Wikipedia Geohash article: 57.64911,10.40744 encodes to u4pruydqqvj", "input": {"operation": "geohash_encode", "position": "57.64911, 10.40744", "geohash_length": 11},
   "expect": {"exit": 0, "stdout_json": {"geohash": {"geohash": "u4pruydqqvj"}}}},
  {"name": "Norway exception: 60N 5E is in zone 32V, not 31", "input": {"operation": "to_utm", "lat": 60, "lon": 5}, "expect": {"exit": 0, "stdout_json": {"utm": {"zone": 32, "band": "V", "central_meridian": 9}}}},
  {"name": "Svalbard exception: 78N 20E is in zone 33X", "input": {"operation": "to_utm", "lat": 78, "lon": 20}, "expect": {"exit": 0, "stdout_json": {"utm": {"zone": 33, "band": "X"}}}},
  {"name": "Svalbard exception: 78N 8E in 31X", "input": {"operation": "to_utm", "lat": "78N", "lon": "8E"}, "expect": {"exit": 0, "stdout_json": {"utm": {"zone": 31, "band": "X"}}}},
  {"name": "a central meridian on the equator is E 500000 N 0 by definition", "input": {"operation": "to_utm", "lat": 0, "lon": 3}, "expect": {"exit": 0, "stdout_json": {"utm": {"zone": 31, "easting": 500000.0, "northing": 0.0}}}},
  {"name": "southern hemisphere round trip through UTM (false northing 10 000 km)", "input": {"operation": "from_utm", "zone": 56, "band": "H", "easting": 333568.941, "northing": 6247473.337}, "expect": {"exit": 0, "stdout_json": {"dms": "33°54′00.00″S 151°12′00.00″E", "utm": {"hemisphere": "S"}}}},
  {"name": "DMS parsing with symbols and hemisphere letters, DDM output", "input": {"operation": "format", "position": "40°26′46″N 79°58′56″W"},
   "expect": {"exit": 0, "stdout_json": {"dms": "40°26′46.00″N 079°58′56.00″W", "ddm": "40°26.7667′N 079°58.9333′W"}}},
  {"name": "ASCII quotes in DMS; rounding carries 59.99999999 to 60°00′00″", "input": {"operation": "format", "lat": "40°26'46.302\"N", "lon": 59.99999999},
   "expect": {"exit": 0, "stdout_json": {"lat": 40.446195, "dms": "40°26′46.30″N 060°00′00.00″E"}}},
  {"name": "ambiguous position without comma or hemisphere letters", "input": {"operation": "format", "position": "40 26 30 10"}, "expect": {"exit": 2, "stdout_contains": "ambiguous"}},
  {"name": "minutes of 60 are rejected", "input": {"operation": "format", "lat": "40 60 00N", "lon": 0}, "expect": {"exit": 2, "stdout_contains": "below 60"}},
  {"name": "UTM stops at 84N (UPS not supported)", "input": {"operation": "to_utm", "lat": 85, "lon": 0}, "expect": {"exit": 2, "stdout_contains": "UPS"}},
  {"name": "MGRS letters I and O do not exist", "input": {"operation": "from_mgrs", "mgrs": "38SIB4488"}, "expect": {"exit": 2, "stdout_contains": "cannot read"}},
  {"name": "geohash alphabet has no a", "input": {"operation": "geohash_decode", "geohash": "ezs4a"}, "expect": {"exit": 2, "stdout_contains": "not a geohash character"}},
  {"name": "band and hemisphere disagree", "input": {"operation": "from_utm", "zone": 38, "band": "S", "hemisphere": "S", "easting": 444500, "northing": 3688500}, "expect": {"exit": 2, "stdout_contains": "northern hemisphere"}}
]
