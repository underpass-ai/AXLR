[
  {"name": "Geoscience Australia Vincenty test case (as quoted by Movable Type Scripts): Flinders Peak to Buninyong s = 54 972.271 m", "input": {"from": ["37 57 03.72030S", "144 25 29.52440E"], "to": ["37°39′10.15610″S", "143°55′35.38390″E"], "unit": "m"},
   "expect": {"exit": 0, "stdout_contains": "\"distance_m\": 54972.271"}},
  {"name": "Geoscience Australia: forward azimuth 306°52′05.37″", "input": {"from": [-37.951033416667, 144.424867888889], "to": [-37.652821138889, 143.926495527778]},
   "expect": {"exit": 0, "stdout_contains": "\"initial_bearing\": {\"degrees\": 306.86815"}},
  {"name": "Geoscience Australia: reverse azimuth 127°10′25.07″", "input": {"from": ["37 57 03.72030S", "144 25 29.52440E"], "to": ["37 39 10.15610S", "143 55 35.38390E"]},
   "expect": {"exit": 0, "stdout_contains": "\"reverse_azimuth\": {\"degrees\": 127.17363"}},
  {"name": "Geoscience Australia direct: 54 972.271 m on 306°52′05.37″ from Flinders Peak reaches Buninyong 37°39′10.15610″S 143°55′35.38390″E", "input": {"operation": "destination", "from": ["37 57 03.72030S", "144 25 29.52440E"], "bearing": "306°52′05.37″", "distance": 54972.271, "unit": "m"},
   "expect": {"exit": 0, "stdout_contains": "\"vincenty\": {\"destination\": {\"lat\": -37.652821"}},
  {"name": "Movable Type Scripts worked example, R = 6371 km: Land's End to John o' Groats 968.9 km", "input": {"from": ["50 03 59N", "005 42 53W"], "to": ["58 38 38N", "003 04 12W"], "radius_km": 6371},
   "expect": {"exit": 0, "stdout_contains": "\"haversine\": {\"distance\": 968.8"}},
  {"name": "Movable Type Scripts: initial bearing 009°07′11″", "input": {"from": ["50 03 59N", "005 42 53W"], "to": ["58 38 38N", "003 04 12W"], "radius_km": 6371},
   "expect": {"exit": 0, "stdout_contains": "\"dms\": \"009°07′11"}},
  {"name": "Movable Type Scripts: midpoint 54°21′44″N 004°31′50″W", "input": {"from": ["50 03 59N", "005 42 53W"], "to": ["58 38 38N", "003 04 12W"], "radius_km": 6371},
   "expect": {"exit": 0, "stdout_contains": "\"dms\": \"54°21′44"}},
  {"name": "one degree of the WGS-84 equator is a·π/180 = 111 319.49 m, 60.1077 nmi", "input": {"from": [0, 0], "to": [0, 1], "unit": "nmi"},
   "expect": {"exit": 0, "stdout_contains": "\"distance_m\": 111319.49"}},
  {"name": "the first degree of meridian on WGS-84 is 110 574.39 m (the 110.574 km of the length-of-a-degree table in Wikipedia's Latitude article)", "input": {"from": [0, 0], "to": [1, 0]},
   "expect": {"exit": 0, "stdout_contains": "\"distance_m\": 110574.38"}},
  {"name": "batch of two pairs in statute miles", "input": {"pairs": [[0, 0, 0, 1], {"from": {"lat": 0, "lon": 0}, "to": {"lat": 1, "lon": 0}}], "unit": "mi", "radius_km": 6371},
   "expect": {"exit": 0, "stdout_json": {"count": 2, "unit": "mi"}, "stdout_contains": "\"distance\": 69.09"}},
  {"name": "near-antipodal points: Vincenty reports non-convergence, haversine still answers", "input": {"from": [0, 0], "to": [0.5, 179.7]},
   "expect": {"exit": 0, "stdout_json": {"vincenty": {"converged": false}, "more_exact": "haversine (Vincenty did not converge)"}}},
  {"name": "same point: zero distance, no bearing", "input": {"from": [10, 20], "to": ["10N", "20E"]}, "expect": {"exit": 0, "stdout_json": {"haversine": {"distance": 0.0}, "vincenty": {"distance_m": 0.0}}}},
  {"name": "latitude out of range", "input": {"from": ["91N", 0], "to": [0, 0]}, "expect": {"exit": 2, "stdout_contains": "between -90 and 90"}},
  {"name": "hemisphere on the wrong axis", "input": {"from": ["12W", 0], "to": [0, 0]}, "expect": {"exit": 2, "stdout_contains": "does not belong to a latitude"}},
  {"name": "unknown unit", "input": {"from": [0, 0], "to": [0, 1], "unit": "ft"}, "expect": {"exit": 2, "stdout_contains": "unit must be one of"}}
]
