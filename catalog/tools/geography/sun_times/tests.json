[
  {"name": "USNO one-day table (https://aa.usno.navy.mil/api/rstt/oneday?date=2026-06-21&coords=40.4168,-3.7038&tz=0), Madrid 2026-06-21 UT: rise 04:45, transit 12:17, civil twilight 04:12-20:22, to the minute", "input": {"date": "2026-06-21", "latitude": 40.4168, "longitude": -3.7038, "utc_offset": 0, "rounding": "minute"}, "expect": {"stdout_json": {"day_status": "normal", "sunrise": "2026-06-21T04:45+00:00", "solar_noon": "2026-06-21T12:17+00:00", "civil_twilight": {"begin": "2026-06-21T04:12+00:00", "end": "2026-06-21T20:22+00:00"}}}},
  {"name": "USNO one-day table, Madrid 2026-06-21: set 19:48; NOAA gives 19:48:31, within the minute", "input": {"date": "2026-06-21", "latitude": 40.4168, "longitude": -3.7038, "utc_offset": "+00:00"}, "expect": {"stdout_contains": "\"sunset\": \"2026-06-21T19:48:"}},
  {"name": "same place in local summer time (+02:00): sunrise 06:45 local", "input": {"date": "2026-06-21", "latitude": 40.4168, "longitude": -3.7038, "utc_offset": "+02:00", "rounding": "minute"}, "expect": {"stdout_json": {"sunrise": "2026-06-21T06:45+02:00", "solar_noon": "2026-06-21T14:17+02:00", "timezone": "UTC+02:00"}}},
  {"name": "Meeus, Astronomical Algorithms, Example 25.a: 1992 Oct 13 0h, apparent declination -7.78507 deg", "input": {"date": "1992-10-13", "latitude": 0, "longitude": 0, "datetime": "1992-10-13T00:00:00Z"}, "expect": {"stdout_contains": "\"declination_deg\": -7.7850"}},
  {"name": "Meeus Example 25.a: apparent longitude of the Sun 199.90895 deg (NOAA's coefficients give 199.90894)", "input": {"date": "1992-10-13", "latitude": 0, "longitude": 0, "datetime": "1992-10-13T00:00:00Z"}, "expect": {"stdout_contains": "\"apparent_longitude_deg\": 199.9089"}},
  {"name": "Meeus Examples 28.a/28.b: equation of time on 1992 Oct 13 0h is 13m 42.6s-42.7s = 13.71 min", "input": {"date": "1992-10-13", "latitude": 0, "longitude": 0, "datetime": "1992-10-13T00:00:00Z"}, "expect": {"stdout_contains": "\"equation_of_time_minutes\": 13.71"}},
  {"name": "polar day: Tromso (69.65 N) at the June solstice, no sunrise, no sunset", "input": {"date": "2026-06-21", "latitude": 69.6492, "longitude": 18.9553, "utc_offset": "+02:00"}, "expect": {"stdout_json": {"day_status": "polar_day", "sunrise": null, "sunset": null, "day_length": "24:00:00", "civil_twilight": {"begin": null, "end": null, "status": "sun_always_above_-6_deg"}}}},
  {"name": "polar night: Tromso at the December solstice; the noon Sun at -3.1 deg still gives civil twilight", "input": {"date": "2026-12-21", "latitude": 69.6492, "longitude": 18.9553, "utc_offset": 1}, "expect": {"stdout_json": {"day_status": "polar_night", "sunrise": null, "day_length": "00:00:00"}, "stdout_contains": "\"civil_twilight\": {\"begin\": \"2026-12-21T09:"}},
  {"name": "North Pole at the June solstice: polar day, the Sun at its declination", "input": {"date": "2026-06-21", "latitude": 90, "longitude": 0}, "expect": {"stdout_json": {"day_status": "polar_day"}, "stdout_contains": "\"solar_noon_elevation_deg\": 23.43"}},
  {"name": "unknown IANA zone exits 2", "input": {"date": "2026-06-21", "latitude": 0, "longitude": 0, "timezone": "Mars/Olympus"}, "expect": {"exit": 2, "stdout_contains": "unknown time zone"}},
  {"name": "latitude out of range", "input": {"date": "2026-06-21", "latitude": 91, "longitude": 0}, "expect": {"exit": 2, "stdout_contains": "latitude must be between"}},
  {"name": "timezone and utc_offset together", "input": {"date": "2026-06-21", "latitude": 0, "longitude": 0, "timezone": "UTC", "utc_offset": 0}, "expect": {"exit": 2, "stdout_contains": "not both"}}
