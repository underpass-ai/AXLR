[
  {"name": "Regulation (EU) 1169/2011 Annex XIII Part B: 2000 kcal, 8400 kJ, 70 g fat, 20 g saturates, 260 g carbohydrate, 90 g sugars, 50 g protein and 6 g salt are each 100 %", "input": {"foods": {"day": {"energy_kj": 8400, "energy_kcal": 2000, "fat": 70, "saturates": 20, "carbohydrate": 260, "sugars": 90, "protein": 50, "salt": 6}}, "items": [{"food": "day", "grams": 100}]},
   "expect": {"exit": 0, "stdout_json": {"percent_reference_intake_total": {"energy_kj": "100.0", "energy_kcal": "100.0", "fat": "100.0", "saturates": "100.0", "carbohydrate": "100.0", "sugars": "100.0", "protein": "100.0", "salt": "100.0"}, "reference_intakes": {"energy_kj": "8400 kJ", "fat": "70 g", "salt": "6 g"}}}},
  {"name": "Annex XIII Part A NRVs: 40 mg vitamin C is 50 % of 80 mg, 7 mg iron 50 % of 14 mg, 75 ug iodine 50 % of 150 ug", "input": {"foods": {"tablet": {"vitamin_c": 40, "iron": 7, "iodine": 75}}, "items": [{"food": "tablet", "grams": 100}]},
   "expect": {"exit": 0, "stdout_json": {"percent_reference_intake_total": {"vitamin_c": "50.0", "iron": "50.0", "iodine": "50.0"}, "units": {"vitamin_c": "mg", "iron": "mg", "iodine": "ug"}}}},
  {"name": "hand-checked porridge: 80 g oats (13 g protein/100 g) + 250 g milk (3.3) = 18.65 g, 9.325 g per serving = 18.7 % of 50 g", "input": {"foods": {"oats": {"energy_kcal": 375, "protein": 13}, "milk": {"energy_kcal": 64, "protein": 3.3, "calcium": 120}}, "items": [{"food": "oats", "grams": 80}, {"food": "milk", "grams": 250}], "servings": 2},
   "expect": {"exit": 0, "stdout_json": {"total_grams": "330.00", "totals": {"energy_kcal": "460.00", "protein": "18.65", "calcium": "300.00"}, "per_serving": {"protein": "9.33", "energy_kcal": "230.00"}, "percent_reference_intake_per_serving": {"protein": "18.7", "energy_kcal": "11.5", "calcium": "18.8"}, "missing_values": {"calcium": ["oats"]}}}},
  {"name": "reference intakes given in the input replace the defaults", "input": {"foods": {"x": {"fibre": 5}}, "items": [{"food": "x", "grams": 200}], "reference_intakes": {"fibre": 25}}, "expect": {"exit": 0, "stdout_json": {"totals": {"fibre": "10.00"}, "percent_reference_intake_total": {"fibre": "40.0"}, "reference_intakes_source": "given in the input"}}},
  {"name": "item names a food that is not in the table", "input": {"foods": {"x": {"fat": 1}}, "items": [{"food": "y", "grams": 10}]}, "expect": {"exit": 2, "stdout_contains": "is not in foods"}},
  {"name": "negative grams", "input": {"foods": {"x": {"fat": 1}}, "items": [{"food": "x", "grams": -5}]}, "expect": {"exit": 2, "stdout_contains": "disclaimer"}}
]
