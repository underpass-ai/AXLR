[
  {"name": "hand-checked: waking at 07:00 with 15 min latency, 6 cycles means bed at 21:45 the day before, 4 cycles 00:45", "input": {"mode": "wake_at", "time": "07:00"}, "expect": {"exit": 0, "stdout_json": {"options": [
    {"cycles": 6, "bedtime": "21:45", "day_offset": -1, "sleep_duration": "9:00", "recommended": true},
    {"cycles": 5, "bedtime": "23:15", "day_offset": -1, "recommended": true},
    {"cycles": 4, "bedtime": "00:45", "day_offset": 0, "recommended": false},
    {"cycles": 3, "bedtime": "02:15", "day_offset": 0}]}}},
  {"name": "National Sleep Foundation 2015: 7-9 h for adults, so 7:30 and 9:00 are recommended and 6:00 is not", "input": {"mode": "bed_at", "time": "23:00", "min_cycles": 4, "max_cycles": 6}, "expect": {"exit": 0, "stdout_json": {"options": [
    {"cycles": 4, "wake_time": "05:15", "recommended": false},
    {"cycles": 5, "wake_time": "06:45", "day": "next day", "recommended": true},
    {"cycles": 6, "wake_time": "08:15", "recommended": true}]}}},
  {"name": "custom cycle and latency: bed at 22:30, 100-min cycles, no latency, 5 cycles wakes at 06:50", "input": {"mode": "bed_at", "time": "22:30", "cycle_minutes": 100, "latency_minutes": 0, "min_cycles": 5, "max_cycles": 5}, "expect": {"exit": 0, "stdout_json": {"options": [{"cycles": 5, "wake_time": "06:50", "day_offset": 1, "sleep_duration": "8:20"}]}}},
  {"name": "teenager range given in the input (8-10 h)", "input": {"mode": "wake_at", "time": "06:30", "min_cycles": 6, "max_cycles": 6, "recommended_hours": [8, 10]}, "expect": {"exit": 0, "stdout_json": {"options": [{"cycles": 6, "bedtime": "21:15", "recommended": true}]}}},
  {"name": "bad time", "input": {"mode": "wake_at", "time": "25:00"}, "expect": {"exit": 2, "stdout_contains": "time must be HH:MM"}},
  {"name": "bad mode", "input": {"mode": "nap", "time": "13:00"}, "expect": {"exit": 2, "stdout_contains": "mode must be"}}
]
